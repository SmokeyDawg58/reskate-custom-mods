+    auto m = header(g, Message::Kind::event);
+    m.event = event;
+    m.value = value;
+    m.extra = extra;
+    m.at = at;
+    m.sequence = g.sequence;
+    m.tags = tags;
+    m.trick = trick;
+    send(s, m);
