+}
+}
+#include <iostream>
+#include <limits>
+
+namespace {
+using namespace dingosdk::multiplayer;
+one_up::View current_view;
+std::vector<one_up::SpawnRequest> handed_off;
+std::vector<std::uint32_t> destroyed, navigations;
