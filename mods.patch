+#pragma once
+
+#include "sdk/assets/frostbite_asset_manager.h"
+
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace reskate::modding::materials {
+
+inline constexpr std::uint32_t shaderBlockDepotResourceType = 0x73312045;
+
+enum class TextureRole {
+    albedo,
+    normal,
+    mask,
+    opacity
+};
+
+enum class TextureBindingMode {
+    authored,
+    preserveNative
+};
+
+struct TextureBinding {
+    sdk::io::Guid partition;
+    sdk::io::Guid instance;
+};
+
+struct AuthoredDepot {
+    std::string name;
+    std::vector<std::byte> resource;
+    std::vector<std::byte> resourceMeta;
+};
+
+struct SurfacePrototype {
+    std::uint64_t key{};
+    std::string materialName;
+};
+
+// A shipped world-surface block that could host authored textures.
+struct SurfaceCandidate {
+    std::uint64_t key{};
+    std::string materialName;
+    std::string depot;
+    std::vector<TextureRole> roles;
+    std::vector<std::string> roleTextures;
+    std::size_t textureParameters{};
+    // Vector2 parameters other than (1, 1): layer tiling the authored textures would inherit.
+    std::size_t tiledVectors{};
+};
+
+// Float values written over a cloned block's parameters, keyed by parameter hash. A value
+// list must match the parameter's element count; parameters the donor lacks are skipped.
+using ParameterOverrides = std::unordered_map<std::uint64_t, std::vector<float>>;
+
+// Shipped world blocks precompute these from their own textures. The renderer shades
+// distant surfaces with them instead of sampling, so a clone must carry its own values.
+inline constexpr std::uint64_t averageAlbedoParameter = 0xFD3D7B2C922F3A8AULL;     // linear RGB
+inline constexpr std::uint64_t averageSmoothnessParameter = 0xC12DD8BE6B17463AULL; // mask green
+inline constexpr std::uint64_t averageMetalnessParameter = 0xF6B3B4A0183ED809ULL;  // mask red
+
+// Research: one compiled parameter of a shipped block, values as floats (texture parameters
+// carry the bound texture's name instead).
+struct ParameterDump {
+    std::uint64_t hash{};
+    std::uint32_t type{};
+    std::vector<float> values;
+    std::string texture;
+};
+[[nodiscard]] std::vector<ParameterDump> dump_block_parameters(const sdk::assets::AssetDatabase& database,
+                                                               std::uint64_t key,
+                                                               const sdk::assets::NativeAsset** depot = nullptr);
+
+class ShaderDepotAuthor final {
+public:
+    [[nodiscard]] static ShaderDepotAuthor find(
+        const sdk::assets::AssetDatabase& database,
+        std::uint64_t sourceKey,
+        std::span<const std::size_t> allowedBundles = {},
+        TextureBindingMode mode = TextureBindingMode::authored);
+    [[nodiscard]] static ShaderDepotAuthor find_surface(
+        const sdk::assets::AssetDatabase& database,
+        std::span<const SurfacePrototype> prototypes,
+        std::span<const TextureRole> requiredRoles,
+        std::span<const std::size_t> allowedBundles = {},
+        bool requirePlainSurface = false);
+    [[nodiscard]] static std::vector<SurfaceCandidate> survey_surfaces(
+        const sdk::assets::AssetDatabase& database,
+        std::span<const SurfacePrototype> prototypes,
+        std::span<const std::size_t> allowedBundles = {});
+
+    [[nodiscard]] std::uint64_t add_material(
+        std::string_view identity,
+        const std::unordered_map<TextureRole, TextureBinding>& textures,
+        const ParameterOverrides& overrides = {});
+    [[nodiscard]] std::uint64_t add_material_from(
+        std::string_view identity,
+        const std::unordered_map<TextureRole, TextureBinding>& textures,
+        const ShaderDepotAuthor& prototype,
+        const ParameterOverrides& overrides = {});
+    // A native mesh variation fixes the material key to baseKey + NameHash.
+    // Replace one exact texture identity, preserving the pole's other albedos.
+    [[nodiscard]] std::uint64_t add_material_replacing(
+        std::string_view identity, std::uint64_t destinationKey,
+        TextureBinding original, TextureBinding replacement);
+    [[nodiscard]] AuthoredDepot build(std::string_view bundleStem) const;
+    // Export only the requested native material keys. Loading an entire world
+    // depot in a UI bundle would register unrelated materials before their
+    // world texture dependencies are resident.
+    [[nodiscard]] AuthoredDepot build_subset(std::string_view bundleStem,
+                                            std::span<const std::uint64_t> keys) const;
+    [[nodiscard]] std::string_view donor_name() const noexcept;
+    [[nodiscard]] std::string_view source_material() const noexcept;
+    [[nodiscard]] std::uint64_t source_key() const noexcept;
+    [[nodiscard]] std::size_t binding_site_count() const noexcept;
+
+public:
+    struct Row {
+        std::uint64_t key{};
+        std::size_t block{};
+    };
+    struct Block {
+        std::uint64_t identity{};
+        std::vector<std::byte> data;
+    };
+    struct Site {
+        std::size_t offset{};
+        TextureRole role{};
+    };
+
+private:
+    [[nodiscard]] std::uint64_t add_material_impl(
+        std::string_view identity,
+        const std::unordered_map<TextureRole, TextureBinding>& textures,
+        std::span<const std::byte> source,
+        std::span<const Site> sites,
+        const ParameterOverrides& overrides);
+
+    std::string donorName_;
+    std::string sourceMaterial_;
+    std::uint32_t version_{};
+    std::uint64_t sourceKey_{};
+    std::size_t sourceBlock_{};
+    std::vector<Row> rows_;
+    std::vector<Block> blocks_;
+    std::vector<Site> sites_;
+};
+
+}
diff --git a/contrib/throwdown-flags/throwdown_menu_residency.inl b/contrib/throwdown-flags/throwdown_menu_residency.inl
new file mode 100644
index 0000000..dd1b757
--- /dev/null
+++ b/contrib/throwdown-flags/throwdown_menu_residency.inl
@@ -0,0 +1,91 @@
+// Persist the picker's dynamic model types in its authored resource container.
+// The native model registry alone only knows types instantiated by other UI.
+bool run_throwdown_menu_residency(int count,const char* const* args) {
+    if(std::string_view(args[1])!="throwdown-menu-residency")return false;
+    if(count!=5)throw std::runtime_error("throwdown-menu-residency <game-root> <input.fbproject> <output.fbproject>");
+    namespace sdk=reskate::sdk;
+    namespace ui=reskate::modding::maps::ui;
+    namespace ebx=reskate::modding::maps::ebx;
+    namespace projects=reskate::modding::projects;
+    const auto db=sdk::assets::FrostbiteAssetManager::load_sync(args[2]);
+    auto project=projects::load_project(args[3]);
+    auto content=std::ranges::find(project.resources,
+        "UI/Features/Throwdowns/ContentResources/Throwdown_ModeSelect_ContentResources",&projects::ProjectResource::name);
+    if(content==project.resources.end())throw std::runtime_error("private Throwdown content resource is missing");
+    auto document=sdk::ebx::read_document(content->payload);
+    sdk::ebx::decode_boxed_values(document,content->payload);
+    const auto defaults=native_defaults(document);
+    ebx::Partition partition(document,false);auto& doc=partition.document();
+    std::optional<std::size_t> prototype;
+    for(std::size_t i=0;i<doc.instances.size();++i)if(doc.instances[i].object) {
+        const auto* name=sdk::ebx::find_field(*doc.instances[i].object,"DebugName");
+        const auto* text=name?std::get_if<std::string>(&name->value.data):nullptr;
+        if(text && text->ends_with("/LogoGrid"))prototype=i;
+    }
+    if(!prototype)throw std::runtime_error("private native grid prototype is missing");
+    const auto reference=std::get<sdk::ebx::BoxedReference>(ui::require_field(*doc.instances[*prototype].object,"DefaultValue").value.data);
+    const auto* box=sdk::ebx::resolve_boxed(doc,reference);
+    const auto* pointer=box && box->decoded?sdk::ebx::pointer(*box->decoded):nullptr;
+    if(!pointer || pointer->kind!=sdk::ebx::PointerKind::internal)throw std::runtime_error("grid prototype has no typed default");
+    const auto modelIndex=static_cast<std::size_t>(pointer->index);
+    auto next=doc.boxedValuesOffset;
+    for(const auto& old:doc.boxedValues)next=std::max(next,old.offset+static_cast<std::uint32_t>(old.rawBytes.size()));
+    doc.instances.reserve(doc.instances.size()+4);
+    constexpr std::array models{
+        std::pair{"LogoTexture","UI/Foundations/Components/Media/Icons/TextureViewModel"},
+        std::pair{"LogoContents","UI/Foundations/Components/Modals/ContentPresenterCombinationViewModel"}};
+    for(const auto& [key,name]:models) {
+        if(defaults.contains(std::string("Throwdown_ModeSelect_ContentResources/")+key))continue;
+        const auto type=sdk::ebx::read_document(db.read(ui::require_asset(db,name)));
+        auto& model=partition.clone_instance(doc.instances.at(modelIndex),true);
+        auto& typeRef=ui::require_object(ui::require_field(*model.object,"TypeRef").value,"model type");
+        ui::require_field(typeRef,"Asset").value.data=partition.import(type.fileGuid,type.instances.front().instanceGuid);
+        ui::require_field(typeRef,"TypeInfo").value.data=sdk::ebx::TypeReference{};
+        ui::require_field(*model.object,"FieldValues").value.data=sdk::ebx::Value::Array{};
+        auto clone=*sdk::ebx::resolve_boxed(doc,reference);
+        clone.offset=(next+7u)&~7u;next=clone.offset+static_cast<std::uint32_t>(clone.rawBytes.size());
+        clone.decoded=std::make_shared<sdk::ebx::Value>(sdk::ebx::Value{partition.point_to(model)});
+        auto defaultValue=reference;defaultValue.dataOffset=clone.offset;defaultValue.needsFixup=true;
+        doc.boxedValues.push_back(std::move(clone));
+        auto& record=partition.clone_instance(doc.instances[*prototype],true);
+        ui::require_field(*record.object,"DebugName").value.data=std::string("Throwdown_ModeSelect_ContentResources/")+key;
+        ui::require_field(*record.object,"DefaultValue").value.data=defaultValue;
+        ui::require_array(ui::require_field(*partition.root()->object,"Resources").value,"Resources").push_back({partition.point_to(record)});
+    }
+    // Model registration does not retain private widget blueprints when the
+    // level domain is retired. Include styles and images as well as widgets:
+    // LogoHoverRing_FillStyle is resolved dynamically, so a widget-only
+    // dependency list loses it when changing maps. Anchor the complete
+    // private UI dependency set in the
+    // native picker resource, which is loaded again on every map. The imports
+    // also let the compiler include the dependency closure in its owning bundles.
+    unsigned dependencies{};
+    for(const auto& resource:project.resources)if(resource.kind==projects::ResourceKind::ebx &&
+       resource.name.starts_with("UI/ReSkate/")) {
+        const auto identity=sdk::ebx::read_root_identity(resource.payload);
+        partition.import(identity.fileGuid,identity.classGuid);++dependencies;
+    }
+    const auto owningBundles=content->bundles;
+    for(auto& resource:project.resources)if(resource.added && resource.name.starts_with("UI/ReSkate/"))
+        for(const auto& bundle:owningBundles)
+            if(std::ranges::find(resource.bundles,bundle)==resource.bundles.end())resource.bundles.push_back(bundle);
+    const auto emitted=ui::emit(content->name,partition);content->payload=emitted.bytes;
+    auto verified=sdk::ebx::read_document(emitted.bytes);sdk::ebx::decode_boxed_values(verified,emitted.bytes);
+    const auto updated=native_defaults(verified);
+    for(const auto& [name,target]:defaults)if(updated.find(name)==updated.end() || updated.at(name)!=target)
+        throw std::runtime_error("menu residency changed an existing native default: "+name);
+    for(const auto& [key,name]:models)
+        if(!updated.contains(std::string("Throwdown_ModeSelect_ContentResources/")+key))
+            throw std::runtime_error("private model templates were not serialized");
+    for(const auto& resource:project.resources)if(resource.kind==projects::ResourceKind::ebx &&
+       resource.name.starts_with("UI/ReSkate/")) {
+        const auto identity=sdk::ebx::read_root_identity(resource.payload);
+        if(!std::ranges::any_of(verified.imports,[&](const auto& i){return i.fileGuid==identity.fileGuid && i.classGuid==identity.classGuid;}))
+            throw std::runtime_error("picker UI dependency missing: "+resource.name);
+    }
+    const std::filesystem::path out(args[4]);std::filesystem::create_directories(out.parent_path());
+    projects::save_project(project,out);auto mod=out;mod.replace_extension(".fbmod");
+    reskate::modding::mods::write_fbmod(project,mod,args[2],&db);
+    std::cout<<"resident_picker_types=2 resident_ui_assets="<<dependencies<<" existing_defaults_preserved="<<defaults.size()<<" resources="<<project.resources.size()<<"\nmod="<<mod.string()<<'\n';
+    return true;
+}
