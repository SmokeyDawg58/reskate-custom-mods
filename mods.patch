+        send(s,header(*s.game,Message::Kind::end));
+    s.route_dialog=0;s.route_dialog_error.clear();s.route_saved_id=s.route_rename_id=0;s.route_name.clear();s.save_hold={};
+    overlay::set_race_route_dialog_active(false);
