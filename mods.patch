+                h.prompts = {{'U', m ? "Wheel up / PgUp" : "PgUp", "Bigger"}, {'D', m ? "Wheel down / PgDn" : "PgDn", "Smaller"}, {'R', m ? "Click / Enter" : "Enter", "Set"}, {'L', "Backspace", "Cancel"}};
