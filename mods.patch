+std::string command(std::string_view verb, const std::vector<std::string> &arguments) {
+    auto &s = state();
+    const auto now = now_ms();
+    const std::string v(verb);
+    if (v.empty() || v == "help" || v == "list") return help();
+    if (v == "bonecam") {
+        // With ReSkate's own Hall of Meat, `on` / `off` / `meat` are its switch (every bail, or Hall of
+        // Meat games only); the Bone Cam keeps the choice for a game build without it.
+        const auto word = arguments.empty() ? std::string() : arguments[0];
+        if (hall_of_meat::available() && (word == "on" || word == "off" || word == "meat")) {
+            (void)bone_cam_command(arguments);
+            hall_of_meat::set_enabled(word == "on");
+            return word == "on" ? "Hall of Meat shows on every bail." : "Hall of Meat shows in Hall of Meat games.";
+        }
+        return bone_cam_command(arguments);
+    }
+    if (v == "games") {
+        if (s.offers.empty()) return "No other games right now.";
+        std::string text = "Open games (mode join <n>):";
+        for (std::size_t i = 0; i < s.offers.size(); ++i) {
+            const auto &o = s.offers[i];
+            text += std::format("\n  {}. {}'s {} - {} player{}{}", i + 1, name_of(s, o.leader), mode_name(o.settings.mode), o.players,
+                                o.players == 1 ? "" : "s", offer_open(o) ? "" : " (in progress)");
+        }
+        return text;
+    }
+    if (v == "join") {
+        // `mode join` takes the announced or nearest game; `mode join <n>` the list's nth; a menu row
+        // passes its host's id.
+        const Offer *pick{};
+        if (arguments.empty()) {
+            for (const auto &o : s.offers)
+                if (s.join_target && o.leader == s.join_target->first && o.game == s.join_target->second) pick = &o;
+            if (!pick && s.offers.size() == 1) pick = &s.offers.front();
+        } else {
+            std::uint64_t value{};
+            const auto &text = arguments[0];
+            if (std::from_chars(text.data(), text.data() + text.size(), value).ec == std::errc{}) {
+                if (value >= 1 && value <= s.offers.size()) pick = &s.offers[value - 1];
+                for (const auto &o : s.offers)
+                    if (o.leader == value) pick = &o;
+            }
+        }
+        if (!pick) return s.offers.empty() ? "error: there is no game to join." : "error: which one? mode games lists them.";
+        const auto offer = *pick;
+        return join_offer(s, offer, now);
+    }
+    if (v == "tricklog") return trick_log_command(arguments);
+    if (v == "diagram") {
+        std::string trick;
+        for (const auto &word : arguments) trick += (trick.empty() ? "" : " ") + word;
+        if (trick.empty()) return "error: usage: mode diagram <trick>, e.g. mode diagram 360 Flip + Indy";
+        prepare_trick_gestures();
+        s.diagram_trick = trick;
+        s.diagram_until = now + 10000;
+        return trick_gesture(trick.substr(0, trick.find(" + "))).empty()
+                   ? "Showing it for 10 seconds (if the trick has a flick, its diagram shows once the game's gestures are read)."
+                   : "Showing its flick diagram for 10 seconds.";
+    }
+    if (v == "stance") {
+        if (arguments.empty() || (arguments[0] != "regular" && arguments[0] != "goofy"))
+            return std::format("R.E.S.K.A.T.E.'s flick diagrams are shown for a {} stance. Usage: mode stance regular|goofy", s.goofy ? "goofy" : "regular");
+        s.goofy = arguments[0] == "goofy";
+        return std::format("Flick diagrams shown for a {} stance.", s.goofy ? "goofy" : "regular");
+    }
+    if (v == "spectate") {
+        if (arguments.empty() || (arguments[0] != "on" && arguments[0] != "off"))
+            return std::format("R.E.S.K.A.T.E. spectating is {}. Usage: mode spectate on|off", s.spectate ? "on" : "off");
+        s.spectate = arguments[0] == "on";
+        return s.spectate ? "In R.E.S.K.A.T.E. the camera follows whoever is up." : "In R.E.S.K.A.T.E. the camera stays on you.";
+    }
+    if (v == "results") {
+        return "error: results are supplied only by a completed challenge.";
+    }
+    if (v == "bounce") return "error: optional bail-bounce hooks are unavailable in this build. Native Hall of Meat scoring remains enabled.";
+    if (v == "debug") {
+        const bool on = arguments.size() >= 2 && arguments[0] == "states" && arguments[1] == "on";
+        if (arguments.size() < 2 || arguments[0] != "states" || (arguments[1] != "on" && arguments[1] != "off"))
+            return "error: usage: mode debug states on|off";
+        s.log_states = on;
+        s.logged_state = 0;
+        return on ? "Logging physics states to ReSkate.log." : "Stopped logging physics states.";
+    }
+    if (v == "status") {
+        if (!s.game) return "No game. " + help();
+        const auto &g = *s.game;
+        std::string text = std::format("{} led by {}; ", mode_name(g.settings.mode), name_of(s, g.leader));
+        text += std::format("area: {} corners, points: {}, ", g.settings.corners.size(), g.settings.points.size());
+        text += timed(g.settings.mode) ? std::format("time: {} s", g.settings.duration_s)
+                                       : std::format("turns: {} s, strikes: {}", g.settings.turn_s, g.settings.strikes);
+        if (g.state) text += std::format(", players: {}", g.state->standings.size());
+        return text;
+    }
+    if (v == "new") {
+        const auto mode = arguments.empty() ? std::nullopt : parse_mode(arguments[0]);
+        if (!mode) return "error: usage: mode new jam|meat|race|domination|graffiti|tag|infection|hide";
+        if(*mode==Mode::one_up)
+            return "error: use the native 1-UP Throwdowns card; a duplicate game-mode implementation is not started.";
+        if(multiplayer::one_up::view().state.match || multiplayer::one_up::flag_placement_active() || multiplayer::local_throwdown_active())
+            return "error: quit the active Throwdown before starting another challenge.";
+        if (s.barred) return "error: your mods change trick scoring, so you cannot start a game in this session.";
+        if (!s.skater) return "error: get on your board in the world first.";
+        if (s.game && !s.game->leading && s.game->state && s.game->state->phase != Phase::results)
+            return "error: " + name_of(s, s.game->leader) + "'s game is on. `mode leave` first.";
+        if (s.game && s.game->leading) send(s, header(*s.game, Message::Kind::end));
+        // Retire the completed match's native flag/input ownership before a
+        // saved course is reopened. The course is copied by end_game first.
+        end_game(s,{});
+        Game g;
+        g.leader = self_id(s);
+        g.id = static_cast<std::uint32_t>((now * 2654435761ULL) ^ (now >> 16)) | 1u;
+        g.leading = true;
+        g.settings.mode = *mode;
+        g.settings.duration_s = default_duration(*mode);
+        physics_tuning::prepare();
+        if (tag_like(*mode)) g.settings.radius = default_tag_reach; // how close tags (or infects)
+        if (*mode == Mode::skate) { // R.E.S.K.A.T.E.: seven letters, time to line a trick up
+            g.settings.strikes = 7;
+            g.settings.turn_s = 45;
+        }
+        // Where it was set up: its banner's spot for the others until an area or route is placed.
+        g.settings.spawn = s.position;
+        g.settings.has_spawn = true;
+        if(*mode==Mode::race)if(auto saved=s.courses.restore(s.course_map)) {
+            g.settings=std::move(*saved);g.race_finish_placed=g.settings.race_finish;
+        }
+        s.editor_exit_confirm=false;s.clear_hold={};
+        g.heard = now;
+        s.game = std::move(g);
+        s.active.store(true,std::memory_order_release);
+        std::string next;
+        switch (*mode) {
+        case Mode::race: next = "Open Throwdowns > Deathrace > Place Route: place the native start flag, then switch with LT/RT to checkpoints and the red finish."; break;
+        case Mode::domination: next = "Ride to each spot and use `mode point`, then `mode start`."; break;
+        case Mode::graffiti: next = "Open Throwdowns > Graffiti to set an optional area, then Start Game."; break;
+        case Mode::tag: next = "The whole map is the playground; Place Circle in Throwdowns fences it in (up to 3 km across). Then START GAME."; break;
+        case Mode::infection: next = "The whole map is the hunting ground; Place Circle in Throwdowns fences it in. Then START GAME."; break;
+        case Mode::hide: next = "Pick the hiding time in Throwdowns > Hide & Seek, PLACE CIRCLE to keep everyone close (recommended), then START GAME."; break;
+        case Mode::skate: next = "Pick the tricks that count with `mode tricks` (or `mode tricks flips grabs grinds manuals`), then START GAME."; break;
+        default: next = "Optional: `mode corner` at each corner of an area. Then `mode start`."; break;
+        }
+        return std::format("{} set up. {}", mode_name(*mode), next);
+    }
+    if (!s.game) return "error: no game. Start one with `mode new <mode>`.";
+    auto &g = *s.game;
+    if(v=="quit") {
+        // Quit leaves immediately; Stop deliberately presents match results.
+        // Followers also suppress the same host's still-advertised match.
+        send(s,header(g,local_quit_kind(g.leading)));
+        if(!g.leading)s.sat_out.insert({g.leader,g.id});
+        end_game(s,{});
+        return "You quit the Throwdown.";
+    }
+    if (v == "leave") {
+        if (g.leading) return "error: you lead this game: `mode stop` ends it for everyone.";
+        send(s, header(g, Message::Kind::leave));
+        s.sat_out.insert({g.leader, g.id});
+        end_game(s, {});
+        return "You left the game.";
+    }
+    if(v=="ready") {
+        if(g.leading)return "You host this Throwdown. Start when everyone is ready.";
+        if(g.state && g.state->phase!=Phase::setup)return "error: this Throwdown has already started.";
+        if(s.barred)return "error: this session's competition rules prevent joining.";
+        g.ready_requested=true;g.ready_sent=now;
+        send(s,header(g,Message::Kind::ready));
+        return "Ready. Waiting for the host to start.";
+    }
+    if (!g.leading) return "error: only " + name_of(s, g.leader) + " (the leader) can change or start this game.";
+    if (v == "stop") {
+        // Stopped while it is on: everyone sees the results first.
+        if (g.referee && (g.referee->phase() == Phase::playing || g.referee->phase() == Phase::countdown)) {
+            g.referee->end_now(now);
+            g.state_sent = 0;
+            return "Game ended: here are the results.";
+        }
+        send(s, header(g, Message::Kind::end));
+        end_game(s, {});
+        return "Game stopped.";
+    }
+    if (g.referee) return "error: the game has started; only `mode stop` now.";
+    if(v=="setup") {
+        const bool race=g.settings.mode==Mode::race;
+        const bool opened=race?multiplayer::one_up::begin_race_flag_placement(s.world,g.id,g.capacity,true):
+            multiplayer::one_up::begin_native_mode_setup(s.world,g.id,g.capacity);
+        if(!opened)return "error: native Throwdown setup is still busy.";
+        g.native_lobby=true;g.native_flag_placed=false;s.race_resume_editor=false;
+        s.placing=State::Placing::none;s.cursor_ok=false;
+        s.placement_flight.store(false,std::memory_order_release);
+        overlay::pause_game_input(false);
+        return race?"Deathrace: choose Players, then Confirm to place required gates, gray guides and one red finish. Choose the finish deadline in setup.":
+            std::format("{}: choose settings, Confirm to place the starting flag, then hold Start in the waiting HUD.",mode_name(g.settings.mode));
+    }
+    const auto changed = [&](std::string text) {
+        settings_changed(g);
+        return text;
+    };
+    if (v == "place") {
+        const auto what = arguments.empty() ? std::string("circle") : arguments[0];
+        if (what == "cancel" || what == "done") {
+            if(g.settings.mode==Mode::race && g.native_lobby) {
+                if(what=="done" && !race_route_ready(g.settings,g.race_finish_placed))
+                    return "error: place the red finish before saving the route.";
+                if(what=="cancel") {
+                    end_game(s,"Deathrace placement cancelled. Your course is saved.");
+                    return "Placing stopped.";
+                }
+            }
+            s.placing = State::Placing::none;
+            return "Placing stopped.";
+        }
+        if (what == "freecam") {
+            const auto value = arguments.size() > 1 ? arguments[1] : std::string(s.free_place ? "off" : "on");
+            if (value != "on" && value != "off") return "error: usage: mode place freecam on|off";
+            s.free_place = value == "on";
+            return s.free_place ? "Placing flies the free camera: aim at the ground (WASD/mouse or the sticks) and drop with D-pad Right (Enter)."
+                                : "Placing follows your skater: skate to each spot.";
+        }
+        if (!s.skater) return "error: get on your board in the world first.";
+        // Presses already down when placing starts (the menu's own) count only once let go.
+        s.pad_previous = ~0u;
+        s.keys_previous = {true, true, true, true};
+        s.placing_tick = 0;
+        if (what == "circle") {
+            if (g.settings.area_radius > 0) s.draft_radius = g.settings.area_radius;
+            s.placing = State::Placing::circle;
+            return "Close the menu and skate to the centre of your spot. D-pad Up/Down (PgUp/PgDn) sizes the circle; "
+                   "D-pad Right (Enter) sets it.";
+        }
+        if (what == "corners") {
+            g.settings.corners.clear();
+            g.settings.area_radius = 0;
+            settings_changed(g);
+            s.placing = State::Placing::corners;
+            return "Close the menu and skate to each corner: D-pad Right (Enter) adds one, D-pad Down (End) finishes.";
+        }
+        if (what == "points") {
+            if (g.settings.mode == Mode::race) { // a route is skated again from its start
+                if(!multiplayer::one_up::begin_race_flag_placement(s.world,g.id,g.capacity))
+                    return "error: native flag placement is still busy.";
+                // Re-enter the builder with the existing course. Only its
+                // deliberate hold-to-clear action removes all saved gates.
+                s.yaw_offset = 0;
+                s.draft_width = std::clamp(g.settings.radius, min_gate_half_width, max_gate_half_width);
+                s.placing=State::Placing::none;
+                return "Place the native starting flag to edit the saved course. Hold Back/View to clear all gates, or press Start to save it unchanged.";
+            }
+            s.placing = State::Placing::points;
+            return std::format("Close the menu and skate to each {}: D-pad Right (Enter) adds one, D-pad Down (End) finishes.", point_name(g));
+        }
+        return "error: usage: mode place circle|corners|points|cancel";
+    }
+    if (v == "circle") {
+        if (!s.skater) return "error: get on your board in the world first.";
+        const auto radius = arguments.empty() ? std::optional(s.draft_radius) : number(arguments, 0);
+        if (!radius || *radius < min_area_radius || *radius > max_area_radius)
+            return std::format("error: usage: mode circle [radius {}-{}]", min_area_radius, max_area_radius);
+        s.draft_radius = *radius;
+        g.settings.corners = {s.position};
+        g.settings.area_radius = std::round(*radius);
+        return changed(std::format("Area set: a circle {:.0f} m across, around you.", g.settings.area_radius * 2));
+    }
+    if (v == "corner" || v == "point") {
+        if(v=="point" && g.settings.mode==Mode::race)return "error: use Place race route in the native Throwdown menu to edit gates.";
+        auto &list = v == "corner" ? g.settings.corners : g.settings.points;
+        const auto limit = v == "corner" ? max_corners : max_points;
+        const auto what = std::string(v == "corner" ? "corner" : point_name(g));
+        const auto sub = arguments.empty() ? std::string() : arguments[0];
+        if (sub == "clear") {
+            list.clear();
+            if (v == "corner") g.settings.area_radius = 0;
+            return changed(std::format("All {}s cleared.", what));
+        }
+        if (sub == "undo") {
+            if (list.empty()) return "error: nothing to undo.";
+            list.pop_back();
+            if (g.settings.corners.empty()) g.settings.area_radius = 0;
+            return changed(std::format("Last {} removed ({} left).", what, list.size()));
+        }
+        if (!s.skater) return "error: no skater to mark the spot with.";
+        if (v == "corner" && g.settings.area_radius > 0) { // corners replace a circle
+            g.settings.corners.clear();
+            g.settings.area_radius = 0;
+        }
+        if (list.size() >= limit) return std::format("error: at most {} {}s.", limit, what);
+        list.push_back(s.position);
+        return changed(std::format("{} {} placed at {:.1f}, {:.1f}, {:.1f}.", what, list.size(), s.position[0], s.position[1],
+                                   s.position[2]));
+    }
+    const auto set_number = [&](float low, float high, auto apply, std::string_view label) -> std::string {
+        const auto value = number(arguments, 0);
+        if (!value || *value < low || *value > high) return std::format("error: usage: mode {} <{}-{}>", v, low, high);
+        apply(*value);
+        return changed(std::format("{} set to {}.", label, *value));
+    };
+    if (v == "players") return set_number(1, 6, [&](float x) { g.capacity = static_cast<unsigned>(std::round(x)); }, "Players");
+    if (v == "time" && g.settings.mode==Mode::race) return "Deathrace deadline is fixed at 120 seconds; the clock appears for the last 30.";
+    if (v == "time") return set_number(30, 3600, [&](float x) { g.settings.duration_s = static_cast<std::uint32_t>(x); }, "Time (s)");
+    if (v == "turn") return set_number(10, 120, [&](float x) { g.settings.turn_s = static_cast<std::uint32_t>(x); }, "Turn time (s)");
+    if (v == "strikes") return set_number(1, g.settings.mode==Mode::skate?7.f:5.f, [&](float x) { g.settings.strikes = static_cast<std::uint8_t>(x); }, "Strikes");
+    if (v == "tricks") {
+        // R.E.S.K.A.T.E.: the kinds of trick that may be set, one or more.
+        std::uint8_t kinds = 0;
+        for (const auto &word : arguments) {
+            if (word == "flips" || word == "flip") kinds |= trick_flips;
+            else if (word == "grabs" || word == "grab") kinds |= trick_grabs;
+            else if (word == "grinds" || word == "grind" || word == "slides") kinds |= trick_grinds;
+            else if (word == "manuals" || word == "manual") kinds |= trick_manuals;
+            else if (word == "all" || word == "any") kinds = all_trick_kinds;
+            else return "error: usage: mode tricks flips|grabs|grinds|manuals|all (one or more)";
+        }
+        if (!kinds) return "error: usage: mode tricks flips|grabs|grinds|manuals|all (one or more)";
+        g.settings.trick_kinds = kinds;
+        return changed("Tricks that can be set: " + trick_kinds_text(kinds) + ".");
+    }
+    if (v == "radius")
+        return set_number(1, 50, [&](float x) {
+            g.settings.radius = x;
+            // Deathrace: the reach is how wide its gates are, the ones placed already too.
+            const float half = std::clamp(x, min_gate_half_width, max_gate_half_width);
+            for (auto &width : g.settings.widths) width = half;
+            s.draft_width = half;
+        }, "Radius (m)");
+    if (v == "start") {
+        if(!g.lobby_readiness.all(g.joiners))return "error: waiting for joined players to press Ready.";
+        if(g.native_lobby && !g.native_flag_placed)return "error: place the native starting flag before starting this Throwdown.";
+        if(g.native_lobby && s.placing!=State::Placing::none)return "error: finish placing the area or capture spots before starting this Throwdown.";
+        if(g.settings.mode==Mode::race && (!race_route_ready(g.settings,g.race_finish_placed) || s.placing!=State::Placing::none ||
+           (multiplayer::one_up::race_flag_registration_owned() && !multiplayer::one_up::native_flag_mode_waiting())))
+            return "error: finish placing the start flag, checkpoints and one red finish first.";
+        if(g.settings.mode==Mode::race)if(const auto error=race_world::start_error(s.world,g.id);!error.empty())return "error: "+error;
+        if(g.settings.mode==Mode::race && !physics_tuning::game_tuning())return "error: stock physics are still loading; wait a moment before starting.";
+        if (const auto why = missing(g.settings); !why.empty()) return "error: " + why;
+        if(g.settings.mode==Mode::race) {
+            // Start plane and lineup must share the restored course direction.
+            // Broadcast the change before countdown so every racer uses it.
+            align_race_start(g.settings);settings_changed(g);
+        }
+        if (s.skater && g.settings.mode!=Mode::race && !g.native_flag_placed) {
+            g.settings.spawn = s.position;
+            g.settings.has_spawn = true;
+            settings_changed(g);
+        }
+        g.referee.emplace(g.settings, g.leader, g.id);
+        g.referee->add_player(self_id(s));
+        for (const auto id : g.joiners) g.referee->add_player(id);
+        g.referee->start(now);
+        g.setup_sent = g.state_sent = 0;
+        return std::format("{} starting with {} player{}!", mode_name(g.settings.mode), g.joiners.size() + 1,
+                           g.joiners.empty() ? "" : "s");
+    }
+    return "error: unknown `mode " + v + "`. " + help();
+}
+
+NativeView native_view() { auto& s=state();std::lock_guard lock(s.hud_mutex);return s.native; }
+std::vector<NativeFlagOffer> native_flag_offers(std::uint64_t world) {
+    const auto& s=state();std::vector<NativeFlagOffer> result;
+    if(!s.session || !s.world || s.world!=world || s.barred || (s.game && (!s.game->state || s.game->state->phase!=Phase::results)))return result;
+    const auto now=now_ms();
+    for(const auto& offer:s.offers) {
+        if(result.size()==64)break;
+        if(!offer_open(offer) || now-offer.heard>leader_timeout_ms || !s.present.contains(offer.leader))continue;
+        if(offer.settings.mode==Mode::race && !race_route_ready(offer.settings,offer.settings.race_finish))continue;
+        if(const auto at=game_spot(offer.settings))
+            result.push_back({offer.leader,offer.game,std::string(mode_key(offer.settings.mode)),*at,
+                offer.settings.mode==Mode::race?gate_heading(offer.settings,0):0.f,
+                static_cast<unsigned>(offer.players),offer.settings.duration_s,
+                static_cast<unsigned>(mandatory_gates(offer.settings,offer.settings.points.size()))});
+    }
+    return result;
+}
+bool join_native_flag_offer(const NativeFlagOffer& requested,std::uint32_t mmid) {
+    auto& s=state();
+    if(!mmid || s.barred || !s.present.contains(requested.leader))return false;
+    const auto offer=std::find_if(s.offers.begin(),s.offers.end(),[&](const Offer& candidate){
+        return candidate.leader==requested.leader && candidate.game==requested.game && offer_open(candidate) &&
+            now_ms()-candidate.heard<=leader_timeout_ms && mode_key(candidate.settings.mode)==requested.key;
+    });
+    const bool already=s.game && !s.game->leading && s.game->leader==requested.leader && s.game->id==requested.game;
+    if(!already && offer==s.offers.end())return false;
+    if(s.game && !already && (!s.game->state || s.game->state->phase!=Phase::results))return false;
+    const auto settings=already?s.game->settings:offer->settings;
+    if(!multiplayer::one_up::adopt_native_mode_flag(s.world,requested.game,mmid,requested.at,requested.yaw,
+        settings.duration_s,6,settings.mode==Mode::race))return false;
+    if(!already) {
+        const auto copy=*offer;
+        if(join_offer(s,copy,now_ms()).starts_with("error:")) {
+            multiplayer::one_up::flag_registration_left();return false;
+        }
+    }
+    s.game->native_lobby=s.game->native_flag_placed=true;s.game->native_flag_yaw=requested.yaw;
+    return true;
+}
+void accept_race_start(std::uint64_t world,std::uint32_t game,const Vec3& at,float yaw) {
+    if(!world || !game || !std::isfinite(yaw) ||
+       !std::all_of(at.begin(),at.end(),[](float n){return std::isfinite(n) && std::abs(n)<100000;}))return;
+    auto& s=state();std::lock_guard lock(s.race_start_mutex);s.race_start=State::RaceStart{world,game,at,yaw};
+}
+void accept_native_start_flag(std::uint64_t world,std::uint32_t game,const Vec3& at,float yaw) {
+    if(!world || !game || !std::isfinite(yaw) ||
+       !std::all_of(at.begin(),at.end(),[](float n){return std::isfinite(n) && std::abs(n)<100000;}))return;
+    auto& s=state();std::lock_guard lock(s.race_start_mutex);s.native_flag=State::RaceStart{world,game,at,yaw};
+}
+bool request_native_start(std::uint64_t world,std::uint32_t game) noexcept {
+    try {
+        const auto v=native_view();
+        if(!world || !game || !v.active || !v.leading || !v.waiting || v.world!=world || v.game!=game)return false;
+        auto& s=state();std::lock_guard lock(s.race_start_mutex);s.native_start=State::NativeStart{world,game};return true;
+    } catch(...) {return false;}
+}
+bool request_native_ready(std::uint64_t world,std::uint32_t game) noexcept {
+    try {
+        const auto v=native_view();
+        if(!world || !game || !v.active || v.leading || !v.waiting || v.world!=world || v.game!=game)return false;
+        auto& s=state();std::lock_guard lock(s.race_start_mutex);s.native_start=State::NativeStart{world,game,true};return true;
+    } catch(...) {return false;}
+}
+bool request_native_quit(std::uint64_t world,std::uint32_t game) noexcept {
+    try {
+        const auto v=native_view();
+        if(!world || !game || !v.active || v.world!=world || v.game!=game)return false;
+        auto& s=state();std::lock_guard lock(s.race_start_mutex);s.native_quit=State::NativeStart{world,game};return true;
+    } catch(...) {return false;}
+}
+bool active() noexcept { return state().active.load(std::memory_order_acquire); }
+std::optional<Vec3> peek_race_recovery_velocity() noexcept {
+    auto& s=state();std::lock_guard lock(s.recovery_mutex);
+    if(!s.active.load())s.recovery_velocity.reset();
+    return s.recovery_velocity.peek(now_ms());
+}
