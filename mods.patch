+// Placing: D-pad or keys, read on the game thread while ReSkate's menu is closed.
+void run_placing(State &s, std::uint64_t now) {
+    if (s.placing != State::Placing::none && (!s.game || !s.game->leading || s.game->referee || (!s.skater && !s.free_place)))
+        s.placing = State::Placing::none;
+    // While placing, the D-pad is ours: skate. would open its replay editor and quick menus. It
+    // stays ours after placing ends until it is let go: the D-pad Down that drops the finish must
+    // not reach skate. still held (its replay editor takes the camera).
+    constexpr std::uint32_t dpad = pad_up | pad_down | pad_left | pad_right | 0x10; // also retain editor Start until release
+    std::uint32_t still_held = 0;
+    if (s.placing != State::Placing::none) {
+        s.dpad_release = true;
+    } else if (s.dpad_release) {
+        ControllerInput pad;
+        DingoSDKOverlayReadControllerInput(&pad);
+        still_held = pad.available ? pad.buttons & dpad : 0;
+        if (!still_held) s.dpad_release = false;
+    }
+    const auto* race_me=s.game?standing(*s.game,self_id(s)):nullptr;
+    const bool race_playing=s.game && s.game->settings.mode==Mode::race && playing(*s.game) && race_me &&
+        !race_me->out && race_me->score>=0 && static_cast<std::size_t>(race_me->score)<s.game->settings.points.size();
+    const bool back_allowed=race_playing && multiplayer::native_throwdown_gameplay_input_allowed() && !overlay::interface_open() && game_window_focused();
+    ControllerInput back_pad;DingoSDKOverlayReadControllerInput(&back_pad,true);
+    const bool back_held=back_pad.available && (back_pad.buttons&pad_up);
+    if(s.checkpoint_back_press.update(back_held,back_allowed)) {
+        auto& g=*s.game;const auto* me=standing(g,self_id(s));
+        if(me && !me->out && me->score>=0 && static_cast<std::size_t>(me->score)<g.settings.points.size()) {
+            const auto target=g.checkpoint_fallback.step_back(g.settings,me->score);
+            {std::lock_guard lock(s.recovery_mutex);s.recovery_velocity.reset();}
+            if(!g.recovery_pending && !g.recovery_grace.pending())g.recovery_speed=g.recovery_speed_guard.limit(g.momentum.before_bail(now),now);
+            g.recovery_grace.reset();
+            g.recovery_pending=true;
+            g.recovery_queued=0;g.have_along=false;g.gate_crossed=false;g.miss_pending=false;
+            popup(s,target==0?"Back to the start":std::format("Back to Required gate {}",mandatory_gates(g.settings,target+1)));
+        }
+    }
+    overlay::hide_game_buttons(s.placing != State::Placing::none || s.dpad_release ? dpad : back_allowed?pad_up:0);
+    if (s.placing == State::Placing::none) overlay::hold_game_buttons(static_cast<std::uint16_t>(still_held));
+    // Placing with the free camera, like skate.'s quick drop: on while placing, off after.
+    const bool want_freecam = s.placing != State::Placing::none && s.free_place;
+    s.placement_flight.store(want_freecam,std::memory_order_release);
+    // The sticks fly the camera, so the skater does not roll off meanwhile.
+    overlay::pause_game_input(want_freecam || seeker_blind(s) || skate_watching(s));
+    if (const auto request=s.placement_camera.update(want_freecam,client_free_camera_view()!=0,now))
+        console::request_debug(overlay::DebugAction::set_free_camera,*request);
+    if (want_freecam != s.freecam_requested) {
+        s.freecam_requested = want_freecam;
+    }
+    if (s.placing == State::Placing::none) return;
+    update_cursor(s);
+    if(s.editor_rotating && s.game->settings.mode==Mode::race){s.cursor=s.rotation_pivot;s.cursor_ok=s.editor_angles_ready;}
+    auto &g = *s.game;
+    const float seconds = s.placing_tick && now > s.placing_tick ? std::min(0.1f, (now - s.placing_tick) / 1000.0f) : 0.0f;
+    s.placing_tick = now;
+    ControllerInput pad;
+    DingoSDKOverlayReadControllerInput(&pad);
+    const auto buttons = pad.available ? pad.buttons : 0u;
+    auto pressed = buttons & ~s.pad_previous;
+    s.pad_previous = buttons;
+    overlay::hold_game_buttons(static_cast<std::uint16_t>(buttons & (pad_up | pad_down | pad_left | pad_right)));
+    const auto held = [](int key) { return overlay::key_down(key); }; // past the pause while the free camera flies
+    // Mouse and keyboard work as well as the D-pad: with the free camera, left click drops (the
+    // right button is the camera's look) and F finishes; the wheel turns a gate or sizes a circle.
+    const bool mouse = s.free_place;
+    const std::array<bool, 4> keys{held(VK_RETURN) || (mouse && held(VK_LBUTTON)), held(VK_BACK), held(VK_END) || (mouse && held('F')), held(VK_ESCAPE)};
+    const int wheel = overlay::take_mouse_wheel(); // only gathered while the free camera flies
+    const float notches = static_cast<float>(wheel) / WHEEL_DELTA;
+    std::array<bool, 4> struck{};
+    for (std::size_t i = 0; i < keys.size(); ++i) struck[i] = keys[i] && !s.keys_previous[i];
+    s.keys_previous = keys;
+    if(s.route_dialog) {
+        s.route_input_release.arm();s.save_hold.update(false,false,now);s.editor_presses.suppress();return;
+    }
+    // The UI intentionally masks its controller presses from gameplay. That
+    // filtered zero is not a physical release: inspect the bypass sample until
+    // the menu is gone AND its confirm/cancel controls have actually come up.
+    ControllerInput route_pad;DingoSDKOverlayReadControllerInput(&route_pad,true);
+    if(s.route_input_release.blocked(route_pad.available?route_pad.buttons:0u,
+        std::any_of(keys.begin(),keys.end(),[](bool down){return down;}),overlay::interface_open() || !game_window_focused())) {
+        s.save_hold.update(false,false,now);s.clear_hold.update(false,false,now);s.editor_presses.suppress();return;
+    }
+    // Presses meant for ReSkate's menu, the chat or another window do nothing here.
+    const bool focus = !overlay::interface_open() && game_window_focused();
+    if (!focus) {s.clear_hold.update(false,false,now);s.save_hold.update(false,false,now);s.editor_presses.suppress();s.rotate_key_previous=held('R');return;}
+    const bool close=(pressed&0x2000) || struck[3];
+    // R.E.S.K.A.T.E.'s cones use the Deathrace gate editor's controls: A place, D-pad left / right
+    // undo and redo, Start done, B close (confirmed), hold Select clear all.
+    const bool cone_editor=g.settings.mode==Mode::skate && s.placing==State::Placing::corners;
+    if((g.settings.mode==Mode::race || cone_editor) && s.editor_exit_confirm) {
+        if(close){s.editor_exit_confirm=false;return;}
+        if(!(pressed&pad_a) && !struck[0])return;
+        s.editor_exit_confirm=false;
+    } else if(close && (g.settings.mode==Mode::race || cone_editor)) {
+        s.editor_exit_confirm=true;s.clear_hold={};return;
+    } else if(!close)goto editor_continue;
