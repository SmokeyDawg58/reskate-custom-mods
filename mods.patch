+    // Level with PLAY's bottom edge, in the opposite corner.
+    const ImVec2 changelog_size(S(200), S(52));
+    if (changelog_tile(draw, fonts, ImVec2(S(60), size.y - S(56) - changelog_size.y), changelog_size, !modal))
+        ui.changelog = true;
