+inline unsigned native_hud_value_width(std::string_view text) {
+    unsigned advance=40;
+    for(const unsigned char ch:text) {
+        if((ch&0xc0)==0x80)continue;
+        advance+=(ch==':' || ch=='.' || ch==' ')?12:(ch=='W' || ch=='M' || ch>=0x80)?36:26;
+    }
