+        controller_pair=presenter;items.push_back({presenter,item_id});
+        menu_active=true;hud_active=false;
+    }
+    bool native_on_end() {
+        const auto found=std::find_if(items.begin(),items.end(),[&](const auto& item) {
+            return item.presenter==controller_pair;
