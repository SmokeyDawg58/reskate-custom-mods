+std::string grouped(std::int64_t value) {
+    auto text = std::to_string(value < 0 ? -value : value);
+    for (int i = static_cast<int>(text.size()) - 3; i > 0; i -= 3) text.insert(static_cast<std::size_t>(i), ",");
+    return value < 0 ? "-" + text : text;
