+        if(hash==event_force_start) {
+            if(const auto game=one_up::native_flag_mode_game()) {
+                const auto mode=modes::native_view();
+                if(mode.game==game)(void)modes::request_native_start(mode.world,game);
+                logging::log(logging::Level::info,logging::Channel::ui,"Throwdown mode {}: native waiting Start requested.",game);
+                return true;
