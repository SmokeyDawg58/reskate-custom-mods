diff --git a/Engine/Core/Log/logger.cpp b/Engine/Core/Log/logger.cpp
index 4744f1c..da51584 100644
--- a/Engine/Core/Log/logger.cpp
+++ b/Engine/Core/Log/logger.cpp
@@ -32,10 +32,26 @@ public:
     SharedFile(const std::filesystem::path& path, bool truncate) {
         constexpr DWORD sharing = FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE;
         if (truncate) {
-            const auto reset = CreateFileW(path.c_str(), GENERIC_WRITE, sharing, nullptr,
-                CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
-            if (reset == INVALID_HANDLE_VALUE) spdlog::throw_spdlog_ex("Cannot reset ReSkate.log", GetLastError());
-            CloseHandle(reset);
+            // Reopening the launcher while diagnosing a lock must not erase
+            // the preceding game session. Copy first, without replacing an
+            // existing archive; if preservation fails, keep appending instead.
+            bool preserved=true;
+            WIN32_FILE_ATTRIBUTE_DATA previous{};
+            if(GetFileAttributesExW(path.c_str(),GetFileExInfoStandard,&previous) &&
+               (previous.nFileSizeHigh || previous.nFileSizeLow)) {
+                const auto archive=path.parent_path() / std::format(L"ReSkate-previous-{}-{}-{}.log",
+                    GetCurrentProcessId(),GetTickCount64(),
+                    (static_cast<std::uint64_t>(previous.ftLastWriteTime.dwHighDateTime)<<32) |
+                        previous.ftLastWriteTime.dwLowDateTime);
+                preserved=CopyFileW(path.c_str(),archive.c_str(),TRUE)!=0;
+                if(!preserved)OutputDebugStringA("ReSkate previous log could not be archived; preserving it in place.\n");
+            }
+            if(preserved) {
+                const auto reset = CreateFileW(path.c_str(), GENERIC_WRITE, sharing, nullptr,
+                    CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+                if (reset == INVALID_HANDLE_VALUE) spdlog::throw_spdlog_ex("Cannot reset ReSkate.log", GetLastError());
+                CloseHandle(reset);
+            }
         }
         file_ = CreateFileW(path.c_str(), FILE_APPEND_DATA, sharing, nullptr,
             OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
