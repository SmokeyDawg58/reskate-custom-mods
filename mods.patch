+void update_cursor(State &s) {
+    s.arrow_preview_ready=false;
+    if (s.free_place) {
+        const auto camera = client_free_camera_view();
+        if (!camera) { s.cursor_ok = false; cursor_diagnostic(s, "waiting for selected freecam"); return; }
+        const auto view = latest_game_view();
+        if (!view || view->camera != camera) {
+            s.cursor_ok = false;
+            cursor_diagnostic(s, view ? "published view differs from selected freecam" : "waiting for a fresh camera view", camera);
+            return;
+        }
+        const auto &m = view->world;
+        const Vec3 origin{m[12], m[13], m[14]}, forward{-m[8], -m[9], -m[10]};
+        s.cursor_pitch=std::atan2(forward[1],std::hypot(forward[0],forward[2]))*180.f/3.14159265f;
+        if(s.game && s.game->settings.mode==Mode::race && s.race_object==4) {
+            const auto aim=aim_race_arrow(origin,forward,{m[0],m[1],m[2]},{m[4],m[5],m[6]},cast_arrow_ray);
+            s.cursor=aim.at;s.cursor_ok=aim.valid;s.arrow_surface=aim.surface;s.arrow_preview_ready=true;
+            if(std::hypot(forward[0],forward[2])>.05f)s.cursor_heading=std::atan2(forward[0],forward[2])*180.f/3.14159265f;
+            const bool floor=aim.surface.contact && aim.surface.normal[1]>=.7f;
+            const bool flat=s.arrow_floor_alignment.update(floor,forward[1],s.editor_manual_rotation || s.editor_rotating);
+            if(aim.surface.contact && aim.align_surface && (!floor || flat)) {
+                const auto angles=race_arrow_surface_angles(aim.surface.normal);
+                if(std::abs(aim.surface.normal[1])<.98f)s.cursor_heading=angles[0]-180.f;
+                s.cursor_pitch=angles[1];
+            } else if(floor)s.cursor_pitch=0;
+            return;
+        }
+        queue_world_ray(aim_ray, origin, forward, 400.0f);
+        tick_local_world_rays();
+        const auto hit = world_ray(aim_ray);
+        s.cursor_ok = hit.hit && now_ms() - hit.when < 500;
+        if (s.cursor_ok) s.cursor = hit.at;
+        if(s.game && s.game->settings.mode==Mode::race) {
+            // Gates can float at the aimed depth; only a nearby direct surface
+            // hit mounts them. Distant buildings do not steal the air cursor.
+            float distance=16.f;
+            if(s.cursor_ok)distance=std::hypot(hit.at[0]-origin[0],hit.at[1]-origin[1],hit.at[2]-origin[2]);
+            if(!s.cursor_ok || distance>30.f)for(unsigned a=0;a<3;++a)s.cursor[a]=origin[a]+forward[a]*16.f;
+            s.cursor_ok=true;
+        }
+        cursor_diagnostic(s, !hit.cast ? "waiting for client ray dispatch" : !hit.available ? "client collision world unavailable" :
+            s.cursor_ok ? "ready" : "aim does not hit a surface", camera, origin, forward);
+        // The gate faces the way the camera looks.
+        if (std::hypot(forward[0], forward[2]) > 0.05f) s.cursor_heading = std::atan2(forward[0], forward[2]) * 180.0f / 3.14159265f;
+        return;
+    }
+    queue_world_ray(ground_ray, {s.position[0], s.position[1] + 0.5f, s.position[2]}, {0, -1, 0}, 6.0f);
+    tick_local_world_rays();
+    const auto hit = world_ray(ground_ray);
+    s.cursor = s.position;
+    if (hit.hit && now_ms() - hit.when < 500 && std::hypot(hit.at[0] - s.position[0], hit.at[2] - s.position[2]) < 2.0f)
+        s.cursor[1] = hit.at[1];
+    s.cursor_heading = s.heading;s.cursor_pitch=0;
+    s.cursor_ok = true;
+    if(s.game && s.game->settings.mode==Mode::race && s.race_object==4) {
+        s.arrow_preview_ready=true;
+        s.arrow_surface={hit.hit && hit.available && now_ms()-hit.when<500,hit.at,{0,1,0}};
+        s.cursor_pitch=-90.f;
+    }
+}
