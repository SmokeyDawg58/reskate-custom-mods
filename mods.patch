+        else if(ch=='I' || ch=='i' || ch=='l' || ch=='j')advance+=18;
+        else if(ch=='W' || ch=='M')advance+=58;
+        else if(ch=='w' || ch=='m' || ch>=0x80)advance+=48;
+        else if(ch>='a' && ch<='z')advance+=34;
+        else if(ch=='E' || ch=='F' || ch=='T' || ch=='P' || ch=='S')advance+=40;
