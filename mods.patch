+void partial_build_rollback() {
+    OwnedMenuModels<Model> owned;
+    std::map<unsigned,unsigned> live{{1,100}};
+    owned.track({1,100}); // A mounted menu that precedes the optional panel.
+    const auto checkpoint=owned.checkpoint();
