+    struct Presenter {
+        std::uint64_t blueprint{},page{};
+        bool operator==(const Presenter&) const = default;
+    };
+    struct Item {Presenter presenter;int id{};bool active{true};};
+    Presenter controller_pair;
+    std::vector<Item> items;
