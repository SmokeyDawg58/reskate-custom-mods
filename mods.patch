diff --git a/Extension/Modes/mode_rules.cpp b/Extension/Modes/mode_rules.cpp
new file mode 100644
index 0000000..86fda6d
--- /dev/null
+++ b/Extension/Modes/mode_rules.cpp
@@ -0,0 +1,1361 @@
+#include "mode_rules.h"
+#include "skatepedia_inputs.h"
+#include "race_route.h"
+#include <algorithm>
+#include <bit>
+#include <cmath>
+#include <format>
+#include <limits>
+#include <stdexcept>
+#include <utility>
+
+namespace dingosdk::modes {
+namespace {
+bool finite(const Vec3 &v) noexcept { return std::isfinite(v[0]) && std::isfinite(v[1]) && std::isfinite(v[2]); }
+float horizontal_distance(const Vec3 &a, const Vec3 &b) noexcept {
+    const float dx = a[0] - b[0], dz = a[2] - b[2];
+    return std::sqrt(dx * dx + dz * dz);
+}
+std::int32_t clamp_score(double value) noexcept {
+    if (!std::isfinite(value) || value <= 0) return 0;
+    return static_cast<std::int32_t>(std::min(value, 2.0e9));
+}
+
+struct Writer {
+    std::vector<std::uint8_t> bytes;
+    void integer(std::uint64_t value, unsigned size) {
+        for (unsigned i = 0; i < size; ++i) bytes.push_back(static_cast<std::uint8_t>(value >> (8 * i)));
+    }
+    void real(float value) { integer(std::bit_cast<std::uint32_t>(value), 4); }
+    void vec(const Vec3 &v) {
+        for (const auto c : v) real(c);
+    }
+};
+struct Reader {
+    std::span<const std::uint8_t> bytes;
+    std::size_t at{};
+    bool ok = true;
+    std::uint64_t integer(unsigned size) {
+        if (!ok || size > bytes.size() - at) { ok = false; return 0; }
+        std::uint64_t value{};
+        for (unsigned i = 0; i < size; ++i) value |= std::uint64_t{bytes[at + i]} << (8 * i);
+        at += size;
+        return value;
+    }
+    float real() { return std::bit_cast<float>(static_cast<std::uint32_t>(integer(4))); }
+    Vec3 vec() { return {real(), real(), real()}; }
+};
+
+bool valid_settings(const Settings &s) noexcept {
+    if (!std::any_of(std::begin(all_modes), std::end(all_modes), [&](Mode m) { return m == s.mode; })) return false;
+    if (s.duration_s < 30 || s.duration_s > 3600 || s.turn_s < 10 || s.turn_s > 120 || s.strikes < 1 || s.strikes > (s.mode == Mode::skate ? max_strikes : 5))
+        return false;
+    if (s.trick_kinds == 0 || s.trick_kinds > all_trick_kinds) return false;
+    if (!(s.radius >= 1.0f && s.radius <= 50.0f)) return false;
+    if (s.corners.size() > max_corners || (s.mode!=Mode::race && s.points.size()>max_points) ||
+        s.points.size()>static_cast<std::size_t>(std::numeric_limits<std::int32_t>::max())) return false;
+    if (!s.gate_kinds.empty() && (s.mode!=Mode::race || s.gate_kinds.size()!=s.points.size() ||
+        !std::all_of(s.gate_kinds.begin(),s.gate_kinds.end(),[](auto k){return k==RaceGateKind::mandatory || k==RaceGateKind::guiding || k==RaceGateKind::arrow;}) ||
+        s.gate_kinds.front()!=RaceGateKind::mandatory || (s.race_finish && s.gate_kinds.back()!=RaceGateKind::mandatory)))return false;
+    if (!s.yaws.empty() && s.yaws.size() != s.points.size()) return false;
+    if (!s.widths.empty() && s.widths.size() != s.points.size()) return false;
+    if (!s.arrow_rolls.empty() && (s.mode!=Mode::race || s.arrow_rolls.size()!=s.points.size() ||
+        !std::all_of(s.arrow_rolls.begin(),s.arrow_rolls.end(),[](float a){return std::isfinite(a) && std::abs(a)<=360.f;})))return false;
+    if (!s.gate_pitches.empty() && (s.mode!=Mode::race || s.gate_pitches.size()!=s.points.size() ||
+        !std::all_of(s.gate_pitches.begin(),s.gate_pitches.end(),[](float a){return std::isfinite(a) && std::abs(a)<=90.f;})))return false;
+    if (!std::all_of(s.widths.begin(), s.widths.end(), [](float w) { return w >= min_gate_half_width && w <= max_gate_half_width; })) return false;
+    if (!std::all_of(s.yaws.begin(), s.yaws.end(), [](float y) { return std::isfinite(y); }) || (s.has_spawn && !finite(s.spawn))) return false;
+    if (s.area_radius != 0.0f && !(s.area_radius >= min_area_radius && s.area_radius <= max_area_radius && s.corners.size() == 1))
+        return false;
+    return std::all_of(s.corners.begin(), s.corners.end(), finite) && std::all_of(s.points.begin(), s.points.end(), finite);
+}
+} // namespace
+
+std::string_view mode_name(Mode m) noexcept {
+    switch (m) {
+    case Mode::jam: return "Spot Jam";
+    case Mode::one_up: return "1-Up";
+    case Mode::meat: return "Hall of Meat";
+    case Mode::race: return "Deathrace";
+    case Mode::domination: return "Domination";
+    case Mode::graffiti: return "Graffiti";
+    case Mode::tag: return "Skate Tag";
+    case Mode::infection: return "Infection";
+    case Mode::hide: return "Hide & Seek";
+    case Mode::skate: return "R.E.S.K.A.T.E.";
+    }
+    return "Game";
+}
+std::string_view mode_key(Mode m) noexcept {
+    switch (m) {
+    case Mode::jam: return "jam";
+    case Mode::one_up: return "1up";
+    case Mode::meat: return "meat";
+    case Mode::race: return "race";
+    case Mode::domination: return "domination";
+    case Mode::graffiti: return "graffiti";
+    case Mode::tag: return "tag";
+    case Mode::infection: return "infection";
+    case Mode::hide: return "hide";
+    case Mode::skate: return "skate";
+    }
+    return "";
+}
+std::string_view mode_summary(Mode m) noexcept {
+    switch (m) {
+    case Mode::jam: return "Land lines inside the area. Every line adds to your score; highest total wins.";
+    case Mode::one_up: return "Take turns. Beat the last score or take a strike; last one standing wins.";
+    case Mode::meat: return "Bail as hard as you can. Speed, drops and tumbling score; most meat wins.";
+    case Mode::race: return "Cross required gates in order; gray guides are optional. Reach the red finish. Countdown only in the final 30 seconds.";
+    case Mode::domination: return "Take spots with your best line there. Every second you hold one scores.";
+    case Mode::graffiti: return "Grind it, manual it, gap it: what you skate takes your colour. A bigger line steals it. Most tags wins.";
+    case Mode::tag: return "One player is it: get close to tag someone else. No tag-backs. Least time spent it wins.";
+    case Mode::infection: return "One player starts infected. Everyone they reach is infected too and joins the hunt. Survive longest to win.";
+    case Mode::hide: return "Hide while the seeker can't see. Then they hunt: whoever is found seeks too. Stay hidden longest to win.";
+    case Mode::skate: return "Set a trick, everyone copies it or takes a letter. Spell R.E.S.K.A.T.E. and you're out; last one standing wins.";
+    }
+    return "";
+}
+std::optional<Mode> parse_mode(std::string_view text) noexcept {
+    std::string key;
+    for (const char c : text) key += static_cast<char>(c >= 'A' && c <= 'Z' ? c - 'A' + 'a' : c);
+    if (key == "jam" || key == "spotjam" || key == "spot_jam") return Mode::jam;
+    if (key == "1up" || key == "1-up" || key == "oneup") return Mode::one_up;
+    if (key == "meat" || key == "hallofmeat" || key == "hom") return Mode::meat;
+    if (key == "race" || key == "deathrace") return Mode::race;
+    if (key == "domination" || key == "dom") return Mode::domination;
+    if (key == "graffiti" || key == "thps") return Mode::graffiti;
+    if (key == "tag" || key == "skatetag" || key == "skate_tag") return Mode::tag;
+    if (key == "infection" || key == "infect" || key == "zombie" || key == "zombies") return Mode::infection;
+    if (key == "hide" || key == "hideandseek" || key == "hide_and_seek" || key == "hidenseek" || key == "seek") return Mode::hide;
+    if (key == "reskate" || key == "r.e.s.k.a.t.e." || key == "r.e.s.k.a.t.e" || key == "skate" || key == "s.k.a.t.e."|| key == "s.k.a.t.e") return Mode::skate;
+    return std::nullopt;
+}
+bool timed(Mode m) noexcept { return m != Mode::one_up && m != Mode::skate; }
+
+namespace {
+std::string lower(std::string_view text) {
+    std::string out;
+    for (const char c : text) out += static_cast<char>(c >= 'A' && c <= 'Z' ? c - 'A' + 'a' : c);
+    return out;
+}
+bool has_any(const std::string &text, std::initializer_list<std::string_view> words) {
+    return std::any_of(words.begin(), words.end(), [&](std::string_view w) { return text.find(w) != std::string::npos; });
+}
+// One part of a trick ("Kickflip", "Seatbelt", "BS 50-50 Grind").
+std::uint8_t part_kinds(const std::string &part) {
+    std::uint8_t kinds = 0;
+    if (has_any(part, {"manual"})) kinds |= trick_manuals;
+    if (has_any(part, {"grind", "slide", "stall", "smith", "feeble", "crook", "blunt", "willy", "salad", "suski", "hurricane",
+                       "rock to", "rock n", "pivot", "nosepick", "5-0", "50-50"}))
+        kinds |= trick_grinds;
+    if (has_any(part, {"grab", "indy", "melon", "stalefish", "mute", "japan", "seatbelt", "benihana", "method", "madonna", "crail",
+                       "airwalk", "christ", "boned", "judo", "roast", "lien", "rocket", "stiffy", "tuck", "nuclear", "slob",
+                       "weddle", "one foot", "frontside air", "backside air", "bone", "stale", "dogpiss", "dog piss", "superdude",
+                       "frigid", "tweak", "shifty", "no foot", "nofoot", "onefoot", "tailwalk", "plant", "double grab"}))
+        kinds |= trick_grabs;
+    if (has_any(part, {"flip", "shuv", "varial", "impossible", "ollie", "nollie", "360", "180", "spin", "pop"})) kinds |= trick_flips;
+    return kinds ? kinds : trick_flips; // anything else done in the air off the board's pop
+}
+}
+
+std::uint8_t trick_kinds_of(std::string_view trick) noexcept {
+    try {
+        const auto text = lower(trick);
+        std::uint8_t kinds = 0;
+        std::size_t start = 0;
+        while (start <= text.size()) {
+            auto end = text.find(" + ", start);
+            if (end == std::string::npos) end = text.size();
+            if (end > start) kinds |= part_kinds(text.substr(start, end - start));
+            start = end + 3;
+        }
+        return kinds;
+    } catch (...) {
+        return 0;
+    }
+}
+namespace {
+// A trick's parts as skate. names them ("Ollie", "BS 50-50 Grind"), without the plain ollie into the
+// part that matters: "Ollie + BS 50-50 Grind" is a 50-50 to set and to copy. A lone ollie stays one.
+// A nollie is kept: a nollie into a trick is a different trick.
+std::vector<std::string> trick_parts(std::string_view trick) {
+    std::vector<std::string> parts;
+    std::size_t start = 0;
+    while (start <= trick.size()) {
+        auto end = trick.find(" + ", start);
+        if (end == std::string_view::npos) end = trick.size();
+        if (end > start) parts.emplace_back(trick.substr(start, end - start));
+        start = end + 3;
+    }
+    const auto filler = [](const std::string &part) {
+        const auto text = lower(part);
+        return text == "ollie";
+    };
+    if (std::any_of(parts.begin(), parts.end(), [&](const std::string &part) { return !filler(part); }))
+        std::erase_if(parts, filler);
+    return parts;
+}
+} // namespace
+
+std::string set_trick_name(std::string_view trick) {
+    try {
+        std::string text;
+        for (const auto &part : trick_parts(trick)) {
+            if (!text.empty()) text += " + ";
+            text += part;
+        }
+        return text;
+    } catch (...) {
+        return std::string(trick);
+    }
+}
+bool copies_trick(std::string_view attempt, std::string_view set) noexcept {
+    try {
+        const auto wanted = trick_parts(set), done = trick_parts(attempt);
+        if (wanted.empty()) return false;
+        // The same parts in the same order, case aside: more or less is a different trick.
+        if (done.size() != wanted.size()) return false;
+        for (std::size_t i = 0; i < done.size(); ++i)
+            if (lower(done[i]) != lower(wanted[i])) return false;
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
+namespace {
+// A trick list name as a Skatepedia key: lower case letters and digits, without "grab"/"grind".
+std::string skatepedia_key(std::string_view name) {
+    std::string key;
+    for (const char c : lower(name))
+        if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')) key += c;
+    for (const std::string_view word : {"grind", "grab"})
+        if (const auto at = key.find(word); at != std::string::npos && key.size() > word.size()) key.erase(at, word.size());
+    return key;
+}
+const skatepedia::Inputs *skatepedia_entry(std::string_view key) noexcept {
+    for (const auto &entry : skatepedia::inputs)
+        if (entry.key == key) return &entry;
+    return nullptr;
+}
+} // namespace
+
+std::string trick_steps(std::string_view trick, bool goofy) {
+    try {
+        std::string text;
+        for (const auto &part : trick_parts(trick)) {
+            // "Switch FS 180 360 Late Flip": the words before the trick's own name. The stance only
+            // changes which foot is forward; a nollie, side and spins can name a Skatepedia entry.
+            std::string side, spin, nollie, name = part;
+            bool late = false, mirrored = false;
+            for (bool more = true; more;) {
+                more = false;
+                for (const std::string_view word : {"Switch ", "Fakie ", "Nollie ", "FS ", "BS ", "180 ", "360 ", "540 ", "720 ", "Late ",
+                                                    "Double ", "Triple ", "Quad ", "Darkflip ", "Dark Catch "}) {
+                    if (!name.starts_with(word) || name.size() == word.size()) continue;
+                    if (word == "Nollie ") nollie = "Nollie ";
+                    else if (word == "Switch ") mirrored = true; // the other foot forward: the other stance's flick
+                    else if (word == "FS " || word == "BS ") side = std::string(word.substr(0, 2));
+                    else if (word == "Late ") late = true;
+                    else if (word[0] >= '0' && word[0] <= '9') spin = std::string(word.substr(0, 3)); // the last (the board's) names it
+                    name = name.substr(word.size());
+                    more = true;
+                }
+            }
+            // The side and body spin after the name ("Inward Heelflip FS 180"), as skate. lists them.
+            for (bool more = true; more;) {
+                more = false;
+                for (const std::string_view word : {" FS", " BS", " 180", " 360", " 540", " 720"}) {
+                    if (!name.ends_with(word) || name.size() == word.size()) continue;
+                    if (word == " FS" || word == " BS") side = std::string(word.substr(1));
+                    name.resize(name.size() - word.size());
+                    more = true;
+                }
+            }
+            // A late flip: the flip's own flick, done in the air (the Skatepedia's "late flip tricks").
+            if (late) {
+                if (!text.empty()) text += ' ';
+                text += "In air";
+            }
+            const skatepedia::Inputs *entry{};
+            // The nollie versions have their own entries ("nolliekickflipunderflip"): those first.
+            for (const auto &candidate : {nollie + side + spin + name, nollie + side + name, nollie + spin + name, nollie + name,
+                                          side + spin + name, side + name, spin + name, name})
+                if ((entry = skatepedia_entry(skatepedia_key(candidate)))) break;
+            if (!entry) {
+                auto heel = skatepedia_key(name); // "Inward Heelflip" is the Skatepedia's "inwardheel"
+                if (const auto at = heel.find("heelflip"); at != std::string::npos) heel.replace(at, 8, "heel");
+                if (!spin.empty()) entry = skatepedia_entry(spin + heel); // "360inwardheel"
+                if (!entry) entry = skatepedia_entry(heel);
+            }
+            if (!entry) continue;
+            for (const auto step : goofy != mirrored ? entry->goofy : entry->regular) {
+                if (late && step == "ID_SKATEPEDIA_INAIR") continue; // said once already
+                const auto shown = step == "ID_SKATEPEDIA_INAIR" ? std::string_view("In air") : step == "ID_SKATEPEDIA_AND" ? std::string_view("+")
+                                   : step.starts_with("ID_") ? std::string_view() : step;
+                if (shown.empty()) continue; // also an unused (empty) step
+                if (!text.empty()) text += ' ';
+                text += shown;
+            }
+        }
+        return text;
+    } catch (...) {
+        return {};
+    }
+}
+bool reskate_custom_zone(const Settings &s, bool draft) noexcept {
