+void report(State &s, Event event, std::int32_t value, std::int32_t extra, const Vec3 &at, const std::vector<Tag> &tags = {},
+            const std::string &trick = {}) {
+    if (!s.game || !playing(*s.game) || !standing(*s.game, self_id(s))) return;
