+    if (!mark.empty())
+        badge(draw, fonts, ImVec2(end.x - S(20) - badge_width(fonts, mark), position.y + S(20)), mark,
+            blue ? rgba(0, 0, 0, 0.34f) : color::blue, blue ? color::text : color::ink);
+    return pressed;
+}
