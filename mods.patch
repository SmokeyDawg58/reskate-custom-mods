+// ---- wire
+namespace {
+constexpr std::size_t max_tags_per_message = 12;
+void write_tags(Writer &w, const std::vector<Tag> &tags, std::size_t limit) {
+    if (tags.size() > limit) throw std::invalid_argument("too many game mode tags");
+    w.integer(tags.size(), 1);
+    for (const auto &t : tags) {
+        if (!valid_tag(t)) throw std::invalid_argument("invalid game mode tag");
+        w.integer(static_cast<std::uint8_t>(t.kind), 1);
+        w.integer(t.path.size(), 1);
+        for (const auto &p : t.path) w.vec(p);
+    }
+}
+bool read_tags(Reader &r, std::vector<Tag> &tags, std::size_t limit) {
+    const auto count = r.integer(1);
+    if (!r.ok || count > limit) return false;
+    for (std::uint64_t i = 0; i < count && r.ok; ++i) {
+        Tag t;
+        t.kind = static_cast<TagKind>(r.integer(1));
+        const auto points = r.integer(1);
+        if (!r.ok || points > max_tag_points) return false;
+        for (std::uint64_t k = 0; k < points && r.ok; ++k) t.path.push_back(r.vec());
+        if (!r.ok || !valid_tag(t)) return false;
+        tags.push_back(std::move(t));
+    }
+    return r.ok;
+}
+// A trick's name: a length byte and its text (printable, at most max_trick_length).
+void write_text(Writer &w, const std::string &text) {
+    if (text.size() > max_trick_length) throw std::invalid_argument("game mode trick name too long");
+    w.integer(text.size(), 1);
+    w.bytes.insert(w.bytes.end(), text.begin(), text.end());
+}
+bool read_text(Reader &r, std::string &text) {
+    const auto length = r.integer(1);
+    if (!r.ok || length > max_trick_length || length > r.bytes.size() - r.at) return false;
+    text.assign(reinterpret_cast<const char *>(r.bytes.data() + r.at), static_cast<std::size_t>(length));
+    r.at += static_cast<std::size_t>(length);
+    for (auto &ch : text)
+        if (static_cast<unsigned char>(ch) < 0x20) ch = ' ';
+    return true;
+}
+} // namespace
+std::vector<std::uint8_t> encode(const Message &m) {
+    Writer w;
+    w.integer(wire_magic, 1);
+    w.integer(m.version, 1);
+    w.integer(static_cast<std::uint8_t>(m.kind), 1);
+    w.integer(m.leader, 8);
+    w.integer(m.game, 4);
+    switch (m.kind) {
+    case Message::Kind::setup: {
+        const auto &s = m.settings;
+        if (!valid_settings(s)) throw std::invalid_argument("invalid game mode settings");
+        w.integer(static_cast<std::uint8_t>(s.mode), 1);
+        w.integer(s.duration_s, 4);
+        w.integer(s.turn_s, 4);
+        w.integer(s.strikes, 1);
+        w.real(s.radius);
+        w.real(s.area_radius);
+        w.integer(s.yaws.size(), 4);
+        for (const auto yaw : s.yaws) w.real(yaw);
+        w.integer(s.widths.size(), 4);
+        for (const auto width : s.widths) w.real(width);
+        w.integer(s.has_spawn ? 1 : 0, 1);
+        w.integer(s.race_finish ? 1 : 0, 1);
+        if (s.has_spawn) w.vec(s.spawn);
+        w.integer(s.corners.size(), 1);
+        for (const auto &p : s.corners) w.vec(p);
+        w.integer(s.points.size(), 4);
+        for (const auto &p : s.points) w.vec(p);
+        w.integer(s.gate_kinds.size(),4);
+        for(const auto kind:s.gate_kinds)w.integer(static_cast<std::uint8_t>(kind),1);
+        w.integer(s.arrow_rolls.size(),4);
+        for(const auto roll:s.arrow_rolls)w.real(roll);
+        w.integer(s.gate_pitches.size(),4);
+        for(const auto pitch:s.gate_pitches)w.real(pitch);
+        w.integer(s.trick_kinds, 1);
+        break;
+    }
+    case Message::Kind::state:
+        if (m.standings.size() > max_players || m.zones.size() > max_zones) throw std::invalid_argument("game mode state too large");
+        w.integer(static_cast<std::uint8_t>(m.phase), 1);
+        w.integer(m.remaining_ms, 4);
+        w.integer(m.turn, 8);
+        w.integer(static_cast<std::uint32_t>(m.target), 4);
+        w.integer(m.standings.size(), 1);
+        for (const auto &s : m.standings) {
+            w.integer(s.player, 8);
+            w.integer(static_cast<std::uint32_t>(s.score), 4);
+            w.integer(static_cast<std::uint32_t>(s.aux), 4);
+            w.integer((s.out ? 1u : 0u) | (s.up ? 2u : 0u), 1);
+            w.integer(s.remaining_ms, 4);
+        }
+        w.integer(m.zones.size(), 1);
+        for (const auto &z : m.zones) {
+            w.integer(z.zone, 1);
+            w.integer(z.owner, 8);
+            w.integer(static_cast<std::uint32_t>(z.best), 4);
+        }
+        if (m.calls.size() > max_calls) throw std::invalid_argument("too many game mode calls");
+        w.integer(m.call_serial, 4);
+        w.integer(m.calls.size(), 1);
+        for (const auto &text : m.calls) {
+            if (text.size() > max_call_length) throw std::invalid_argument("game mode call too long");
+            w.integer(text.size(), 1);
+            w.bytes.insert(w.bytes.end(), text.begin(), text.end());
+        }
+        write_text(w, m.trick);
+        w.integer(m.setter, 8);
+        break;
+    case Message::Kind::event:
+        if (!finite(m.at)) throw std::invalid_argument("invalid game mode event");
+        w.integer(static_cast<std::uint8_t>(m.event), 1);
+        w.integer(static_cast<std::uint32_t>(m.value), 4);
+        w.integer(static_cast<std::uint32_t>(m.extra), 4);
+        w.vec(m.at);
+        w.integer(m.sequence, 4);
+        write_tags(w, m.tags, max_line_tags);
+        write_text(w, m.trick);
+        break;
+    case Message::Kind::tags:
+        if (m.first + m.tags.size() > max_tags) throw std::invalid_argument("game mode tags out of range");
+        w.integer(m.first, 1);
+        write_tags(w, m.tags, max_tags_per_message);
+        break;
+    case Message::Kind::leave:
+    case Message::Kind::end:
+    case Message::Kind::join:
+    case Message::Kind::ready:
+    case Message::Kind::hello: break;
+    default: throw std::invalid_argument("unknown game mode message");
+    }
+    return w.bytes;
+}
+
+std::uint8_t message_version(std::span<const std::uint8_t> bytes) noexcept {
+    return bytes.size() >= 2 && bytes[0] == wire_magic ? bytes[1] : 0;
+}
+
+std::optional<Message> decode(std::span<const std::uint8_t> bytes) noexcept {
+    try {
+        Reader r{bytes};
+        if (r.integer(1) != wire_magic) return std::nullopt;
+        Message m;
+        m.version = static_cast<std::uint8_t>(r.integer(1));
+        if (m.version != wire_version) return std::nullopt;
+        const auto kind = r.integer(1);
+        if (kind < 1 || kind > 9) return std::nullopt;
+        m.kind = static_cast<Message::Kind>(kind);
+        m.leader = r.integer(8);
+        m.game = static_cast<std::uint32_t>(r.integer(4));
+        if (!m.leader || !m.game) return std::nullopt;
+        switch (m.kind) {
+        case Message::Kind::setup: {
+            auto &s = m.settings;
+            s.mode = static_cast<Mode>(r.integer(1));
+            s.duration_s = static_cast<std::uint32_t>(r.integer(4));
+            s.turn_s = static_cast<std::uint32_t>(r.integer(4));
+            s.strikes = static_cast<std::uint8_t>(r.integer(1));
+            s.radius = r.real();
+            s.area_radius = r.real();
+            const auto yaws = r.integer(4);
+            if (!r.ok || yaws>(bytes.size()-r.at)/4) return std::nullopt;
+            for (std::uint64_t i = 0; i < yaws && r.ok; ++i) s.yaws.push_back(r.real());
+            const auto widths = r.integer(4);
+            if (!r.ok || widths>(bytes.size()-r.at)/4) return std::nullopt;
+            for (std::uint64_t i = 0; i < widths && r.ok; ++i) s.widths.push_back(r.real());
+            s.has_spawn = r.integer(1) != 0;
+            s.race_finish = r.integer(1) != 0;
+            if (s.has_spawn) s.spawn = r.vec();
+            const auto corners = r.integer(1);
+            if (corners > max_corners) return std::nullopt;
+            for (std::uint64_t i = 0; i < corners && r.ok; ++i) s.corners.push_back(r.vec());
+            const auto points = r.integer(4);
+            if (!r.ok || points>(bytes.size()-r.at)/12) return std::nullopt;
+            for (std::uint64_t i = 0; i < points && r.ok; ++i) s.points.push_back(r.vec());
+            const auto kinds=r.integer(4);
+            if(!r.ok || kinds>bytes.size()-r.at)return std::nullopt;
+            for(std::uint64_t i=0;i<kinds && r.ok;++i)s.gate_kinds.push_back(static_cast<RaceGateKind>(r.integer(1)));
+            const auto rolls=r.integer(4);
+            if(!r.ok || rolls>(bytes.size()-r.at)/4)return std::nullopt;
+            for(std::uint64_t i=0;i<rolls && r.ok;++i)s.arrow_rolls.push_back(r.real());
+            const auto pitches=r.integer(4);
+            if(!r.ok || pitches>(bytes.size()-r.at)/4)return std::nullopt;
+            for(std::uint64_t i=0;i<pitches && r.ok;++i)s.gate_pitches.push_back(r.real());
+            s.trick_kinds = static_cast<std::uint8_t>(r.integer(1));
+            if (!r.ok || !valid_settings(s)) return std::nullopt;
+            break;
+        }
+        case Message::Kind::state: {
+            const auto phase = r.integer(1);
+            if (phase < 1 || phase > 4) return std::nullopt;
+            m.phase = static_cast<Phase>(phase);
+            m.remaining_ms = static_cast<std::uint32_t>(r.integer(4));
+            m.turn = r.integer(8);
+            m.target = static_cast<std::int32_t>(r.integer(4));
+            const auto standings = r.integer(1);
+            if (standings > max_players) return std::nullopt;
+            for (std::uint64_t i = 0; i < standings && r.ok; ++i) {
+                Standing s;
+                s.player = r.integer(8);
+                s.score = static_cast<std::int32_t>(r.integer(4));
+                s.aux = static_cast<std::int32_t>(r.integer(4));
+                const auto flags = r.integer(1);
+                s.out = flags & 1;
+                s.up = flags & 2;
+                s.remaining_ms = static_cast<std::uint32_t>(r.integer(4));
+                m.standings.push_back(s);
+            }
+            const auto zones = r.integer(1);
+            if (zones > max_zones) return std::nullopt;
+            for (std::uint64_t i = 0; i < zones && r.ok; ++i) {
+                ZoneOwner z;
+                z.zone = static_cast<std::uint8_t>(r.integer(1));
+                z.owner = r.integer(8);
+                z.best = static_cast<std::int32_t>(r.integer(4));
+                if (z.zone >= max_zones) return std::nullopt;
+                m.zones.push_back(z);
+            }
+            m.call_serial = static_cast<std::uint32_t>(r.integer(4));
+            const auto calls = r.integer(1);
+            if (calls > max_calls) return std::nullopt;
+            for (std::uint64_t i = 0; i < calls && r.ok; ++i) {
+                const auto length = r.integer(1);
+                if (!r.ok || length > max_call_length || length > bytes.size() - r.at) return std::nullopt;
+                std::string text(reinterpret_cast<const char *>(bytes.data() + r.at), static_cast<std::size_t>(length));
+                r.at += static_cast<std::size_t>(length);
+                // Shown on screen: printable text only.
+                for (auto &ch : text)
+                    if (static_cast<unsigned char>(ch) < 0x20) ch = ' ';
+                m.calls.push_back(std::move(text));
+            }
+            if (!read_text(r, m.trick)) return std::nullopt;
+            m.setter = r.integer(8);
+            break;
+        }
+        case Message::Kind::event: {
+            const auto event = r.integer(1);
+            if (event < 1 || event > 5) return std::nullopt;
+            m.event = static_cast<Event>(event);
+            m.value = static_cast<std::int32_t>(r.integer(4));
+            m.extra = static_cast<std::int32_t>(r.integer(4));
+            m.at = r.vec();
+            m.sequence = static_cast<std::uint32_t>(r.integer(4));
+            if (!finite(m.at) || m.value < 0 || !read_tags(r, m.tags, max_line_tags) || !read_text(r, m.trick)) return std::nullopt;
+            break;
+        }
+        case Message::Kind::tags:
+            m.first = static_cast<std::uint8_t>(r.integer(1));
+            if (!read_tags(r, m.tags, max_tags_per_message) || m.first + m.tags.size() > max_tags) return std::nullopt;
+            break;
+        case Message::Kind::leave:
+        case Message::Kind::end:
+        case Message::Kind::join:
+        case Message::Kind::ready:
+        case Message::Kind::hello: break;
+        default: return std::nullopt;
+        }
+        if (!r.ok || r.at != bytes.size()) return std::nullopt;
+        return m;
+    } catch (...) {
+        return std::nullopt;
+    }
+}
+
+// ---- referee
+Referee::Referee(Settings settings, std::uint64_t leader, std::uint32_t game)
+    : settings_(std::move(settings)), leader_(leader), game_(game) {
+    // Graffiti's tags are found as they are skated; Domination's spots are set up front.
+    if (settings_.mode == Mode::domination) owners_.resize(settings_.points.size());
+    for (std::size_t i = 0; i < owners_.size(); ++i) owners_[i].zone = static_cast<std::uint8_t>(i);
+}
+Referee::Player *Referee::find(std::uint64_t id) noexcept {
+    for (auto &p : players_)
+        if (p.id == id) return &p;
+    return nullptr;
+}
+const Referee::Player *Referee::find(std::uint64_t id) const noexcept {
+    for (const auto &p : players_)
+        if (p.id == id) return &p;
+    return nullptr;
+}
+bool Referee::has_player(std::uint64_t player) const noexcept { return find(player) != nullptr; }
+void Referee::set_name(std::uint64_t player, std::string name) {
+    if (auto *p = find(player)) p->name = std::move(name);
+}
+std::string Referee::name_of(std::uint64_t id) const {
+    const auto *p = find(id);
+    return p && !p->name.empty() ? p->name : std::string("A player");
+}
+std::size_t Referee::still_in() const noexcept {
+    return static_cast<std::size_t>(std::count_if(players_.begin(), players_.end(), [](const Player &p) { return !p.out; }));
+}
+void Referee::add_player(std::uint64_t player) {
+    if (!player || find(player) || players_.size() >= max_players) return;
+    if (phase_ != Phase::setup && phase_ != Phase::countdown) return;
+    players_.push_back({player});
+}
+void Referee::remove_player(std::uint64_t player, std::uint64_t now_ms) {
+    auto *p = find(player);
+    if (!p || p->out) return;
+    if (phase_ == Phase::setup || phase_ == Phase::countdown) {
+        std::erase_if(players_, [&](const Player &q) { return q.id == player; });
+        return;
+    }
+    // A completed race result belongs to this run even when its owner leaves
+    // the waiting/results UI while the other racers are still finishing.
+    if(settings_.mode==Mode::race && p->finished)return;
+    if(settings_.mode==Mode::race && phase_==Phase::playing && !p->finished)
+        p->aux=static_cast<std::int32_t>(std::min<std::uint64_t>(now_ms>=play_at_?now_ms-play_at_:0,0x7fffffff));
+    p->out = true;
+    call(name_of(player) + " left the game");
+    if (phase_ != Phase::playing) return;
+    // Skate Tag: the one who is it leaving hands it to the next player still in.
+    if (settings_.mode == Mode::tag) {
+        if (player == it_)
+            for (const auto &q : players_)
+                if (!q.out) {
+                    make_it(q.id, 0, now_ms);
+                    break;
+                }
+        if (players_.size() > 1 && still_in() <= 1) finish(now_ms);
+        return;
+    }
+    // Infection (and Hide & Seek): the last survivor leaving, or the last of the infected, ends it.
+    if (hunt_like(settings_.mode)) {
+        const bool hunters = std::any_of(players_.begin(), players_.end(), [](const Player &q) { return !q.out && q.infected; });
+        if (players_.size() > 1 && (survivors() == 0 || !hunters || still_in() <= 1)) finish(now_ms);
+        return;
+    }
+    if (settings_.mode == Mode::one_up && turn_ < players_.size() && players_[turn_].id == player) next_turn(now_ms);
+    else if (settings_.mode == Mode::one_up && (still_in() == 0 || (players_.size() > 1 && still_in() <= 1))) finish(now_ms);
+    if (settings_.mode == Mode::skate) {
+        if (setter_ < players_.size() && players_[setter_].id == player) pass_set(now_ms);
+        else if (turn_ < players_.size() && players_[turn_].id == player) next_copier(now_ms);
+        else if (still_in() == 0 || (players_.size() > 1 && still_in() <= 1)) finish(now_ms);
+    }
+}
+void Referee::start(std::uint64_t now_ms) {
+    if (phase_ != Phase::setup) return;
+    phase_ = Phase::countdown;
+    phase_at_ = now_ms;
+}
+void Referee::begin_play(std::uint64_t now_ms) {
+    phase_ = Phase::playing;
+    phase_at_ = last_second_ = turn_at_ = play_at_ = now_ms;
+    released_ = false;
+    turn_ = 0;
+    target_ = 0;
+    // Point zero is the native start flag, already accepted during setup.
+    // The first visible gate is point one; crossing the flag is never required.
+    if (settings_.mode == Mode::race)
+        for (auto& player : players_) player.score = static_cast<std::int32_t>(next_race_gate(settings_,1));
+    call("GO!");
+    if (settings_.mode == Mode::one_up && !players_.empty())
+        call(name_of(players_[0].id) + " is up: set a score");
+    if (settings_.mode == Mode::skate && !players_.empty()) {
+        setter_ = 0;
+        set_trick_.clear();
+        done_tricks_.clear();
+        call(name_of(players_[0].id) + " sets first");
+    }
+    // Skate Tag: someone starts it, picked by the game's id so every game starts differently.
+    if (settings_.mode == Mode::tag && !players_.empty()) make_it(players_[game_ % players_.size()].id, 0, now_ms);
+    // Infection: patient zero, picked the same way; everyone else starts clean.
+    if (settings_.mode == Mode::infection && !players_.empty()) {
+        auto &zero = players_[game_ % players_.size()];
+        zero.infected = true;
+        it_counted_ = now_ms;
+        call(name_of(zero.id) + " is patient zero!");
+    }
+    // Hide & Seek: the seeker, picked the same way; everyone else hides.
+    if (settings_.mode == Mode::hide && !players_.empty()) {
+        auto &seeker = players_[game_ % players_.size()];
+        seeker.infected = true;
+        it_counted_ = now_ms;
+        call(std::format("{} is seeking! Hide! ({} s)", name_of(seeker.id), settings_.turn_s));
+    }
+}
+std::size_t Referee::survivors() const noexcept {
+    return static_cast<std::size_t>(std::count_if(players_.begin(), players_.end(), [](const Player &p) { return !p.out && !p.infected; }));
+}
+// Infection: every infected player whose position is fresh infects each survivor within reach whose
+// position is fresh too. A game of more than one player ends when nobody is left clean.
+void Referee::try_infections(std::uint64_t now_ms) {
+    if (settings_.mode == Mode::hide && now_ms < hide_end()) return; // nobody is found while the seekers count
+    const float reach = settings_.radius;
+    const auto fresh = [&](const Player &p) { return !p.out && p.at_time && now_ms - p.at_time <= position_fresh_ms; };
+    std::vector<std::pair<std::uint64_t, std::uint64_t>> caught; // victim, by
+    for (const auto &hunter : players_) {
+        if (!hunter.infected || !fresh(hunter)) continue;
+        for (const auto &q : players_) {
+            if (q.infected || !fresh(q)) continue;
+            const float dx = q.at[0] - hunter.at[0], dy = q.at[1] - hunter.at[1], dz = q.at[2] - hunter.at[2];
+            if (dx * dx + dy * dy + dz * dz <= reach * reach &&
+                std::none_of(caught.begin(), caught.end(), [&](const auto &c) { return c.first == q.id; }))
+                caught.push_back({q.id, hunter.id});
+        }
+    }
+    for (const auto &[victim, by] : caught) {
+        auto *p = find(victim);
+        p->infected = true;
+        if (settings_.mode == Mode::hide) {
+            ++find(by)->aux; // finds
+            call(std::format("{} found {}!", name_of(by), name_of(victim)));
+        } else {
+            call(std::format("{} infected {}!", name_of(by), name_of(victim)));
+        }
+    }
+    if (!caught.empty() && players_.size() > 1 && survivors() == 0) {
+        call(name_of(caught.back().first) + (settings_.mode == Mode::hide ? " was the last one hiding" : " was the last survivor"));
+        finish(now_ms);
+    }
+}
+void Referee::make_it(std::uint64_t player, std::uint64_t by, std::uint64_t now_ms) {
+    it_ = player;
+    tagged_by_ = by;
+    it_since_ = it_counted_ = now_ms;
+    call(by ? std::format("{} tagged {}!", name_of(by), name_of(player)) : name_of(player) + " is it!");
+}
+// Skate Tag: whoever is it, within reach of another player who is not the one that just tagged
+// them, tags them. Both positions must be fresh: an old one is somewhere they no longer are.
+void Referee::try_tags(std::uint64_t now_ms) {
+    const auto *it = find(it_);
+    if (!it || it->out || !it->at_time || now_ms - it->at_time > position_fresh_ms) return;
+    const float reach = settings_.radius;
+    for (const auto &q : players_) {
+        if (q.id == it_ || q.out || !q.at_time || now_ms - q.at_time > position_fresh_ms) continue;
+        if (q.id == tagged_by_ && now_ms - it_since_ < no_tag_back_ms) continue; // no tag-backs
+        const float dx = q.at[0] - it->at[0], dy = q.at[1] - it->at[1], dz = q.at[2] - it->at[2];
+        if (dx * dx + dy * dy + dz * dz <= reach * reach) {
+            make_it(q.id, it_, now_ms);
+            return;
+        }
+    }
+}
+void Referee::finish(std::uint64_t now_ms) {
+    if (phase_ == Phase::results) return;
+    phase_ = Phase::results;
+    phase_at_ = now_ms;
+    const auto standings = state(now_ms).standings;
+    if (!standings.empty()) call(name_of(standings.front().player) + " wins!");
+}
+void Referee::strike(Player &p, std::uint64_t now_ms, std::string_view why) {
+    ++p.strikes;
+    p.aux = p.strikes;
+    call(std::format("{} {}: strike {} of {}", name_of(p.id), why, p.strikes, settings_.strikes));
+    if (p.strikes >= settings_.strikes) {
+        p.out = true;
+        call(name_of(p.id) + " is out");
+    }
+    next_turn(now_ms);
+}
+void Referee::next_turn(std::uint64_t now_ms) {
+    if (still_in() == 0 || (players_.size() > 1 && still_in() <= 1)) {
+        finish(now_ms);
+        return;
+    }
+    for (std::size_t step = 1; step <= players_.size(); ++step) {
+        const auto index = (turn_ + step) % players_.size();
+        if (!players_[index].out) {
+            turn_ = index;
+            break;
+        }
+    }
+    turn_at_ = now_ms;
+    call(target_ > 0 ? std::format("{} is up: beat {}", name_of(players_[turn_].id), target_)
+                                 : name_of(players_[turn_].id) + " is up: set a score");
+}
+// ---- R.E.S.K.A.T.E.
+namespace {
+bool same_trick(std::string_view a, std::string_view b) noexcept {
+    if (a.size() != b.size()) return false;
+    for (std::size_t i = 0; i < a.size(); ++i) {
+        const auto x = a[i] >= 'A' && a[i] <= 'Z' ? a[i] - 'A' + 'a' : a[i], y = b[i] >= 'A' && b[i] <= 'Z' ? b[i] - 'A' + 'a' : b[i];
+        if (x != y) return false;
+    }
+    return true;
+}
+}
+void Referee::letter(Player &p, std::string_view why) {
+    ++p.strikes;
+    p.aux = p.strikes;
+    call(std::format("{} {}: {}", name_of(p.id), why, skate_letters(p.strikes, settings_.strikes)));
+    if (p.strikes >= settings_.strikes) {
+        p.out = true;
+        call(name_of(p.id) + " is out");
+    }
+}
+void Referee::pass_set(std::uint64_t now_ms) {
+    if (still_in() == 0 || (players_.size() > 1 && still_in() <= 1)) {
+        finish(now_ms);
+        return;
+    }
+    set_trick_.clear();
+    for (std::size_t step = 1; step <= players_.size(); ++step) {
+        const auto index = (setter_ + step) % players_.size();
+        if (!players_[index].out) {
+            setter_ = index;
+            break;
+        }
+    }
+    turn_ = setter_;
+    turn_at_ = now_ms;
+    call(name_of(players_[setter_].id) + " sets next");
+}
+void Referee::next_copier(std::uint64_t now_ms) {
+    if (still_in() == 0 || (players_.size() > 1 && still_in() <= 1)) {
+        finish(now_ms);
+        return;
+    }
+    for (std::size_t step = 1; step <= players_.size(); ++step) {
+        const auto index = (turn_ + step) % players_.size();
+        if (index == setter_) break; // everyone has had a go: the setter sets again
+        if (!players_[index].out) {
+            turn_ = index;
+            turn_at_ = now_ms;
+            call(std::format("{}: copy the {}", name_of(players_[index].id), set_trick_));
+            return;
+        }
+    }
+    if (setter_ >= players_.size() || players_[setter_].out) {
+        pass_set(now_ms);
+        return;
+    }
+    set_trick_.clear();
+    turn_ = setter_;
+    turn_at_ = now_ms;
+    call(name_of(players_[setter_].id) + " sets again");
+}
+void Referee::skate_attempt(Player &p, bool landed, std::string_view trick, std::uint64_t now_ms) {
+    const std::string name = set_trick_name(trick.substr(0, max_trick_length));
+    if (set_trick_.empty() && turn_ == setter_) { // setting
+        if (!landed || name.empty()) {
+            call(name_of(p.id) + " missed the set");
+            pass_set(now_ms);
+        } else if (!trick_allowed(settings_, name)) {
+            call(std::format("{}: not in this game", name));
+            pass_set(now_ms);
+        } else if (std::any_of(done_tricks_.begin(), done_tricks_.end(), [&](const std::string &t) { return same_trick(t, name); })) {
+            call(std::format("{}: already set", name));
+            pass_set(now_ms);
+        } else {
+            set_trick_ = name;
+            done_tricks_.push_back(name);
+            ++p.score; // tricks set, the tiebreak
+            call(std::format("{} set the {}", name_of(p.id), name));
+            if (players_.size() == 1) { // playing alone: land your own set again, or take a letter
+                turn_at_ = now_ms;
+                call(std::format("{}: land the {} again", name_of(p.id), name));
+            } else
+                next_copier(now_ms);
+        }
+        return;
+    }
+    if (landed && copies_trick(name, set_trick_)) call(name_of(p.id) + " landed it");
+    else letter(p, landed && !name.empty() ? std::format("did a {}", name) : std::string("missed"));
+    next_copier(now_ms);
+}
+
+void Referee::event(std::uint64_t player, Event event, std::int32_t value, const Vec3 &at, std::uint32_t sequence,
+                    std::uint64_t now_ms, const std::vector<Tag> &tags, std::string_view trick) {
+    if (phase_ != Phase::playing) return;
+    auto *p = find(player);
+    if (!p || p->out || p->finished || sequence <= p->sequence) return;
+    p->sequence = sequence;
+    // Skate Tag and Infection run on where everyone is (anywhere: leaving the area is dealt with by
+    // sending them back).
+    if (tag_like(settings_.mode)) {
+        if (event != Event::position) return;
+        for (const auto v : at)
+            if (!std::isfinite(v) || std::abs(v) > 1e6f) return;
+        p->at = at;
+        p->at_time = now_ms;
+        if (settings_.mode == Mode::tag) try_tags(now_ms);
+        else try_infections(now_ms);
+        return;
+    }
+    if (event == Event::position) {
+        if(settings_.mode==Mode::race && finite(at)) {p->at=at;p->at_time=now_ms;}
+        return;
+    }
+    if (settings_.mode != Mode::race && !inside(settings_, at)) return; // out of the area: nothing counts
+    switch (settings_.mode) {
+    case Mode::tag:
+    case Mode::infection:
+    case Mode::hide: return; // handled above, from positions
+    case Mode::skate:
+        if (event != Event::trick || turn_ >= players_.size() || players_[turn_].id != player) return;
+        skate_attempt(*p, value != 0, trick, now_ms);
+        break;
+    case Mode::jam:
+        if (event != Event::line) return;
+        p->score += value;
+        p->aux = std::max(p->aux, value);
+        break;
+    case Mode::meat:
+        if (event != Event::bail) return;
+        p->score += value;
+        if (value > p->aux) {
+            p->aux = value;
+            call(std::format("{} took {} of meat", name_of(player), value));
+        }
+        break;
+    case Mode::one_up: {
+        if (turn_ >= players_.size() || players_[turn_].id != player) return;
+        if (event == Event::bail) {
+            strike(*p, now_ms, "bailed");
+        } else if (event == Event::line) {
+            if (value > target_) {
+                call(target_ > 0 ? std::format("{} beat it: {}", name_of(player), value)
+                                             : std::format("{} set {}", name_of(player), value));
+                target_ = value;
+                p->score = std::max(p->score, value);
+                next_turn(now_ms);
+            } else {
+                strike(*p, now_ms, std::format("fell short of {}", target_));
+            }
+        }
+        break;
+    }
+    case Mode::race: {
+        if (p->finished) return;
+        const auto deadline=phase_at_+settings_.duration_s*1000ull;
+        if (now_ms>=deadline) {p->out=true;return;}
+        if (event != Event::checkpoint || value != p->score || !finite(at)) return;
+        if (settings_.points.empty() || static_cast<std::size_t>(value) >= settings_.points.size()) return;
+        const auto index=static_cast<std::size_t>(value);
+        if(race_gate_pitch(settings_,index)!=0.f) {
+            const auto axes=race_gate_axes(index<settings_.yaws.size()?settings_.yaws[index]:0.f,race_gate_pitch(settings_,index));
+            if(std::abs(race_gate_dot(at,settings_.points[index],axes.right))>gate_half_width(settings_,index)*1.3f+3.f ||
+               std::abs(race_gate_dot(at,settings_.points[index],axes.up))>race_gate_height(settings_,index)+3.f ||
+               std::abs(race_gate_dot(at,settings_.points[index],axes.forward))>3.f)return;
+        } else {
+        if(std::abs(at[1]-settings_.points[static_cast<std::size_t>(value)][1])>10.f*gate_half_width(settings_,static_cast<std::size_t>(value))/6.f)return;
+        // Within the gate's own width (where the crossing was reported), with some slack for lag.
+        if (horizontal_distance(at, settings_.points[static_cast<std::size_t>(value)]) >
+            gate_half_width(settings_, static_cast<std::size_t>(value)) * 1.3f + 3.0f)
+            return;
+        }
+        p->score=static_cast<std::int32_t>(next_race_gate(settings_,static_cast<std::size_t>(value)+1));
+        if (value>0 && static_cast<std::size_t>(value)+1<settings_.points.size())
+            call(std::format("{}: required gate {}/{}",name_of(player),mandatory_gates(settings_,p->score),mandatory_gates(settings_,settings_.points.size())));
+        if (static_cast<std::size_t>(p->score) == settings_.points.size()) {
+            p->finished = true;
+            p->aux = static_cast<std::int32_t>(std::min<std::uint64_t>(now_ms - phase_at_, 0x7fffffff));
+            const auto place = std::count_if(players_.begin(), players_.end(), [](const Player &q) { return q.finished; });
+            call(std::format("{} finished #{} in {:.1f} s", name_of(player), place, p->aux / 1000.0));
+        }
+        break;
+    }
+    case Mode::domination: {
+        if (event != Event::line) return;
+        const auto spot = spot_at(settings_, at);
+        if (!spot || value <= owners_[*spot].best) return;
+        if (owners_[*spot].owner != player) call(std::format("{} took spot {}", name_of(player), *spot + 1));
+        owners_[*spot].owner = player;
+        owners_[*spot].best = value;
+        p->aux = std::max(p->aux, value);
+        break;
+    }
+    case Mode::graffiti: {
+        if (event != Event::line) return;
+        // Every grind and gap in the line is tagged with it: a new tag, or a steal when the line
+        // beats the one that holds it.
+        std::size_t tagged = 0, stolen = 0;
+        std::uint64_t from{};
+        for (std::size_t t = 0; t < tags.size() && t < max_line_tags; ++t) {
+            const auto &tag = tags[t];
+            if (!valid_tag(tag) || !inside(settings_, tag_centre(tag))) continue;
+            auto found = std::find_if(tags_.begin(), tags_.end(), [&](const Tag &known) { return same_tag(known, tag); });
+            if (found == tags_.end()) {
+                if (tags_.size() >= max_tags) continue;
+                tags_.push_back(tag);
+                owners_.push_back({static_cast<std::uint8_t>(tags_.size() - 1), 0, 0});
+                found = tags_.end() - 1;
+            }
+            auto &owner = owners_[static_cast<std::size_t>(found - tags_.begin())];
+            if (owner.owner == player) {
+                owner.best = std::max(owner.best, value);
+                continue;
+            }
+            if (value <= owner.best) continue;
+            if (owner.owner) {
+                ++stolen;
+                from = owner.owner;
+            } else {
+                ++tagged;
+            }
+            owner.owner = player;
+            owner.best = value;
+        }
+        if (stolen) call(stolen == 1 ? std::format("{} stole a tag from {}", name_of(player), name_of(from))
+                                     : std::format("{} stole {} tags", name_of(player), stolen));
+        else if (tagged) call(std::format("{} tagged {} spot{}", name_of(player), tagged, tagged == 1 ? "" : "s"));
+        for (auto &q : players_) {
+            q.score = q.aux = 0;
+            for (const auto &o : owners_)
+                if (o.owner == q.id) { ++q.score; q.aux += o.best; }
+        }
+        break;
+    }
+    }
+}
+bool Referee::tick(std::uint64_t now_ms) {
+    const auto elapsed = now_ms >= phase_at_ ? now_ms - phase_at_ : 0;
+    switch (phase_) {
+    case Phase::countdown:
+        if (elapsed >= countdown_ms) { begin_play(now_ms); return true; }
+        return false;
+    case Phase::playing:
+        if (timed(settings_.mode) && settings_.mode!=Mode::race && elapsed >= settings_.duration_s * 1000ull) { finish(now_ms); return true; }
+        if (settings_.mode==Mode::race) {
+            bool expired{};
+            for(auto& p:players_)if(!p.out && !p.finished) {
+                if(elapsed>=settings_.duration_s*1000ull) {p.aux=static_cast<std::int32_t>(settings_.duration_s*1000u);p.out=true;expired=true;call(name_of(p.id)+" DNF: missed the finish deadline");}
+            }
+            if(expired && !std::all_of(players_.begin(),players_.end(),[](const Player& p){return p.finished || p.out;}))return true;
+        }
+        if (settings_.mode == Mode::race && !players_.empty() &&
+            std::all_of(players_.begin(), players_.end(), [](const Player &p) { return p.finished || p.out; })) {
+            finish(now_ms);
+            return true;
+        }
+        if (settings_.mode == Mode::domination) {
+            while (now_ms >= last_second_ + 1000) {
+                last_second_ += 1000;
+                for (const auto &o : owners_)
+                    if (auto *p = o.owner ? find(o.owner) : nullptr) ++p->score;
+            }
+        }
+        if (settings_.mode == Mode::tag) {
+            // The time spent it, in tenths of a second (the score: fewer wins).
+            if (auto *p = find(it_)) {
+                p->it_ms += now_ms - it_counted_;
+                p->score = static_cast<std::int32_t>(std::min<std::uint64_t>(p->it_ms / 100, 0x7fffffff));
+            }
+            it_counted_ = now_ms;
+        }
+        // Hide & Seek: the seekers come out when the hiding time is up; hiding time scores nothing.
+        if (settings_.mode == Mode::hide && !released_) {
+            if (now_ms < hide_end()) {
+                it_counted_ = now_ms;
+                return false;
+            }
+            released_ = true;
+            it_counted_ = hide_end();
+            call("Ready or not, here they come!");
+            for (auto &p : players_) // the release: scored from the end of the hiding time, sent at once
+                if (!p.out && !p.infected) {
+                    p.it_ms += now_ms - it_counted_;
+                    p.score = static_cast<std::int32_t>(std::min<std::uint64_t>(p.it_ms / 100, 0x7fffffff));
+                }
+            it_counted_ = now_ms;
+            return true;
+        }
+        if (hunt_like(settings_.mode)) {
+            // Each survivor's time clean (or hidden), in tenths of a second (the score: more wins).
+            for (auto &p : players_)
+                if (!p.out && !p.infected) {
+                    p.it_ms += now_ms - it_counted_;
+                    p.score = static_cast<std::int32_t>(std::min<std::uint64_t>(p.it_ms / 100, 0x7fffffff));
+                }
+            it_counted_ = now_ms;
+        }
+        if (settings_.mode == Mode::one_up && turn_ < players_.size() && now_ms >= turn_at_ + settings_.turn_s * 1000ull) {
+            strike(players_[turn_], now_ms, "ran out of time");
+            return true;
+        }
+        if (settings_.mode == Mode::skate && turn_ < players_.size() && now_ms >= turn_at_ + settings_.turn_s * 1000ull) {
+            if (set_trick_.empty() && turn_ == setter_) {
+                call(name_of(players_[turn_].id) + " ran out of time to set");
+                pass_set(now_ms);
+            } else {
+                letter(players_[turn_], "ran out of time");
+                next_copier(now_ms);
+            }
+            return true;
+        }
+        return false;
+    default: return false;
+    }
+}
+bool Referee::finished(std::uint64_t now_ms) const noexcept {
+    return phase_ == Phase::results && now_ms >= phase_at_ + results_ms;
+}
+Message Referee::state(std::uint64_t now_ms) const {
+    Message m;
+    m.kind = Message::Kind::state;
+    m.leader = leader_;
+    m.game = game_;
+    m.phase = phase_;
+    const auto elapsed = now_ms >= phase_at_ ? now_ms - phase_at_ : 0;
+    const auto left = [&](std::uint64_t total) { return static_cast<std::uint32_t>(total > elapsed ? total - elapsed : 0); };
+    switch (phase_) {
+    case Phase::countdown: m.remaining_ms = left(countdown_ms); break;
+    case Phase::playing:
+        if (settings_.mode == Mode::one_up || settings_.mode == Mode::skate) {
+            const auto turn_elapsed = now_ms >= turn_at_ ? now_ms - turn_at_ : 0;
+            const auto total = settings_.turn_s * 1000ull;
+            m.remaining_ms = static_cast<std::uint32_t>(total > turn_elapsed ? total - turn_elapsed : 0);
+        } else {
+            m.remaining_ms = left(settings_.duration_s * 1000ull);
+        }
+        break;
+    case Phase::results: m.remaining_ms = left(results_ms); break;
+    default: break;
+    }
+    if (settings_.mode == Mode::one_up && phase_ == Phase::playing && turn_ < players_.size()) m.turn = players_[turn_].id;
+    if (settings_.mode == Mode::tag && (phase_ == Phase::playing || phase_ == Phase::results)) m.turn = it_;
+    if (settings_.mode == Mode::skate && phase_ == Phase::playing && turn_ < players_.size()) {
+        m.turn = players_[turn_].id;
+        m.trick = set_trick_;
+        if (setter_ < players_.size()) m.setter = players_[setter_].id;
+    }
+    m.target = target_;
+    for (std::size_t i = 0; i < players_.size(); ++i) {
+        const auto &p = players_[i];
+        m.standings.push_back({p.id, p.score, p.aux, p.out, m.turn == p.id});
+        if(settings_.mode==Mode::race && phase_==Phase::playing && !p.out && !p.finished) {
+            m.standings.back().remaining_ms=left(settings_.duration_s*1000ull);
+            m.standings.back().aux=static_cast<std::int32_t>(std::min<std::uint64_t>(
+                now_ms>=play_at_?now_ms-play_at_:0,settings_.duration_s*1000ull));
+        }
+        // Infection: aux 1 and `up` for the infected (who wear the reaper), score the tenths survived.
+        if (settings_.mode == Mode::infection) {
+            m.standings.back().aux = p.infected ? 1 : 0;
+            m.standings.back().up = p.infected;
+        }
+        // Hide & Seek: `up` for the seekers, aux how many each found.
+        if (settings_.mode == Mode::hide) m.standings.back().up = p.infected;
+    }
+    // Hide & Seek: target is the hiding time left (ms), 0 once the seekers are out.
+    if (settings_.mode == Mode::hide && phase_ == Phase::playing)
+        m.target = static_cast<std::int32_t>(now_ms < hide_end() ? hide_end() - now_ms : 0);
+    const auto mode = settings_.mode;
+    std::stable_sort(m.standings.begin(), m.standings.end(), [mode, this, now_ms](const Standing &a, const Standing &b) {
+        if (mode == Mode::race) {
+            const auto *pa = find(a.player), *pb = find(b.player);
+            const bool fa = pa && pa->finished, fb = pb && pb->finished;
+            if (fa != fb) return fa;
+            if (fa) return a.aux < b.aux;
+            if(a.out!=b.out)return !a.out;
+            if(a.score!=b.score)return a.score>b.score;
+            // Racers with the same required gate are ordered by distance to it.
+            const auto next=static_cast<std::size_t>(std::max(0,a.score));
+            if(next<settings_.points.size()) {
+                const bool fresh_a=pa && pa->at_time && now_ms>=pa->at_time && now_ms-pa->at_time<=position_fresh_ms;
+                const bool fresh_b=pb && pb->at_time && now_ms>=pb->at_time && now_ms-pb->at_time<=position_fresh_ms;
+                if(fresh_a!=fresh_b)return fresh_a;
+                if(fresh_a && fresh_b)return horizontal_distance(pa->at,settings_.points[next])<horizontal_distance(pb->at,settings_.points[next]);
+            }
+            return false;
+        }
+        if (mode == Mode::tag) { // least time spent it first
+            if (a.out != b.out) return !a.out;
+            return a.score < b.score;
+        }
+        if (mode == Mode::infection) { // longest survived first; a survivor before the infected on a tie
+            if (a.score != b.score) return a.score > b.score;
+            return a.aux < b.aux;
+        }
+        if (mode == Mode::hide) { // longest hidden first; then most found
+            if (a.score != b.score) return a.score > b.score;
+            return a.aux > b.aux;
+        }
+        if (mode == Mode::one_up || mode == Mode::skate) {
+            if (a.out != b.out) return !a.out;
+            if (a.aux != b.aux) return a.aux < b.aux; // fewer strikes, or letters
+            return a.score > b.score;
+        }
+        if (a.score != b.score) return a.score > b.score;
+        return a.aux > b.aux;
+    });
+    for (const auto &o : owners_)
+        if (o.owner) m.zones.push_back(o);
+    m.calls = recent_;
+    m.call_serial = call_serial_;
+    return m;
+}
+std::vector<std::string> Referee::take_calls() { return std::exchange(calls_, {}); }
+void Referee::call(std::string text) {
+    if (text.size() > max_call_length) text.resize(max_call_length);
+    calls_.push_back(text);
+    recent_.push_back(std::move(text));
+    if (recent_.size() > max_calls) recent_.erase(recent_.begin());
+    ++call_serial_;
+}
+} // namespace dingosdk::modes
diff --git a/Extension/Modes/mode_rules.h b/Extension/Modes/mode_rules.h
new file mode 100644
index 0000000..0dacdb5
--- /dev/null
+++ b/Extension/Modes/mode_rules.h
@@ -0,0 +1,300 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Skate 3 style game modes for a ReSkate session: Spot Jam, 1-Up, Hall of Meat, Deathrace,
+// Domination, Graffiti and Skate Tag, played inside an area the player who starts the game marks out
+// (or the whole map).
+//
+// The player who starts a game is its leader and referees it: the settings, the clock and
+// the standings are theirs. Every player (the leader too) reports only their own lines,
+// bails and checkpoints; the leader applies them and sends the state everyone draws.
+// Messages ride the throwdown channel (relayed as-is by hosts and dedicated servers), told
+// apart by their first byte, so players without game modes drop them like any message
+// they cannot read and the session protocol stays the one everyone else speaks.
+//
+// Nothing here touches the game: plain rules and the wire format, unit-tested.
+namespace dingosdk::modes {
+using Vec3 = std::array<float, 3>;
+
+// infection: Skate Tag where the tagged stay infected and hunt too; whoever stays clean longest wins.
+// hide: Hide & Seek. The seeker is blind while everyone hides (turn_s seconds), then hunts; whoever
+// is found seeks too. Hiders score the time they stay hidden, seekers count who they find.
+enum class Mode : std::uint8_t { jam = 1, one_up = 2, meat = 3, race = 4, domination = 5, graffiti = 6, tag = 7, skate = 8, infection = 9, hide = 10 };
+inline constexpr Mode all_modes[]{Mode::jam,      Mode::one_up, Mode::meat,  Mode::race,     Mode::domination,
+                                  Mode::graffiti, Mode::tag,    Mode::skate, Mode::infection, Mode::hide};
+// Played on where everyone is (position events): Skate Tag, Infection and Hide & Seek.
+inline constexpr bool tag_like(Mode m) noexcept { return m == Mode::tag || m == Mode::infection || m == Mode::hide; }
+// The caught join the hunters: Infection and Hide & Seek.
+inline constexpr bool hunt_like(Mode m) noexcept { return m == Mode::infection || m == Mode::hide; }
+std::string_view mode_name(Mode) noexcept;    // "Spot Jam"
+std::string_view mode_key(Mode) noexcept;     // "jam": what `mode new` takes
+std::string_view mode_summary(Mode) noexcept; // one line on how it is played
+std::optional<Mode> parse_mode(std::string_view) noexcept;
+bool timed(Mode) noexcept; // ends when the clock runs out (1-Up ends on strikes instead)
+
+enum class Phase : std::uint8_t { setup = 1, countdown = 2, playing = 3, results = 4 };
+
+inline constexpr std::uint8_t wire_magic = 0xD5; // never a throwdown message's first byte (1..15)
+inline constexpr std::uint8_t wire_version = 16; // pitched checkpoint planes require matching referee/renderers
+inline constexpr std::size_t max_corners = 16, max_points = 16, max_players = 16, max_zones = 64, max_calls = 4,
+                             max_call_length = 96, max_tags = 64, max_tag_points = 6, max_line_tags = 6;
+inline constexpr std::uint32_t countdown_ms = 5000, results_ms = 12000;
+inline constexpr std::uint32_t race_deadline_ms = 120000, race_warning_ms = 30000;
+enum class RaceGateKind : std::uint8_t { mandatory, guiding, arrow };
+
+struct Settings {
+    Mode mode = Mode::jam;
+    std::uint32_t duration_s = 300; // timed modes
+    std::uint32_t turn_s = 30;      // 1-Up: how long each turn is
+    std::uint8_t strikes = 3;       // 1-Up: misses before a player is out
+    float radius = 6.0f;            // a checkpoint's or spot's reach (metres)
+    std::vector<Vec3> corners;      // the area, in order around it (x and z; y is the ground there)
+    float area_radius{};            // > 0: the area is a circle this wide around corners[0] instead
+    std::vector<Vec3> points;       // Deathrace checkpoints in order, Domination spots
+    std::vector<float> yaws;        // Deathrace: each gate's facing in degrees (empty: along the route)
+    std::vector<float> widths;      // Deathrace: each gate's half width in metres (empty: `radius`)
+    std::vector<RaceGateKind> gate_kinds; // empty: every gate mandatory; guides never block progress
+    std::vector<float> arrow_rolls;  // optional, aligned with points; decorative arrows' in-plane rotation
+    std::vector<float> gate_pitches; // optional, aligned with points; checkpoint or marker pitch
+    Vec3 spawn{};                   // where everyone starts when the countdown begins
+    bool has_spawn{};
+    bool race_finish{};             // final route point is the sole red finish, including during setup
+    std::uint8_t trick_kinds = 0x0f; // R.E.S.K.A.T.E.: the kinds of trick that may be set (trick_* bits)
+    bool operator==(const Settings &) const = default;
+};
+
+// R.E.S.K.A.T.E.: the setter lands a trick, everyone else copies it or takes a letter; a setter who misses
+// hands the set on. The tricks are skate.'s own names, as its score HUD lists them ("Kickflip",
+// "Heelflip + Seatbelt", "BS 50-50 Grind"); a trick set once cannot be set again. The leader picks the
+// kinds that may be set; a trick is of every kind any of its parts is, and may be set when any of them is allowed.
+inline constexpr std::uint8_t trick_flips = 1, trick_grabs = 2, trick_grinds = 4, trick_manuals = 8, all_trick_kinds = 0x0f;
+inline constexpr std::size_t max_trick_length = 80;
+std::uint8_t trick_kinds_of(std::string_view trick) noexcept;
+bool trick_allowed(const Settings &, std::string_view trick) noexcept;
+// How to do a trick, as skate.'s Skatepedia card shows it: its input steps in the game's own markup
+// ("[img {0}]FLICKIT_Kickflip_RS[/img]", the flick-it stick picture) for a regular or goofy stance.
+// Empty when the Skatepedia has no entry for it.
+std::string trick_steps(std::string_view trick, bool goofy);
+// Infer a completed custom trick zone from the shared settings; draft is local.
+bool reskate_custom_zone(const Settings &, bool draft = false) noexcept;
+// The trick as it is set: its parts without a plain ollie popped into the part that counts.
+std::string set_trick_name(std::string_view trick);
+// An attempt copies the set trick when it has the same parts in the same order (case aside); a plain
+// ollie into it does not matter, anything more or less does.
+bool copies_trick(std::string_view attempt, std::string_view set) noexcept;
+// R.E.S.K.A.T.E.: ReSkate's own letters game (Mode::skate), refereed here and not by skate.'s
+// S.K.A.T.E. throwdown. One letter per miss; spelling the whole word puts a player out.
+inline constexpr std::string_view reskate_word = "RESKATE";
+inline constexpr std::uint8_t max_strikes = static_cast<std::uint8_t>(reskate_word.size());
+// "R.E.S" for three letters of R.E.S.K.A.T.E.; the letters spell as many as `strikes` allows.
+std::string skate_letters(unsigned letters, unsigned of);
+// What is missing before `mode start` (empty: ready).
+std::string missing(const Settings &);
+
+// Inside the area seen from above. Without an area (fewer than three corners) everywhere is.
+bool inside(const std::vector<Vec3> &corners, const Vec3 &point) noexcept;
+// The same for a game's area, a circle (area_radius) or the corners' shape.
+bool inside(const Settings &, const Vec3 &point) noexcept;
+bool has_area(const Settings &) noexcept;
+// Where to put back a player who wandered out: the corners' average height, at their middle.
+Vec3 area_centre(const std::vector<Vec3> &corners) noexcept;
+inline constexpr float min_area_radius = 3.0f, max_area_radius = 1500.0f; // up to 3 km across (Skate Tag on a whole district)
+// Skate Tag: within this far (metres, the game's radius) the one who is it tags; the one just tagged
+// cannot tag back the one who tagged them for a while; a position older than this is not trusted.
+inline constexpr float default_tag_reach = 3.0f;
+inline constexpr std::uint64_t no_tag_back_ms = 3000, position_fresh_ms = 1500;
+// A Deathrace gate's half width: its own, or the game's checkpoint radius.
+inline constexpr float min_gate_half_width = 1.5f, max_gate_half_width = 40.0f;
+float gate_half_width(const Settings &, std::size_t gate) noexcept;
+bool guiding_gate(const Settings &, std::size_t gate) noexcept;
+bool arrow_marker(const Settings &, std::size_t gate) noexcept;
+std::size_t next_race_gate(const Settings &, std::size_t from) noexcept;
+std::size_t mandatory_gates(const Settings &, std::size_t before) noexcept;
+inline bool race_clock_visible(std::uint32_t remaining) noexcept { return remaining>0 && remaining<=race_warning_ms; }
+
+// Graffiti tags, the way THPS tags what you skate: a grind is the path the board slid along a
+// curb, ledge or rail; a gap is a drop of a metre or more from takeoff to landing (stair sets,
+// gaps). A tag on the same thing as an existing one is that tag again, so a bigger line steals it.
+enum class TagKind : std::uint8_t { grind = 1, gap = 2 };
+struct Tag {
+    TagKind kind = TagKind::grind;
+    std::vector<Vec3> path; // grind: along the object (2..max_tag_points); gap: takeoff, landing
+    bool operator==(const Tag &) const = default;
+};
+bool same_tag(const Tag &, const Tag &) noexcept;
+Vec3 tag_centre(const Tag &) noexcept;
+// At most `count` points spread evenly along a path, its ends kept.
+std::vector<Vec3> thin_path(const std::vector<Vec3> &path, std::size_t count = max_tag_points);
+inline constexpr float gap_drop = 0.9f; // metres a landing must be below its takeoff to tag a gap
+// The Domination spot a point is on (nearest within reach).
+std::optional<std::size_t> spot_at(const Settings &, const Vec3 &) noexcept;
+
+// Scoring, from what the Trainer measures of each jump. The game's own trick score is only
+// handed out inside its throwdowns, so ReSkate scores tricks itself: big air, big spins,
+// flips and fast board rotation all count, and a line multiplies its tricks' sum.
+struct JumpSample {
+    float air_time{}, height{}, distance{}, spin{}, flip{}, board_turn{};
+};
+std::int32_t trick_score(const JumpSample &) noexcept;
+std::int32_t line_score(std::int64_t sum, unsigned tricks) noexcept;
+struct BailSample {
+    float speed{};  // m/s over the ground when it began
+    float drop{};   // metres fallen while bailing
+    float tumble{}; // seconds spent wiped out
+};
+std::int32_t bail_score(const BailSample &) noexcept;
+
+// ---- wire
+// position: where the sender is (Skate Tag), sent a few times a second to every player.
+// trick: a R.E.S.K.A.T.E. attempt, `trick` its name and value 1 landed, 0 missed (a bail, or nothing landed).
+enum class Event : std::uint8_t { line = 1, bail = 2, checkpoint = 3, position = 4, trick = 5 };
+struct Standing {
+    std::uint64_t player{};
+    std::int32_t score{}, aux{}; // aux: best line or bail, finish time (ms), strikes; Skate Tag: score the
+                                 // tenths of a second spent it (fewer is better)
+    bool out{}, up{}; // setup: up means this joined player is ready; play: current turn
+    std::uint32_t remaining_ms{}; // Deathrace: shared deadline, zero for a finisher or DNF
+    bool operator==(const Standing &) const = default;
+};
+struct ZoneOwner {
+    std::uint8_t zone{};
+    std::uint64_t owner{};
+    std::int32_t best{};
+    bool operator==(const ZoneOwner &) const = default;
+};
+struct Message {
+    enum class Kind : std::uint8_t {
+        setup = 1, // leader: the game and its settings (sent again every few seconds for late arrivals)
+        state = 2, // leader: phase, clock, turn, standings, zones
+        event = 3, // a player: one of their own lines, bails or checkpoints
+        leave = 4, // a player: out of the game
+        end = 5,   // leader: the game is over or cancelled
+        join = 6,  // a player with game modes saw the setup and plays (only they are added)
+        tags = 7,  // leader: Graffiti tag shapes, from index `first` (state messages carry only their owners)
+        hello = 8, // anyone with game modes, every few seconds: who has them, and (by the version byte) which
+                   // (`leader` is the sender, `game` 1). A game of another version that cannot read it says so.
+        ready = 9  // a joined guest explicitly readied; idempotent, only accepted during setup
+    };
+    Kind kind = Kind::setup;
+    std::uint8_t version = wire_version;
+    std::uint64_t leader{};
+    std::uint32_t game{};
+    Settings settings;                         // setup
+    Phase phase = Phase::setup;                // state
+    std::uint32_t remaining_ms{};              // state: the countdown, clock or turn left
+    std::uint64_t turn{};                      // state: 1-Up's player up; Skate Tag's player who is it
+    std::int32_t target{};                     // state: 1-Up's score to beat
+    std::vector<Standing> standings;           // state, best first
+    std::vector<ZoneOwner> zones;              // state: held Domination spots or Graffiti tags (by index)
+    // state: the referee's latest callouts ("Sam stole a tag"), oldest first; the last one is
+    // number `call_serial`, so a player shows only those newer than the ones it has seen.
+    std::vector<std::string> calls;
+    std::uint32_t call_serial{};
+    Event event = Event::line;                 // event
+    std::int32_t value{}, extra{};             // event: score (line, bail) or checkpoint index; tricks in the line
+    Vec3 at{};                                 // event: where it happened
+    std::uint32_t sequence{};                  // event: the sender's own count (repeats are dropped)
+    std::vector<Tag> tags;                     // event: what a Graffiti line was skated on; tags: the shapes
+    std::uint8_t first{};                      // tags: the index of the first shape
+    std::string trick;                         // event: a R.E.S.K.A.T.E. attempt's trick; state: the trick to copy (empty: one to set)
+    std::uint64_t setter{};                    // state: R.E.S.K.A.T.E.'s setter
+    bool operator==(const Message &) const = default;
+};
+inline bool is_mode_message(std::span<const std::uint8_t> bytes) noexcept {
+    return !bytes.empty() && bytes[0] == wire_magic;
+}
+// Throws std::invalid_argument for a message that breaks the limits above.
+std::vector<std::uint8_t> encode(const Message &);
+// Nothing for bytes that are not a game mode message of this version.
+std::optional<Message> decode(std::span<const std::uint8_t>) noexcept;
+// The version a game mode message was written with (0: not one), for an "update" notice.
+std::uint8_t message_version(std::span<const std::uint8_t>) noexcept;
+
+// ---- the leader's referee
+class Referee {
+  public:
+    Referee(Settings settings, std::uint64_t leader, std::uint32_t game);
+    const Settings &settings() const noexcept { return settings_; }
+    Phase phase() const noexcept { return phase_; }
+    std::uint32_t game() const noexcept { return game_; }
+    // Players can be added until the countdown ends; 1-Up turns go in the order added.
+    void add_player(std::uint64_t player);
+    void remove_player(std::uint64_t player, std::uint64_t now_ms);
+    bool has_player(std::uint64_t player) const noexcept;
+    void start(std::uint64_t now_ms);
+    // The leader ends the game early: straight to the results, standings as they are.
+    void end_now(std::uint64_t now_ms) { if (phase_ == Phase::playing || phase_ == Phase::countdown) finish(now_ms); }
+    void event(std::uint64_t player, Event event, std::int32_t value, const Vec3 &at, std::uint32_t sequence,
+               std::uint64_t now_ms, const std::vector<Tag> &tags = {}, std::string_view trick = {});
+    const std::vector<Tag> &tags() const noexcept { return tags_; }
+    // Advances the clock; true when the state changed in a way worth sending at once.
+    bool tick(std::uint64_t now_ms);
+    bool finished(std::uint64_t now_ms) const noexcept; // results shown long enough
+    Message state(std::uint64_t now_ms) const;
+    // Short lines for everyone's HUD since the last call ("Sam took zone 4").
+    std::vector<std::string> take_calls();
+    // Names for the calls; unknown ids read "A player".
+    void set_name(std::uint64_t player, std::string name);
+
+  private:
+    struct Player {
+        std::uint64_t id{};
+        std::int32_t score{}, aux{};
+        std::uint8_t strikes{};
+        bool out{}, finished{};
+        std::uint32_t sequence{};
+        std::string name;
+        Vec3 at{};                // Skate Tag: where they last said they were
+        std::uint64_t at_time{};  // and when (0: never)
+        std::uint64_t it_ms{};    // Skate Tag: time spent it; Infection: time survived
+        bool infected{};          // Infection; Hide & Seek: seeking
+    };
+    Player *find(std::uint64_t id) noexcept;
+    const Player *find(std::uint64_t id) const noexcept;
+    std::string name_of(std::uint64_t id) const;
+    void begin_play(std::uint64_t now_ms);
+    void finish(std::uint64_t now_ms);
+    void strike(Player &, std::uint64_t now_ms, std::string_view why);
+    void next_turn(std::uint64_t now_ms);
+    std::size_t still_in() const noexcept;
+    // Skate Tag: player is it from now on.
+    void make_it(std::uint64_t player, std::uint64_t by, std::uint64_t now_ms);
+    void try_tags(std::uint64_t now_ms);
+    // Infection: every infected player within reach of a survivor infects them.
+    void try_infections(std::uint64_t now_ms);
+    std::size_t survivors() const noexcept;
+    // R.E.S.K.A.T.E.
+    void skate_attempt(Player &, bool landed, std::string_view trick, std::uint64_t now_ms);
+    void letter(Player &, std::string_view why);
+    void pass_set(std::uint64_t now_ms);    // the setter missed: the next player still in sets
+    void next_copier(std::uint64_t now_ms); // the next player to copy, or back to the setter
+    std::size_t setter_{};
+    std::string set_trick_;                 // the trick to copy; empty while the setter sets
+    std::vector<std::string> done_tricks_;  // set already this game
+
+    Settings settings_;
+    std::uint64_t leader_{};
+    std::uint32_t game_{};
+    Phase phase_ = Phase::setup;
+    std::uint64_t phase_at_{}, turn_at_{}, last_second_{};
+    std::vector<Player> players_;
+    std::size_t turn_{};
+    std::int32_t target_{};
+    std::uint64_t it_{}, tagged_by_{}, it_since_{}, it_counted_{}; // Skate Tag
+    bool released_{};               // Hide & Seek: the hiding time is over
+    std::uint64_t hide_end() const noexcept { return play_at_ + settings_.turn_s * 1000ull; }
+    std::uint64_t play_at_{};
+    std::vector<Tag> tags_;         // Graffiti
+    std::vector<ZoneOwner> owners_; // one per Domination spot or Graffiti tag (owner 0: unclaimed)
+    std::vector<std::string> calls_;   // not yet taken
+    std::vector<std::string> recent_;  // the last few, for the state message
+    std::uint32_t call_serial_{};
+    void call(std::string text);
+};
+} // namespace dingosdk::modes
diff --git a/Extension/Modes/mode_transport.h b/Extension/Modes/mode_transport.h
new file mode 100644
index 0000000..4027c1d
--- /dev/null
+++ b/Extension/Modes/mode_transport.h
@@ -0,0 +1,68 @@
+#pragma once
+#include "mode_rules.h"
+#include <algorithm>
+#include <map>
+#include <stdexcept>
+
+namespace dingosdk::modes {
+// Keep the session's 4096-byte packet contract. The editor has no gate cap;
+// only a defensive transfer budget bounds untrusted remote allocations.
+inline constexpr std::size_t mode_packet_bytes=4096, mode_fragment_header=27,
+    mode_fragment_bytes=mode_packet_bytes-mode_fragment_header, mode_transfer_bytes=64*1024*1024;
+inline std::uint32_t mode_transfer_hash(std::span<const std::uint8_t> bytes) noexcept {
+    std::uint32_t value=2166136261u;for(const auto byte:bytes)value=(value^byte)*16777619u;return value;
+}
+inline std::vector<std::vector<std::uint8_t>> transport_messages(const Message& m) {
+    auto bytes=encode(m);
+    if(bytes.size()<=mode_packet_bytes)return {std::move(bytes)};
+    if(m.kind!=Message::Kind::setup || bytes.size()>mode_transfer_bytes)throw std::invalid_argument("route transfer exceeds resource budget");
+    const auto hash=mode_transfer_hash(bytes);
+    std::vector<std::vector<std::uint8_t>> out;
+    for(std::size_t at=0;at<bytes.size();at+=mode_fragment_bytes) {
+        std::vector<std::uint8_t> packet(bytes.begin(),bytes.begin()+15);packet[2]=9;
+        const auto put=[&](std::uint32_t n){for(unsigned i=0;i<4;++i)packet.push_back(static_cast<std::uint8_t>(n>>(8*i)));};
+        put(hash);put(static_cast<std::uint32_t>(bytes.size()));put(static_cast<std::uint32_t>(at));
+        packet.insert(packet.end(),bytes.begin()+at,bytes.begin()+std::min(at+mode_fragment_bytes,bytes.size()));
+        out.push_back(std::move(packet));
+    }
+    return out;
+}
+inline bool mode_fragment(std::span<const std::uint8_t> bytes) noexcept {
+    return bytes.size()>=3 && bytes[0]==wire_magic && bytes[1]==wire_version && bytes[2]==9;
+}
+class ModeTransfers {
+    struct Pending {
+        std::uint32_t hash{},total{};std::uint64_t leader{},updated{};std::uint32_t game{};
+        std::map<std::uint32_t,std::vector<std::uint8_t>> chunks;std::size_t received{};
+    };
+    std::map<std::uint64_t,Pending> pending_;
+public:
+    void clear() {pending_.clear();}
+    std::optional<Message> receive(std::uint64_t sender,std::span<const std::uint8_t> bytes,std::uint64_t now) {
+        std::erase_if(pending_,[&](const auto& p){return now>=p.second.updated && now-p.second.updated>10000;});
+        if(!mode_fragment(bytes) || bytes.size()<mode_fragment_header || bytes.size()>mode_packet_bytes)return {};
+        const auto get=[&](std::size_t at,unsigned n){std::uint64_t value{};for(unsigned i=0;i<n;++i)value|=std::uint64_t(bytes[at+i])<<(8*i);return value;};
+        const auto leader=get(3,8);const auto game=static_cast<std::uint32_t>(get(11,4));
+        const auto hash=static_cast<std::uint32_t>(get(15,4)),total=static_cast<std::uint32_t>(get(19,4)),at=static_cast<std::uint32_t>(get(23,4));
+        const auto size=bytes.size()-mode_fragment_header;
+        if(!sender || leader!=sender || !game || total<=mode_packet_bytes || total>mode_transfer_bytes || at>=total ||
+           at%mode_fragment_bytes || size!=std::min<std::size_t>(mode_fragment_bytes,total-at))return {};
+        if(!pending_.contains(sender) && pending_.size()>=max_players)return {};
+        auto& p=pending_[sender];
+        if(p.hash!=hash || p.total!=total || p.leader!=leader || p.game!=game)p=Pending{hash,total,leader,now,game};
+        p.updated=now;
+        const auto part=bytes.subspan(mode_fragment_header);
+        auto [it,inserted]=p.chunks.try_emplace(at,part.begin(),part.end());
+        if(inserted)p.received+=size;
+        else if(!std::equal(part.begin(),part.end(),it->second.begin())) {pending_.erase(sender);return {};}
+        if(p.received!=total)return {};
+        std::vector<std::uint8_t> joined;joined.reserve(total);
+        for(const auto& [offset,data]:p.chunks)joined.insert(joined.end(),data.begin(),data.end());
+        pending_.erase(sender);
+        if(mode_transfer_hash(joined)!=hash)return {};
+        auto m=decode(joined);
+        if(!m || m->kind!=Message::Kind::setup || m->leader!=leader || m->game!=game)return {};
+        return m;
+    }
+};
+}
diff --git a/Extension/Modes/mode_view.h b/Extension/Modes/mode_view.h
new file mode 100644
index 0000000..79f0718
--- /dev/null
+++ b/Extension/Modes/mode_view.h
@@ -0,0 +1,209 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <string>
+#include <vector>
+namespace dingosdk::overlay {
+bool interface_open() noexcept;
+void hide_game_buttons(std::uint16_t buttons) noexcept;
+void hold_game_buttons(std::uint16_t held) noexcept;
+void pause_game_input(bool paused) noexcept;
+bool key_down(int virtual_key) noexcept;
+int take_mouse_wheel() noexcept;
+struct ModesHudRow {
+    std::string name, value;
+    std::uint32_t color{0xffffffffU}; // IM_COL32
+    bool self{}, up{}, out{};
+};
+// A Graffiti tag: the path a board slid along (a grind) or a gap's takeoff and landing, in the
+// colour of whoever holds it.
+struct ModesHudTag {
+    std::vector<std::array<float, 3>> path;
+    bool gap{};
+    std::uint32_t color{};
+};
+// Another player's game the local player is not in, shown like a throwdown drop: a banner over
+// its spot (the start gate, the area's centre or where it was set up) and a row in the menu.
+struct ModesHudOffer {
+    std::string mode, host, detail;  // "HALL OF MEAT", "Huntredbanzzz", "3 players - join now"
+    std::array<float, 3> at{};
+    bool has_at{};
+    bool open{};   // still taking players (setting up or counting down)
+    bool target{}; // the one the join button acts on now
+    bool own{};    // the local player's own game: its flag only, where the others will join
+    std::uint64_t id{}; // `mode join <id>`
+};
+// Skate Tag: a player where they last said they were. The one who is it wears a neon crown; arrows at
+// the screen's edge point to whoever matters off screen (it, or everyone else for the one who is).
+struct ModesHudPlayer {
+    std::string name;
+    std::array<float, 3> at{};
+    std::uint32_t color{}; // IM_COL32
+    bool it{}, self{};
+};
+// S.K.A.T.E.: one part of the trick to copy, with its flick-it stick path when it has one (x to the
+// left, y pulled back, the gate the unit circle, a regular stance), else what kind of trick it is.
+struct ModesHudTrickPart {
+    std::string name;                         // "Kickflip", "BS 50-50 Grind"
+    std::vector<std::array<float, 2>> path;   // empty: no flick (a grab, grind or manual)
+    std::string kind;                         // "GRAB", "GRIND", "MANUAL" when there is no path
+};
+struct ModesHud {
+    bool active{};        // in a game (the panel, the area and the rest); offers draw either way
+    std::string trick_title;                  // S.K.A.T.E.: "COPY THIS", over the trick's diagram
+    std::string trick_steps;                  // R.E.S.K.A.T.E.: how to do the trick to copy (Skatepedia markup)
+    std::vector<std::string> done_tricks;     // R.E.S.K.A.T.E.: set already this game, newest last
+    std::string callout;                      // R.E.S.K.A.T.E.: "TRICK SET!", "SMOKEY  R.E.S", "SMOKEY IS OUT"
+    std::uint64_t callout_serial{};           // changes with each new callout
+    std::vector<ModesHudTrickPart> trick_parts;
+    bool goofy{};                             // mirror the flicks for a goofy stance
+    std::vector<ModesHudPlayer> players; // Skate Tag and Infection, while they are played
+    bool infection{};                     // the players' `it` are the infected (the reapers), not one tagger
+    // Hide & Seek: `players` holds only the seekers (hiders are never shown); a blind seeker's screen
+    // is black with `blind` (the seconds left) on it; `heat` 0 (cold) .. 1 (right there) is how close
+    // the nearest hider is for a seeker, or the nearest seeker for a hider (< 0: no meter).
+    bool hide{};
+    std::string blind;
+    float heat = -1;
+    std::string heat_label;               // "FREEZING" .. "ON FIRE"
+    bool heat_seeking{};
+    std::vector<ModesHudOffer> offers;
+    std::string invite;   // "Huntredbanzzz is starting Hall of Meat", shown for a while after it appears
+    float invite_fade{};  // 0..1
+    bool can_join{};      // a join button press would join `target` now
+    std::string title;    // "Graffiti"
+    std::string clock;    // "2:31", the countdown's "3", or empty
+    std::string status;   // what to do now
+    std::string line;     // the local player's line in progress
+    std::string banner;   // the latest callout (big, for a moment)
+    std::uint64_t banner_serial{};
+    std::string warning;  // out of the area
+    // The results at the end: the winner, their score and colour, and how long until it closes.
+    bool results{};
+    std::string winner, winner_value;
+    std::uint32_t winner_color{0xffffffffU};
+    std::uint32_t closing_ms{};
+    std::vector<ModesHudRow> rows;
+    std::vector<std::array<float, 3>> corners; // the area, in order around it (a circle's centre when area_radius > 0)
+    float area_radius{};
+    bool placing{};                            // the area or points are being placed: drawn as a preview
+    bool aiming{}, aim_ok{};                   // placing from the free camera: a reticle; aim_ok when it finds ground
+    std::array<float, 3> cursor{};             // placing: where the next thing goes
+    std::string hint;                          // what to do while placing ("Skate to the centre.")
+    // The controls while placing, as button prompts: a D-pad direction ('U', 'D', 'L', 'R', or 0
+    // for none), the keyboard key and what it does.
+    struct Prompt {
+        char dpad{};
+        std::string key, label;
+    };
+    std::vector<Prompt> prompts;
+    std::array<float, 3> me{};                 // the local skater, for the walls fading in near them
+    bool have_me{};
+    std::vector<std::array<float, 3>> points;  // checkpoints or spots
+    std::vector<std::uint32_t> point_colors;   // one per point (0: plain)
+    int next_point{-1};                        // Deathrace: the local player's next checkpoint
+    bool route{};                              // the points are a Deathrace route: start, checkpoints, finish
+    std::vector<float> point_yaws;             // each gate's facing, degrees (the trainer's heading); empty: along the route
+    std::vector<float> point_widths;           // each gate's half width in metres; empty: `radius`
+    float radius{};
+    std::vector<ModesHudTag> tags;
+    std::array<float, 16> camera{}; // world matrix: right, up, back, position rows
+    float vertical_fov{};
+};
+using ModesHudFeed = ModesHud (*)();
+// The Bone Cam (Extension/Modes/bone_cam.h): during a big bail the screen goes X-ray and every
+// bone of the local skater is drawn between its real joints, the ones that took a hard hit in red,
+// with a Skate 2 style injury list. Inactive = nothing to draw.
+struct BoneCamBone {
+    std::uint8_t sprite{};         // modes::BoneSprite
+    std::array<float, 3> a{}, b{}; // world: the bone's first joint, and a point along it
+    std::uint8_t hurt{};           // 0 sound, 1 cracked, 2 broken
+};
+struct BoneCamInjury {
+    std::string bone, what; // "LEFT FEMUR", "FRACTURED"
+    bool severe{};
+};
+// What a slam leaves behind: marks on the ground where the body slid (a skid for the torso, thin
+// scrapes for hands, knees and head), and the hit itself.
+struct BoneCamMark {
+    std::vector<std::array<float, 3>> path; // world, along the ground
+    float alpha{};                          // 0..1, fading with age
+    bool skid{};
+};
+// The skater's pose for the 3D X-ray (bone_cam_3d.cpp), in world space. Sides are [0] right,
+// [1] left. `valid` once a pose has been read this bail.
+struct BoneCamPose {
+    using Point = std::array<float, 3>;
+    bool valid{};
+    std::vector<Point> spine; // the joints from the hips up to the head, in order
+    Point head{}, head_up{}; // the head joint and its up axis (unit)
+    std::array<Point, 2> clavicle{}, shoulder{}, elbow{}, wrist{}, fingers{}, hip{}, knee{}, ankle{}, toe{};
+    // Injuries by region (modes::BoneSprite order): 0 sound, 1 cracked, 2 broken.
+    std::vector<std::uint8_t> hurt;
+};
+struct BoneCam {
+    bool active{};         // the X-ray itself
+    BoneCamPose pose;
+    bool effects{};        // marks or a hit to draw (with or without the X-ray)
+    float fade{};          // 0..1: fades in when the bail starts, out at the end
+    std::vector<BoneCamMark> marks;
+    float hit{};                    // 0..1: the flash of an impact, fading fast
+    float daze{};                   // 0..1: a concussion's after-effects (kept faint), fading
+    std::array<float, 3> hit_at{};  // world: where it landed
+    bool preview{};        // the menu's preview: the injuries are examples
+    std::uint64_t serial{}; // one per bail
+    std::vector<BoneCamBone> bones;
+    std::vector<BoneCamInjury> injuries;
+    std::array<float, 3> left{}; // world: from the skater's right shoulder toward the left one (which way the art faces)
+    std::array<float, 16> camera{}; // world matrix: right, up, back, position rows
+    float vertical_fov{};
+};
+using BoneCamFeed = BoneCam (*)();
+// One row of the lobby leaderboard (Game Modes page), best first.
+struct ModesLeaderRow {
+    std::string name;
+    int points{}, wins{}, podiums{}, games{};
+    int streak{}, best_streak{}; // wins in a row: now, and the most this session
+    std::string best_mode;       // the mode they win most ("Skate Tag"), or empty without a win
+    bool you{};
+};
+// A finished game on the lobby leaderboard, newest first.
+struct ModesLeaderGame {
+    std::string mode, winner, second;
+    int players{};
+    std::uint32_t ago_s{};
+};
+// ModesHud's menu needs (the Game Modes page of the ReSkate menu): what the local player can do.
+struct ModesMenu {
+    bool in_game{}, leading{};
+    int phase{};                  // modes::Phase, 0 when no game
+    std::string mode;             // "graffiti"
+    std::size_t corners{}, points{}, players{};
+    std::uint32_t duration{}, turn{};
+    int strikes{};
+    float radius{};
+    std::string missing;          // what `mode start` still needs
+    std::string bone_cam;         // "meat", "on" or "off"
+    bool bone_cam_ringing = true; // a concussion's ringing is on (not muted)
+    // ReSkate's own Hall of Meat (Extension/HallOfMeat) runs on this game build: it replaces the Bone
+    // Cam, and `meat_every_bail` is its switch (on: every bail in free skate too).
+    bool official_meat{}, meat_every_bail{};
+    std::uint8_t trick_kinds{0x0f}; // S.K.A.T.E.: the kinds of trick that may be set (1 flips, 2 grabs, 4 grinds, 8 manuals)
+    bool spectate = true;           // S.K.A.T.E.: the camera follows whoever is up
+    bool goofy{};                   // S.K.A.T.E.: flick diagrams for a goofy stance
+    // The other players in the session: who has game modes (this version), who has another one
+    // and has to update, and how many have none (they cannot see or join a game).
+    bool in_session{};
+    std::vector<std::string> lobby_modded, lobby_outdated;
+    int lobby_without{};
+    // The lobby leaderboard: every game of two or more finished in this session.
+    std::vector<ModesLeaderRow> leaders;
+    std::vector<ModesLeaderGame> recent;
+    int lobby_games{};
+    std::string lobby_top_mode; // the most played mode
+    float area_radius{};          // > 0: the area is a circle
+    std::string placing;          // "circle", "corners", "points" while placing on the skater; else empty
+    std::vector<ModesHudOffer> offers; // other players' games, to join from the menu
+};
+using ModesMenuFeed = ModesMenu (*)();
+}
diff --git a/Extension/Modes/placement_camera.h b/Extension/Modes/placement_camera.h
new file mode 100644
index 0000000..4f8357e
--- /dev/null
+++ b/Extension/Modes/placement_camera.h
@@ -0,0 +1,34 @@
+#pragma once
+#include <cstdint>
+#include <optional>
+
+namespace dingosdk::modes {
+// A native camera request can be rejected while flag placement is closing.
+// Keep asking until the live camera acknowledges it, and drain a late enable
+// on exit. A camera already active before the editor remains the user's own.
+class PlacementCamera {
+public:
+    std::optional<bool> update(bool requested, bool active, std::uint64_t now) noexcept {
+        if (requested != requested_) {
+            requested_ = requested;
+            sent_.reset();
+            if (!requested && owned_) release_until_ = now + 1600;
+        }
+        if (requested && !owned_ && !active) owned_ = true;
+        if (!owned_) return {};
+        if (requested && active) return {};
+        if (!requested && !active && now >= release_until_) {
+            owned_ = false;
+            sent_.reset();
+            return {};
+        }
+        if (sent_ && now >= *sent_ && now - *sent_ < 400) return {};
+        sent_ = now;
+        return requested;
+    }
+private:
+    bool requested_{}, owned_{};
+    std::uint64_t release_until_{};
+    std::optional<std::uint64_t> sent_;
+};
+} // namespace dingosdk::modes
diff --git a/Extension/Modes/race_arrow_placement.h b/Extension/Modes/race_arrow_placement.h
new file mode 100644
index 0000000..e3c6dbf
--- /dev/null
+++ b/Extension/Modes/race_arrow_placement.h
@@ -0,0 +1,127 @@
+#pragma once
+#include "race_route.h"
+
+namespace dingosdk::modes {
+struct RaceArrowRay {bool available{},hit{};Vec3 at{};};
+struct RaceArrowSurface {bool contact{};Vec3 at{},normal{};};
+struct RaceArrowAim {bool valid{},align_surface{};Vec3 at{};RaceArrowSurface surface;};
+class RaceArrowFloorAlignment {
+    bool flat{};
+public:
+    void reset() noexcept {flat=false;}
+    bool update(bool floor_contact,float forward_y,bool manual) noexcept {
+        // Engage only on a direct floor hit while looking down at least 45
+        // degrees; release at 30 degrees. No distant/downward ground search.
+        flat=!manual && floor_contact && std::isfinite(forward_y) &&
+            forward_y<=(flat?-.5f:-.70710678f);
+        return flat;
+    }
+};
+inline Vec3 arrow_add(const Vec3& a,const Vec3& b,float scale=1.f) noexcept {
+    return {a[0]+b[0]*scale,a[1]+b[1]*scale,a[2]+b[2]*scale};
+}
+inline float arrow_dot(const Vec3& a,const Vec3& b) noexcept {return a[0]*b[0]+a[1]*b[1]+a[2]*b[2];}
+inline Vec3 arrow_unit(const Vec3& value) noexcept {
+    const float length=std::sqrt(arrow_dot(value,value));
+    return length>.0001f?Vec3{value[0]/length,value[1]/length,value[2]/length}:Vec3{};
+}
+inline Vec3 arrow_cross(const Vec3& a,const Vec3& b) noexcept {
+    return {a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]};
+}
+// Query the same verified collision API as gate placement. A clear ray keeps
+// free-air placement; a hit keeps the marker on the visible side of a surface.
+// A direct hit mounts to that visible surface. A clear ray stays in the air;
+// there is no downward ground search or attraction to another arrow's surface.
+// Nearby parallel samples recover its plane without assuming a native normal ABI.
+template<class Cast> RaceArrowAim aim_race_arrow(const Vec3& origin,const Vec3& forward,
+        const Vec3& right,const Vec3& up,Cast&& cast) {
+    RaceArrowAim result;result.at=arrow_add(origin,forward,12.f);
+    const auto hit=cast(origin,forward,12.f);
+    if(!hit.available)return result;
+    result.valid=true;if(!hit.hit)return result;
+    result.align_surface=true;
+    result.at=hit.at;
+    std::array<Vec3,4> nearby{};std::array<bool,4> valid{};
+    for(unsigned i=0;i<4;++i) {
+        const auto sample=cast(arrow_add(origin,i<2?right:up,i%2?.08f:-.08f),forward,14.f);
+        nearby[i]=arrow_add(sample.at,hit.at,-1.f);
+        valid[i]=sample.available && sample.hit && arrow_dot(nearby[i],nearby[i])<4.f;
+    }
+    for(unsigned i=0;i<2;++i)for(unsigned j=2;j<4;++j)if(valid[i] && valid[j]) {
+        auto normal=arrow_unit(arrow_cross(nearby[i],nearby[j]));
+        if(arrow_dot(normal,normal)<.9f || std::abs(arrow_dot(normal,forward))<.02f)continue;
+        if(arrow_dot(normal,forward)>0)for(auto& component:normal)component=-component;
+        result.surface={true,hit.at,normal};return result;
+    }
+    // At a thin edge there may be no reliable mounting plane. Refuse this
+    // position rather than pretending the ray missed and placing behind it.
+    result.valid=false;return result;
+}
+inline std::array<float,2> race_arrow_surface_angles(const Vec3& normal) noexcept {
+    return {std::atan2(normal[0],normal[2])*180.f/3.14159265f,
+        -std::asin(std::clamp(normal[1],-1.f,1.f))*180.f/3.14159265f};
+}
+inline Vec3 clear_race_arrow_surface(Vec3 at,float yaw,float pitch,float roll,float width,
+        const RaceArrowSurface& surface) noexcept {
+    if(!surface.contact)return at;
+    const auto pose=race_arrow_transform({},yaw,roll,width,pitch);
+    const Vec3 right{pose[0],pose[1],pose[2]},up{pose[4],pose[5],pose[6]};
+    // Both native chevron meshes are XY quads with authored bounds +/-0.5.
+    // Account for the full rotated footprint, plus 4 cm to avoid z-fighting.
+    const float support=.5f*(std::abs(arrow_dot(right,surface.normal))+std::abs(arrow_dot(up,surface.normal)))+.04f;
+    const float distance=arrow_dot(arrow_add(at,surface.at,-1.f),surface.normal);
+    return arrow_add(at,surface.normal,std::max(0.f,support-distance));
+}
+struct RaceArrowGroundClearance {Vec3 at{};bool available=true;};
+// A center aim can miss the road while the bottom of an upright/tilted quad
+// intersects it. Probe the footprint from above, where one-sided road meshes
+// can be hit. Only lift an intersecting footprint; never pull free air down.
+template<class Cast>
+#ifdef _MSC_VER
+[[msvc::noinline]]
+#endif
+RaceArrowGroundClearance clear_race_arrow_ground(Vec3 at,float yaw,float pitch,
+        float roll,float width,Cast&& cast) {
+    const auto pose=race_arrow_transform(at,yaw,roll,width,pitch);
+    const float top=at[1]+.5f*(std::abs(pose[1])+std::abs(pose[5]))+.25f;
+    float lift{};bool available=true;
+    for(int x=-1;x<=1;++x)for(int y=-1;y<=1;++y) {
+        Vec3 point{};for(unsigned axis=0;axis<3;++axis)
+            point[axis]=at[axis]+float(x)*.5f*pose[axis]+float(y)*.5f*pose[4+axis];
+        const auto hit=cast(Vec3{point[0],top,point[2]},Vec3{0,-1,0},top-point[1]+.04f);
+        available=available && hit.available;
+        if(hit.available && hit.hit)lift=std::max(lift,hit.at[1]+.04f-point[1]);
+    }
+    at[1]+=lift;return {at,available};
+}
+template<class Cast> bool race_arrow_clear(const Vec3& origin,const Vec3& at,float yaw,float pitch,
+        float roll,float width,Cast&& cast) {
+    const auto pose=race_arrow_transform(at,yaw,roll,width,pitch);
+    const auto clear_segment=[&](const Vec3& from,const Vec3& to) {
+        const auto delta=arrow_add(to,from,-1.f);const float length=std::sqrt(arrow_dot(delta,delta));
+        if(!(length>.1f && length<500.f))return false;
+        const auto direction=arrow_unit(delta);const auto hit=cast(from,direction,length);
+        if(!hit.available)return false;
+        return !hit.hit || arrow_dot(arrow_add(hit.at,from,-1.f),direction)>=length-.015f;
+    };
+    // The center cannot be placed behind the aimed obstruction. Test actual
+    // segments on the quad, rather than camera visibility rays to its corners:
+    // a foreground curb/tree must not invalidate an otherwise clear arrow.
+    if(!clear_segment(origin,at))return false;
+    const auto point=[&](float x,float y) {
+        Vec3 result{};for(unsigned axis=0;axis<3;++axis)result[axis]=at[axis]+x*pose[axis]+y*pose[4+axis];
+        return result;
+    };
+    for(int line=-1;line<=1;++line) {
+        const float offset=.5f*float(line);
+        if(!clear_segment(point(-.5f,offset),point(.5f,offset)) ||
+           !clear_segment(point(offset,-.5f),point(offset,.5f)))return false;
+    }
+    if(!clear_segment(point(-.5f,-.5f),point(.5f,.5f)) ||
+       !clear_segment(point(-.5f,.5f),point(.5f,-.5f)))return false;
+    return true;
+}
+inline bool race_arrow_preview_visible(bool ready,bool rotating,bool angles_ready) noexcept {
+    return ready || (rotating && angles_ready);
+}
+} // namespace dingosdk::modes
diff --git a/Extension/Modes/race_asset_contract.h b/Extension/Modes/race_asset_contract.h
new file mode 100644
index 0000000..8693a21
--- /dev/null
+++ b/Extension/Modes/race_asset_contract.h
@@ -0,0 +1,43 @@
+#pragma once
+#include "Engine/Game/Build/addresses.h"
+#include "Engine/Game/Build/20260929/race_objects.h"
+#include <cstdint>
+#include <limits>
+
+namespace dingosdk::modes::race_world::detail {
+class CheckpointWorldLifetime {
+    bool blocked_=true,shutdown_{};
+    std::uint32_t retired_game_{};
+public:
+    bool blocked() const noexcept {return blocked_;}
+    bool can_publish(std::uint32_t game) const noexcept {return !blocked_ && game && game!=retired_game_;}
+    bool before_transition(unsigned next,std::uint32_t current_game) noexcept {
+        if(next==13 || next==21) {if(!shutdown_)blocked_=false;return false;}
+        if(next!=14 && next!=22 && next!=3 && next!=24)return false;
+        const bool release=!blocked_;blocked_=true;
+        if(current_game)retired_game_=current_game;
+        if(next==24)shutdown_=true;
+        return release;
+    }
+};
+template<class ReadPointer>
+bool checkpoint_blueprint(std::uintptr_t asset, std::uintptr_t base, ReadPointer read) {
+    constexpr auto maximum = std::numeric_limits<std::uintptr_t>::max();
+    if (!asset || asset > maximum - 8 || !base ||
+        base > maximum - addr::race_objects::object_blueprint_type) return false;
+    auto type = read(asset + 8);
+    for (unsigned depth = 0; type && depth < 16; ++depth) {
+        if (type == base + addr::race_objects::object_blueprint_type) return true;
+        if (type > maximum - 0x20) return false;
+        type = read(type + 0x20);
+    }
+    return false;
+}
+template<class ReadPointer>
+bool checkpoint_resident(std::uintptr_t cached, std::uintptr_t resolved,
+    std::uintptr_t base, ReadPointer read) {
+    // A world can stream out/reload a bundle without changing the client
+    // context. Readable old allocation bytes alone do not prove residency.
+    return cached && resolved == cached && checkpoint_blueprint(resolved,base,read);
+}
+}
diff --git a/Extension/Modes/race_editor.h b/Extension/Modes/race_editor.h
new file mode 100644
index 0000000..798d567
--- /dev/null
+++ b/Extension/Modes/race_editor.h
@@ -0,0 +1,287 @@
+#pragma once
+#include "race_route.h"
+#include <vector>
+#include <limits>
+
+namespace dingosdk::modes {
+class RaceEditorInputRelease {
+    bool waiting{};
+public:
+    void arm() noexcept {waiting=true;}
+    bool blocked(unsigned buttons,bool keyboard,bool menu_open=false) noexcept {
+        if(menu_open){arm();return true;}
+        if(!waiting)return false;
+        if(!buttons && !keyboard)waiting=false;
+        return true; // Consume the release frame too; it belongs to the menu.
+    }
+};
+inline std::string_view race_placement_label(unsigned object) noexcept {
+    constexpr std::array<std::string_view,5> names{"START FLAG","REQUIRED GATE","FINISH GATE","GUIDE GATE","ARROW"};
+    return object<names.size()?names[object]:"REQUIRED GATE";
+}
+// User-facing names stay separate from persisted object identifiers.
+inline std::string_view race_editor_object_name(unsigned object) noexcept {
+    constexpr std::array<std::string_view,5> names{"Start flag","Required gate","Finish gate","Guide gate","Arrow"};
+    return object<names.size()?names[object]:"Required gate";
+}
+inline bool race_default_roll_axis(unsigned object) noexcept {return object==4;}
+// Build-only markers use the mandatory sequence, excluding decorative arrows
+// and guide gates. Their world position follows the tilted gate's highest edge.
+inline std::string race_editor_gate_number(const Settings& route,std::size_t i) {
+    if(!i || i>=route.points.size() || arrow_marker(route,i))return {};
+    if(guiding_gate(route,i))return "GUIDE";
+    return std::string(route.race_finish && i+1==route.points.size()?"FINISH ":"GATE ")+std::to_string(mandatory_gates(route,i)+1);
+}
+inline Vec3 race_editor_gate_number_position(const Settings& route,std::size_t i) noexcept {
+    auto point=route.points[i];const auto from=route.points[i?i-1:i];
+    const float yaw=i<route.yaws.size()?route.yaws[i]:std::atan2(point[0]-from[0],point[2]-from[2])*180.f/3.14159265f;
+    const auto axes=race_gate_axes(yaw,race_gate_pitch(route,i));
+    const float half=gate_half_width(route,i),scale=half/6.f;
+    for(unsigned axis=0;axis<3;++axis)point[axis]+=axes.up[axis]*1.70747f*scale;
+    point[1]+=half+.7f;return point;
+}
+inline float race_object_label_alpha(std::uint64_t now,std::uint64_t changed) noexcept {
+    if(!changed || now<changed)return 0.f;
+    const auto age=now-changed;
+    if(age<180)return static_cast<float>(age)/180.f;
+    if(age<2000)return 1.f;
+    return age<2300?static_cast<float>(2300-age)/300.f:0.f;
+}
+struct RaceEditorDirections { int yaw{},tilt{},size{};bool undo{},redo{}; };
+inline RaceEditorDirections race_editor_directions(bool rotating,unsigned step) noexcept {
+    const int horizontal=int(bool(step&2))-int(bool(step&1));
+    const int vertical=int(bool(step&8))-int(bool(step&4));
+    return rotating?RaceEditorDirections{horizontal,vertical,0,false,false}:
+        RaceEditorDirections{0,0,vertical,horizontal<0,horizontal>0};
+}
+struct RaceRotationOrigin {
+    float yaw{},pitch{},roll{};
+    bool captured{};
+    void clear() noexcept {captured=false;}
+    // Keep the first straight pose across repeated visits to Rotate.
+    void capture(float y,float p,float r) noexcept {if(!captured){yaw=y;pitch=p;roll=r;captured=true;}}
+    void update_aim(float camera_yaw,float camera_pitch,float& y,float& p,bool automatic_tilt=false) const noexcept {
+        if(!captured)y=camera_yaw;
+        if(!captured || automatic_tilt)p=camera_pitch;
+    }
+    void restore(float& y,float& p,float& r) const noexcept {y=yaw;p=pitch;r=roll;}
+};
+inline float race_rotation_degrees(float value) noexcept {
+    if(!std::isfinite(value))return 0.f;
+    const float angle=std::remainder(value,360.f);
+    return std::abs(angle)<.05f?0.f:angle; // Avoid -0.0 in the readout.
+}
+class RaceRouteHistory {
+    std::vector<Settings> past,future;
+    static void restore_shape(Settings& route,Settings previous) {
+        // Undo edits the route, not current timer/rules/area settings.
+        route.points=std::move(previous.points);route.yaws=std::move(previous.yaws);
+        route.widths=std::move(previous.widths);route.gate_kinds=std::move(previous.gate_kinds);
+        route.arrow_rolls=std::move(previous.arrow_rolls);route.gate_pitches=std::move(previous.gate_pitches);
+        route.race_finish=previous.race_finish;route.has_spawn=previous.has_spawn;route.spawn=previous.spawn;
+    }
+public:
+    void reset(){past.clear();future.clear();}
+    void changed(const Settings& before,const Settings& after) {
+        if(before==after)return;
+        if(past.size()==64)past.erase(past.begin());
+        past.push_back(before);future.clear();
+    }
+    // Saved routes may outlive their editor/game. Rebuild a useful history
+    // only when this session has no more precise placement history to retain.
+    void resume(const Settings& route) {
+        if(!past.empty() || !future.empty() || route.points.size()<2)return;
+        for(std::size_t count=1;count<route.points.size();++count) {
+            auto prefix=route;prefix.points.resize(count);prefix.yaws.resize(count);prefix.widths.resize(count);
+            if(!prefix.gate_kinds.empty())prefix.gate_kinds.resize(count);
+            if(!prefix.arrow_rolls.empty())prefix.arrow_rolls.resize(count);
+            if(!prefix.gate_pitches.empty())prefix.gate_pitches.resize(count);
+            prefix.race_finish=false;past.push_back(std::move(prefix));
+            if(past.size()>64)past.erase(past.begin());
+        }
+    }
+    // Reopening uses a newly placed native flag. History must never move
+    // its logical spawn back to a previous flag that no longer exists.
+    void rebase_start(const Settings& route) {
+        if(route.mode!=Mode::race || route.points.empty() || route.yaws.empty() || route.widths.empty())return;
+        const auto update=[&](Settings& entry) {
+            bool finish=entry.race_finish;
+            (void)edit_race_route(entry,finish,RaceObject::start,route.points.front(),route.yaws.front(),route.widths.front());
+        };
+        for(auto& entry:past)update(entry);
+        for(auto& entry:future)update(entry);
+    }
+    bool undo(Settings& route,bool& finish) {
+        if(past.empty())return false;
+        future.push_back(route);restore_shape(route,std::move(past.back()));past.pop_back();finish=route.race_finish;return true;
+    }
+    bool redo(Settings& route,bool& finish) {
+        if(future.empty())return false;
+        past.push_back(route);restore_shape(route,std::move(future.back()));future.pop_back();finish=route.race_finish;return true;
+    }
+};
+inline float tilt_race_gate(float pitch,int direction,bool snap,float degrees) noexcept {
+    return std::clamp(rotate_race_gate(pitch,direction,snap,degrees),-90.f,90.f);
+}
+inline constexpr float default_race_editor_width=7.5f;
+inline constexpr unsigned default_race_editor_snap_angle=4;
+inline float race_camera_yaw(float camera,float offset,bool arrow) noexcept {
+    return std::remainder(camera+offset+(arrow?180.f:0.f),360.f);
+}
+inline float race_camera_pitch(float camera,float offset,bool arrow,bool surface=false) noexcept {
+    // Looking across open air keeps a vertical sign. A real surface hit still
+    // supplies the floor/wall tilt, and X retains an explicit manual offset.
+    return std::clamp((arrow && surface?camera:0.f)+offset,-90.f,90.f);
+}
+inline Vec3 snap_race_arrow_height(const Settings& settings,Vec3 at,bool enabled,bool& snapped) noexcept {
+    snapped=false;if(!enabled)return at;
+    float nearest=std::numeric_limits<float>::max();const float original_height=at[1];
+    for(std::size_t i=1;i<settings.points.size();++i)if(arrow_marker(settings,i)) {
+        const auto& other=settings.points[i];const float dx=at[0]-other[0],dz=at[2]-other[2],distance=dx*dx+dz*dz;
+        const float reach=std::max(24.f,gate_half_width(settings,i)*4.f),height_reach=1.f;
+        if(distance<=reach*reach && distance<=nearest && std::abs(original_height-other[1])<=height_reach) {
+            nearest=distance;at[1]=other[1];snapped=true;
+        }
+    }
+    return at;
+}
+// Capture a row on the previous marker's authored axes, never the noisy
+// segment between two placements. Lock its whole pose so camera movement
+// cannot give consecutive upright arrows different headings or tilts.
+struct RaceArrowSnapPose {Vec3 at{};float yaw{},pitch{},roll{};};
+inline float race_arrow_snap_angle(float angle,float step) noexcept {
+    return step>0.f?std::remainder(std::round(angle/step)*step,360.f):angle;
+}
+inline RaceArrowSnapPose snap_race_arrow_angles(RaceArrowSnapPose pose,bool enabled,float step) noexcept {
+    if(enabled){pose.yaw=race_arrow_snap_angle(pose.yaw,step);pose.pitch=std::clamp(race_arrow_snap_angle(pose.pitch,step),-90.f,90.f);pose.roll=race_arrow_snap_angle(pose.roll,step);}
+    return pose;
+}
+class RaceArrowLineSnap {
+    bool locked{},upright_locked{};Vec3 anchor{},direction{};float yaw{},pitch{},roll{};
+    Vec3 last_raw{},input_bias{};bool raw_valid{};std::size_t upright_count{};
+    std::optional<std::size_t> rotation_count;
+    static float dot(const Vec3& a,const Vec3& b){return a[0]*b[0]+a[1]*b[1]+a[2]*b[2];}
+    static Vec3 sub(const Vec3& a,const Vec3& b){return {a[0]-b[0],a[1]-b[1],a[2]-b[2]};}
+public:
+    void reset() noexcept {locked=false;upright_locked=false;raw_valid=false;input_bias={};upright_count=0;rotation_count.reset();}
+    void begin_rotation(std::size_t count) noexcept {reset();rotation_count=count;}
+    // Keep the projection routine out of the large input handler's optimizer
+    // graph. The routine itself still receives normal Release optimization.
+#ifdef _MSC_VER
+    [[msvc::noinline]]
+#endif
+    RaceArrowSnapPose update(const Settings& route,RaceArrowSnapPose pose,bool enabled,float step,bool& snapped,bool upright=false) noexcept {
+        snapped=false;if(!enabled){reset();return pose;}
+        pose=snap_race_arrow_angles(pose,true,step);
+        // An explicit X rotation starts a new row; do not pull its preview
+        // back to the previous row before the first new marker is placed.
+        if(rotation_count) {
+            if(*rotation_count==route.points.size())return pose;
+            rotation_count.reset();
+        }
+        if(upright && std::abs(pose.pitch)<.001f && std::abs(pose.roll)<.001f) {
+            std::optional<std::size_t> recent;
+            float nearest=24.f*24.f;
+            for(std::size_t i=route.points.size();i>1;) {
+                --i;if(!arrow_marker(route,i))continue;
+                const float old_roll=i<route.arrow_rolls.size()?route.arrow_rolls[i]:0.f;
+                const auto delta=sub(pose.at,route.points[i]);const float distance=dot(delta,delta);
+                if(std::abs(race_gate_pitch(route,i))<.001f && std::abs(old_roll)<.001f && distance<nearest){recent=i;nearest=distance;}
+            }
+            if(!recent){reset();return pose;}
+            const auto i=*recent;const auto next=route.points[i];const auto delta=sub(pose.at,next);
+            const float old_yaw=i<route.yaws.size()?route.yaws[i]:0.f;
+            if(upright_locked && yaw==old_yaw && route.points.size()>=upright_count) {
+                const auto shift=sub(next,anchor);const float along=dot(shift,direction);
+                const Vec3 off{shift[0]-direction[0]*along,shift[1]-direction[1]*along,shift[2]-direction[2]*along};
+                if(dot(off,off)<.0001f) {
+                    if(dot(shift,shift)>.0001f) {
+                        // Rebase aim drift only onto a newly appended arrow.
+                        // An older collinear reference must not move the aim.
+                        const bool appended=route.points.size()>upright_count &&
+                            i>=upright_count-(route.race_finish?1u:0u);
+                        if(appended && raw_valid)input_bias=sub(last_raw,next);
+                        else reset();
+                    }
+                    anchor=next;
+                } else reset();
+            } else reset();
+            const auto intent=sub(delta,input_bias);
+            const auto basis=race_arrow_transform({},old_yaw,0,1.5f,0);
+            const std::array<Vec3,3> axes{{{basis[0],0,basis[2]},{0,1,0},{basis[8],0,basis[10]}}};
+            Vec3 best=axes[2];float strongest=std::abs(dot(intent,best));
+            for(const auto& axis:axes)if(const float amount=std::abs(dot(intent,axis));amount>strongest){best=axis;strongest=amount;}
+            // Keep small hand/camera drift on the current rail, but a clear
+            // movement toward any of the other two axes switches immediately.
+            if(!upright_locked || strongest>std::abs(dot(intent,direction))*1.4f+1.f)direction=best;
+            anchor=next;yaw=old_yaw;pitch=roll=0;
+            const float along=dot(intent,direction);Vec3 projected{};
+            for(unsigned axis=0;axis<3;++axis)projected[axis]=next[axis]+direction[axis]*along;
+            // A narrow rail can be escaped without toggling Snap. Re-evaluate
+            // every arrow on the next update, including an older nearby row.
+            const auto error=sub(projected,pose.at);
+            if(dot(error,error)>9.f){reset();return pose;}
+            locked=upright_locked=locked || strongest>=1.f;
+            last_raw=pose.at;raw_valid=true;upright_count=route.points.size();snapped=true;
+            return {projected,yaw,0,0};
+        }
+        if(upright_locked){locked=false;upright_locked=false;}
+        std::optional<std::size_t> recent;
+        float nearest=24.f*24.f;
+        for(std::size_t i=route.points.size();i>1;) {
+            --i;if(!arrow_marker(route,i))continue;
+            const float old_yaw=i<route.yaws.size()?route.yaws[i]:0.f;
+            const float old_roll=i<route.arrow_rolls.size()?route.arrow_rolls[i]:0.f;
+            const auto prior=snap_race_arrow_angles({route.points[i],old_yaw,race_gate_pitch(route,i),old_roll},true,step);
+            if(std::abs(prior.pitch-pose.pitch)>35.f || std::abs(std::remainder(prior.roll-pose.roll,360.f))>35.f)continue;
+            const auto delta=sub(pose.at,route.points[i]);const float distance=dot(delta,delta);
+            if(distance<nearest){recent=i;nearest=distance;}
+        }
+        if(!recent){reset();return pose;}
+        const auto i=*recent;const auto next_anchor=route.points[i];const auto delta=sub(pose.at,next_anchor);
+        const auto prior=snap_race_arrow_angles({next_anchor,i<route.yaws.size()?route.yaws[i]:0.f,
+            race_gate_pitch(route,i),i<route.arrow_rolls.size()?route.arrow_rolls[i]:0.f},true,step);
+        const auto project=[&](const Vec3& axis) {
+            const float along=dot(delta,axis);Vec3 point{};
+            for(unsigned c=0;c<3;++c)point[c]=next_anchor[c]+axis[c]*along;
+            return point;
+        };
+        const auto error=[&](const Vec3& point){const auto d=sub(pose.at,point);return dot(d,d);};
+        const auto aligned=[&](Vec3 at){snapped=true;return RaceArrowSnapPose{at,yaw,pitch,roll};};
+        if(locked && yaw==prior.yaw && pitch==prior.pitch && roll==prior.roll) {
+            // Re-anchor to a newly placed marker only if it remains on the
+            // same axis. Undo/Redo and a genuinely new row cannot retain it.
+            const auto shift=sub(next_anchor,anchor);const float along=dot(shift,direction);
+            const auto off=Vec3{shift[0]-direction[0]*along,shift[1]-direction[1]*along,shift[2]-direction[2]*along};
+            if(dot(off,off)<.0001f && error(project(direction))<=9.f){anchor=next_anchor;return aligned(project(direction));}
+        }
+        reset();float best=9.f;Vec3 selected{};bool found{};
+        const auto basis=race_arrow_transform({},prior.yaw,prior.roll,1.5f,prior.pitch);
+        for(unsigned start:{0u,4u,8u}) {
+            Vec3 axis{basis[start],basis[start+1],basis[start+2]};
+            const auto point=project(axis);const float distance=error(point);
+            if(distance<=best){best=distance;selected=axis;found=true;}
+        }
+        if(!found)return pose;
+        anchor=next_anchor;direction=selected;yaw=prior.yaw;pitch=prior.pitch;roll=prior.roll;locked=true;
+        return aligned(project(direction));
+    }
+};
+struct RaceRotationPose {Vec3 at{};float yaw{},pitch{},width=7.5f,roll{};};
+class RaceRotationVisual {
+    RaceRotationPose current;std::uint64_t previous{};bool initialized{};
+public:
+    void reset() noexcept {initialized=false;previous=0;}
+    RaceRotationPose update(RaceRotationPose target,std::uint64_t now) noexcept {
+        if(!initialized || now<previous || now-previous>250) {current=target;initialized=true;previous=now;return current;}
+        const float dt=float(now-previous)/1000.f;previous=now;
+        const float blend=1.f-std::exp(-dt/.045f);
+        for(unsigned axis=0;axis<3;++axis)current.at[axis]+=(target.at[axis]-current.at[axis])*blend;
+        current.yaw=std::remainder(current.yaw+std::remainder(target.yaw-current.yaw,360.f)*blend,360.f);
+        current.pitch+=(target.pitch-current.pitch)*blend;current.width+=(target.width-current.width)*blend;
+        current.roll=std::remainder(current.roll+std::remainder(target.roll-current.roll,360.f)*blend,360.f);
+        return current;
+    }
+};
+
+}
diff --git a/Extension/Modes/race_group_reconciliation.h b/Extension/Modes/race_group_reconciliation.h
new file mode 100644
index 0000000..496c28a
--- /dev/null
+++ b/Extension/Modes/race_group_reconciliation.h
@@ -0,0 +1,26 @@
+#pragma once
+#include <set>
+#include <span>
+#include <utility>
+
+namespace dingosdk::modes::race_world::detail {
+// Each native tutorial checkpoint owns four mesh entities. A Destroy callback
+// can run inside creation, so incomplete groups must also drive reconciliation.
+inline std::set<unsigned> pending_checkpoint_groups(const std::set<unsigned>& dirty,
+                                                    std::span<const unsigned> live_parts,
+                                                    std::span<const unsigned> expected_parts={}) {
+    auto pending=dirty;
+    for(unsigned i=0;i<live_parts.size();++i)
+        if(live_parts[i]!=(i<expected_parts.size()?expected_parts[i]:4))pending.insert(i);
+    return pending;
+}
+inline std::set<unsigned> take_checkpoint_groups(std::set<unsigned>& dirty,
+                                                std::span<const unsigned> live_parts,
+                                                std::span<const unsigned> expected_parts={}) {
+    // Consume only the marks that precede this rebuild. Callbacks raised by
+    // the rebuild remain in dirty for the next tick, even for the same group.
+    std::set<unsigned> taken;
+    taken.swap(dirty);
+    return pending_checkpoint_groups(taken,live_parts,expected_parts);
+}
+}
diff --git a/Extension/Modes/race_momentum.h b/Extension/Modes/race_momentum.h
new file mode 100644
index 0000000..8e4af2c
--- /dev/null
+++ b/Extension/Modes/race_momentum.h
@@ -0,0 +1,194 @@
+#pragma once
+#include "mode_rules.h"
+#include <algorithm>
+#include <cmath>
+#include <deque>
+#include <optional>
+
+namespace dingosdk::modes {
+// Unknown samples during a fall must not rearm its edge. A real return to
+// riding/walking rearms it so a second fast fall gets its own recovery.
+struct RagdollBailEdge {
+    bool falling{};
+    bool observe(bool known,bool ragdoll) noexcept {
+        if(!known)return false;
+        const bool began=ragdoll && !falling;falling=ragdoll;return began;
+    }
+};
+// The physics publisher counts native runout edges, even if their short pulse
+// ends between mode ticks. Establish a baseline before consuming later events.
+class RaceRunoutWatch {
+    std::optional<std::uint64_t> seen;
+public:
+    bool observe(bool valid,std::uint64_t count) noexcept {
+        if(!seen) {if(valid)seen=count;return false;}
+        const bool changed=*seen!=count;seen=count;return changed;
+    }
+};
+// Hippy jumps and walking share offboard states in the 500 range. Riding/air -> offboard
+// transition followed by upward motion identifies the jump; state alone
+// cannot distinguish it from an accidental loss of the board.
+class RaceHippyJump {
+    std::uint64_t candidate_until{},jump_until{},landed_until{},board_until{},intent_until{};
+    bool input_down{};
+    std::uint32_t last{};
+public:
+    void input(bool down,bool board,std::uint64_t now) noexcept {
+        if(down && !input_down && board)intent_until=now+600;
+        input_down=down;
+    }
+    bool taking_off(std::uint64_t now) const noexcept {return now<intent_until || active(now);}
+    bool observe(bool valid,std::uint32_t state,std::uint32_t previous,float vertical,
+                 bool bail,std::uint64_t now,bool airborne=false) noexcept {
+        if(bail) {
+            candidate_until=jump_until=landed_until=board_until=intent_until=0;last=state;return false;
+        }
+        // A missing sample must not turn an intentional jump into board loss.
+        // Keep its existing deadline; do not grant or extend immunity here.
+        if(!valid || !std::isfinite(vertical))return active(now);
+        const bool board=state>=100 && state<300,offboard=state>=500 && state<700;
+        if(board)board_until=now+350;
+        if(state!=last) {
+            candidate_until=offboard && ((previous>=100 && previous<300) || now<board_until)?now+350:0;
+            if(!offboard) {
+                if(jump_until && now<jump_until && state<300)landed_until=now+750;
+                jump_until=0;
+            }
+            last=state;
+        }
+        if(offboard && ((now<intent_until) || (candidate_until && now<=candidate_until && (vertical>.2f || (airborne && vertical>=-1.5f))))) {
+            jump_until=now+4000;candidate_until=intent_until=0;
+        }
+        if(!offboard || now>=jump_until)jump_until=0;
+        return jump_until!=0 || (state<300 && now<landed_until);
+    }
+    bool active(std::uint64_t now) const noexcept {return now<jump_until || now<landed_until;}
+};
+// The offboard animation flag can pulse at a hippy takeoff. A native 300
+// state/counter is immediate; this secondary flag must persist to prove a bail.
+class RaceOffboardRagdoll {
+    std::optional<std::uint64_t> since;bool reported{};
+public:
+    void reset() noexcept {since.reset();reported=false;}
+    bool active() const noexcept {return reported;}
+    bool observe(bool known,bool ragdoll,std::uint64_t now) noexcept {
+        if(!known)return false;
+        if(!ragdoll){since.reset();reported=false;return false;}
+        if(!since)since=now;
+        if(reported || now<*since || now-*since<250)return false;
+        reported=true;return true;
+    }
+};
+class RaceRecoveryGrace {
+    std::uint64_t until{};bool full_bail{};
+public:
+    void reset() noexcept {until=0;full_bail=false;}
+    void cancel_runout() noexcept {if(!full_bail)reset();}
+    bool pending() const noexcept {return until!=0;}
+    bool waiting(std::uint64_t now) const noexcept {return until && now<=until;}
+    bool ready(std::uint64_t now) const noexcept {return until && now>=until;}
+    bool observe(bool bail,bool runout,std::uint64_t now) noexcept {
+        if(!bail && !runout)return false;
+        if(!until){full_bail=bail;until=now+1000u;return true;}
+        // The same fall may acquire a stronger native signal. Preserve its
+        // original one-second deadline instead of restarting the wait.
+        if(bail)full_bail=true;
+        return false;
+    }
+};
+// A native return to controlled board/on-foot physics ends an ordinary bail.
+// Offboard alone is never an automatic-recovery request.
+inline bool race_recovered_control(bool valid,std::uint32_t physics,bool ragdoll_known,bool ragdoll) noexcept {
+    if(!valid || (ragdoll_known && ragdoll))return false;
+    return (physics>=100 && physics<300) || (physics>=500 && physics<700 && ragdoll_known);
+}
+// Walking, jumping and getting back on the board can clear a gate. A
+// confirmed ragdoll retains the finish-only one-second bail grace.
+inline bool race_offboard_progress(bool skater,std::uint32_t state,bool hippy=false) noexcept {
+    return hippy || (skater && state>=500 && state<700);
+}
+// Only restore measured horizontal motion. This is a safety ceiling for bad
+// telemetry, not a recovery boost or the speed assigned to a stopped rider.
+inline constexpr float max_race_recovery_speed=120.f;
+inline bool valid_race_recovery_velocity(const Vec3& velocity) noexcept {
+    return std::all_of(velocity.begin(),velocity.end(),[](float n){return std::isfinite(n);}) &&
+        velocity[1]==0.f && std::hypot(velocity[0],velocity[2])<=max_race_recovery_speed+.001f;
+}
+class RaceMomentum {
+    std::deque<std::pair<std::uint64_t,float>> samples;
+    std::uint64_t sample_after{};
+    std::optional<float> offboard_speed;
+public:
+    void suspend_until(std::uint64_t until) noexcept {sample_after=until;}
+    void observe_onboard(bool onboard,float speed,std::uint64_t now) {
+        if(now<sample_after)return;
+        if(!onboard) {
+            if(!offboard_speed)offboard_speed=before_bail(now);
+            return;
+        }
+        if(!std::isfinite(speed) || speed<0 || speed>max_race_recovery_speed)return;
+        if(offboard_speed){offboard_speed.reset();samples.clear();}
+        observe(speed,now);
+    }
+    void observe(float speed,std::uint64_t now) {
+        if(now<sample_after)return;
+        if(!samples.empty() && now<samples.back().first)samples.clear();
+        while(!samples.empty() && now-samples.front().first>750)samples.pop_front();
+        if(std::isfinite(speed) && speed>=0 && speed<=max_race_recovery_speed)samples.emplace_back(now,speed);
+    }
+    float before_bail(std::uint64_t now) const noexcept {
+        if(offboard_speed)return *offboard_speed;
+        float speed{},recent{};
+        // A collision can report zero before the bail state changes. Retain
+        // the approach velocity for this short detection window only.
+        for(const auto& [at,value]:samples)if(now>=at && now-at<=750) {
+            if(value>0)speed=value;
+            if(now-at<=250)recent=std::max(recent,value);
+        }
+        return recent>0?recent:speed;
+    }
+    float current(std::uint64_t now) const noexcept {
+        if(offboard_speed)return *offboard_speed;
+        return samples.empty() || now<samples.back().first || now-samples.back().first>250?0.f:samples.back().second;
+    }
+};
+// Repeated returns must never raise the first trusted approach-speed budget.
+// A clean riding interval or genuine new checkpoint starts another budget.
+class RaceRecoverySpeedGuard {
+    std::optional<float> ceiling;
+    std::uint64_t until{};
+public:
+    float limit(float measured,std::uint64_t now) noexcept {
+        if(!std::isfinite(measured) || measured<0)measured=0;
+        measured=std::min(measured,max_race_recovery_speed);
+        if(ceiling && now<until)measured=std::min(measured,*ceiling);
+        ceiling=measured;until=now+3000;return measured;
+    }
+    void completed(std::uint64_t now) noexcept {if(ceiling)until=now+3000;}
+    void reset() noexcept {ceiling.reset();until=0;}
+};
+inline Vec3 race_recovery_motion(float speed,float yaw) noexcept {
+    if(!std::isfinite(speed) || speed<0 || speed>max_race_recovery_speed || !std::isfinite(yaw))return {};
+    const auto angle=yaw*3.14159265f/180.f;
+    return {std::sin(angle)*speed,0.f,std::cos(angle)*speed};
+}
+// A busy/off-board native queue must not consume the only copy of a restore.
+class RaceRecoveryDelivery {
+    std::optional<Vec3> pending;
+    std::uint64_t until{};
+public:
+    void reset() noexcept {pending.reset();until=0;}
+    void request(Vec3 value,std::uint64_t now) noexcept {
+        reset();if(valid_race_recovery_velocity(value)){pending=value;until=now+2000;}
+    }
+    std::optional<Vec3> peek(std::uint64_t now,bool returning=false) noexcept {
+        if(now>=until)reset();
+        if(pending)return pending;
+        return returning?std::optional(Vec3{}):std::nullopt;
+    }
+    void wait_for_board(std::uint64_t now) noexcept {
+        if(pending && now<until)until=now+2000;
+    }
+    void accepted(const Vec3& value) noexcept {if(pending && *pending==value)reset();}
+};
+}
diff --git a/Extension/Modes/race_navigation.h b/Extension/Modes/race_navigation.h
new file mode 100644
index 0000000..8a737a3
--- /dev/null
+++ b/Extension/Modes/race_navigation.h
@@ -0,0 +1,29 @@
+#pragma once
+#include "mode_rules.h"
+#include <cmath>
+#include <optional>
+
+namespace dingosdk::modes {
+inline constexpr float race_compass_icon_size=96.f;
+inline constexpr float race_compass_center_y=209.f;
+inline constexpr float race_compass_max_offset=(1184.f-race_compass_icon_size)*.5f;
+// The compass is local presentation; it never advances the referee or changes
+// a player's map waypoint. Guide gates and decorative arrows are not targets.
+inline std::optional<std::size_t> race_compass_gate(const Settings& route,const Message& state,std::uint64_t local) {
+    if(route.mode!=Mode::race || state.phase!=Phase::playing)return {};
+    for(const auto& row:state.standings)if(row.player==local && !row.out) {
+        if(row.score<0)return {};
+        for(auto i=static_cast<std::size_t>(row.score);i<route.points.size();++i)
+            if(i>0 && (i>=route.gate_kinds.size() || route.gate_kinds[i]==RaceGateKind::mandatory))return i;
+    }
+    return {};
+}
+// Native compass projection: ahead is the center; +/-90 degrees reaches
+// either end of its 1184-unit strip. A target behind stays at the nearer end.
+inline std::optional<float> race_compass_offset(const Vec3& target,const std::array<float,16>& camera) {
+    const float dx=target[0]-camera[12],dz=target[2]-camera[14];
+    const float right=dx*camera[0]+dz*camera[2],forward=-dx*camera[8]-dz*camera[10];
+    if(!std::isfinite(right) || !std::isfinite(forward) || std::hypot(camera[8],camera[10])<.001f)return {};
+    return std::clamp(std::atan2(right,forward)/(3.14159265f*.5f),-1.f,1.f)*race_compass_max_offset;
+}
+} // namespace dingosdk::modes
diff --git a/Extension/Modes/race_route.h b/Extension/Modes/race_route.h
new file mode 100644
index 0000000..177167a
--- /dev/null
+++ b/Extension/Modes/race_route.h
@@ -0,0 +1,385 @@
+#pragma once
+#include "mode_rules.h"
+#include <algorithm>
+#include <cmath>
+#include <map>
+#include <deque>
+#include <string>
+#include <optional>
+
+namespace dingosdk::modes {
+enum class RaceObject : unsigned { start, checkpoint, finish, guiding, arrow };
+inline constexpr RaceObject cycle_race_object(RaceObject object, bool previous) noexcept {
+    const auto n=static_cast<unsigned>(object);
+    return static_cast<RaceObject>(previous?(n<=1?4:n-1):(n>=4?1:n+1));
+}
+inline std::array<float,16> race_spawn_transform(const Vec3& at, float heading) noexcept {
+    const float yaw=heading*3.14159265f/180.f, co=std::cos(yaw), si=std::sin(yaw);
+    return {co,0,-si,0,0,1,0,0,si,0,co,0,at[0],at[1]+.3f,at[2],1};
+}
+inline std::array<float,16> race_arrow_transform(const Vec3& at,float heading,float roll,float half_width,float pitch=0.f) noexcept {
+    const float yaw=heading*3.14159265f/180.f,r=roll*3.14159265f/180.f;
+    const float co=std::cos(yaw),si=std::sin(yaw),cr=std::cos(r),sr=std::sin(r),scale=4.f*half_width/6.f;
+    const float p=pitch*3.14159265f/180.f,cp=std::cos(p),sp=std::sin(p);
+    // The native chevron is an XY quad. Aim supplies yaw and tilt; the
+    // D-pad adds roll in that aimed plane. Only the preview follows the camera.
+    const Vec3 right{co,0,-si},up{si*sp,cp,co*sp},forward{si*cp,-sp,co*cp};
+    std::array<float,16> pose{};
+    for(unsigned a=0;a<3;++a){pose[a]=(right[a]*cr+up[a]*sr)*scale;pose[4+a]=(-right[a]*sr+up[a]*cr)*scale;pose[8+a]=forward[a]*scale;pose[12+a]=at[a];}
+    pose[15]=1;return pose;
+}
+inline std::array<float,16> race_arrow_layer_transform(const Vec3& at,float heading,float roll,float width,float pitch,unsigned part) noexcept {
+    auto pose=race_arrow_transform(at,heading,roll,width,pitch);
+    // These separately spawned native FX layers used exactly the same plane.
+    // Keep the translucent blue glow just above the cutout core, so depth
+    // precision at distance cannot let that core suppress its own glow.
+    if(part==1) {
+        const float length=std::hypot(pose[8],pose[9],pose[10]);
+        if(length>.001f)for(unsigned axis=0;axis<3;++axis)pose[12+axis]+=.015f*pose[8+axis]/length;
+    }
+    return pose;
+}
+// The placed starting flag owns the lineup direction, including on a saved
+// course. Only legacy routes without an authored facing infer it from a gate.
+inline float race_start_heading(const Settings& route) noexcept {
+    if(!route.yaws.empty() && std::isfinite(route.yaws.front()))return route.yaws.front();
+    if(!route.points.empty())for(std::size_t i=1;i<route.points.size();++i) {
+        if(guiding_gate(route,i))continue;
+        const float x=route.points[i][0]-route.points[0][0],z=route.points[i][2]-route.points[0][2];
+        if(std::hypot(x,z)>.1f)return std::atan2(x,z)*180.f/3.14159265f;
+    }
+    return 0.f;
+}
+inline void align_race_start(Settings& route) {
+    if(route.mode!=Mode::race || route.points.size()<2)return;
+    const auto heading=race_start_heading(route);
+    if(route.yaws.empty())route.yaws.resize(1);
+    route.yaws[0]=heading;
+}
+// A centered row perpendicular to the flag, with everyone behind its plane.
+inline Vec3 race_start_position(const Settings& route,float index,float count) noexcept {
+    if(route.points.empty())return route.spawn;
+    const auto& start=route.points.front();
+    const float yaw=race_start_heading(route)*3.14159265f/180.f,dx=std::sin(yaw),dz=std::cos(yaw);
+    const float across=(index-(count-1.f)*.5f)*2.5f;
+    return {start[0]-dz*across-dx*1.5f,start[1],start[2]+dx*across-dz*1.5f};
+}
+// A course belongs to a map, independently of any lobby, player or match.
+class RaceCourseMemory {
+    std::map<std::string,Settings> courses;
+public:
+    void save(const std::string& map,const Settings& route) {
+        if(!map.empty() && route.mode==Mode::race && !route.points.empty())courses[map]=route;
+    }
+    std::optional<Settings> restore(const std::string& map) const {
+        const auto it=courses.find(map);return it==courses.end()?std::nullopt:std::optional(it->second);
+    }
+    void clear(const std::string& map) {courses.erase(map);}
+};
+// View is deliberately separate from B/Cancel. A release or loss of focus
+// resets progress, and a completed hold fires only once until released.
+struct RaceClearHold {
+    std::uint64_t since{};bool fired{};
+    float progress{};
+    bool update(bool down,bool focused,std::uint64_t now) noexcept {
+        if(!down || !focused){since=0;fired=false;progress=0;return false;}
+        if(fired)return false;
+        if(!since)since=now;
+        progress=std::min(1.f,float(now-since)/1500.f);
+        if(progress<1.f)return false;
+        fired=true;return true;
+    }
+};
+enum class RaceRouteMenuAction {none,load,save};
+class RaceRouteMenuPress {
+    RaceClearHold hold_;bool previous{},fired{};
+public:
+    float progress{};
+    RaceRouteMenuAction update(bool down,bool focused,std::uint64_t now) noexcept {
+        if(!focused) {hold_={};previous=fired=false;progress=0;return RaceRouteMenuAction::none;}
+        const bool complete=hold_.update(down,true,now);progress=hold_.progress;
+        const bool tap=previous && !down && !fired;
+        previous=down;if(complete)fired=true;else if(!down)fired=false;
+        return complete?RaceRouteMenuAction::load:tap?RaceRouteMenuAction::save:RaceRouteMenuAction::none;
+    }
+};
+inline void clear_race_gates(Settings& route,bool& finish) {
+    // Retain the native start flag while clearing all checkpoints and finish.
+    const auto keep=std::min<std::size_t>(1,route.points.size());
+    route.points.resize(keep);route.yaws.resize(keep);route.widths.resize(keep);route.gate_kinds.resize(keep);route.arrow_rolls.resize(keep);route.gate_pitches.resize(keep);
+    route.race_finish=finish=false;
+}
+inline float race_gate_height(const Settings& settings,std::size_t index) noexcept {return 10.f*gate_half_width(settings,index)/6.f;}
+inline float race_gate_pitch(const Settings& settings,std::size_t index) noexcept {
+    return index<settings.gate_pitches.size()?settings.gate_pitches[index]:0.f;
+}
+struct RaceGateAxes {Vec3 right,up,forward;};
+inline RaceGateAxes race_gate_axes(float yaw,float pitch,float roll=0.f) noexcept {
+    const auto matrix=race_arrow_transform({},yaw,roll,1.5f,pitch);
+    return {{matrix[0],matrix[1],matrix[2]},{matrix[4],matrix[5],matrix[6]},{matrix[8],matrix[9],matrix[10]}};
+}
+inline float race_gate_dot(const Vec3& p,const Vec3& origin,const Vec3& axis) noexcept {
+    return (p[0]-origin[0])*axis[0]+(p[1]-origin[1])*axis[1]+(p[2]-origin[2])*axis[2];
+}
+struct RaceGateCrossing { bool crossed{}, inside{}; Vec3 at{}; };
+inline RaceGateCrossing race_gate_crossing(const Settings& settings,std::size_t index,const Vec3& before,const Vec3& after) noexcept {
+    if(index>=settings.points.size())return {};
+    const auto& gate=settings.points[index];
+    const auto from=index?settings.points[index-1]:settings.points[index];
+    const auto to=index?settings.points[index]:index+1<settings.points.size()?settings.points[index+1]:settings.points[index];
+    const float heading=index<settings.yaws.size()?settings.yaws[index]:std::atan2(to[0]-from[0],to[2]-from[2])*180.f/3.14159265f;
+    const float yaw=heading*3.14159265f/180.f;
+    const float fx=std::sin(yaw),fz=std::cos(yaw);
+    const auto pitch=race_gate_pitch(settings,index);const auto axes=race_gate_axes(heading,pitch);
+    const auto along=[&](const Vec3& p){return pitch==0.f?(p[0]-gate[0])*fx+(p[2]-gate[2])*fz:race_gate_dot(p,gate,axes.forward);};
+    const float a=along(before),b=along(after);
+    if((a<0)==(b<0) || a==b)return {};
+    const float fraction=a/(a-b);
+    Vec3 at{};for(unsigned axis=0;axis<3;++axis)at[axis]=before[axis]+(after[axis]-before[axis])*fraction;
+    const float across=std::abs((at[0]-gate[0])*fz-(at[2]-gate[2])*fx);
+    const float up=pitch==0.f?at[1]-gate[1]:race_gate_dot(at,gate,axes.up);
+    return {true,across<=gate_half_width(settings,index) && std::abs(up)<=race_gate_height(settings,index),at};
+}
+inline bool race_gate_missed(const Settings& settings,std::size_t index,const Vec3& before,const Vec3& after) noexcept {
+    if(index==0 || index>=settings.points.size() || guiding_gate(settings,index))return false;
+    const auto crossing=race_gate_crossing(settings,index,before,after);
+    // Going around (or above) a required gate still crosses its plane. Do not
+    // restrict this warning to a narrow band outside the posts.
+    return crossing.crossed && !crossing.inside;
+}
+// Signed distance to a gate plane, independent of recovery policy.
+inline float race_gate_along(const Settings& route,std::size_t index,const Vec3& at) noexcept {
+    if(index>=route.points.size())return 0;
+    const float heading=index<route.yaws.size()?route.yaws[index]:index?std::atan2(route.points[index][0]-route.points[index-1][0],route.points[index][2]-route.points[index-1][2])*180.f/3.14159265f:0;
+    const float yaw=heading*3.14159265f/180.f;
+    if(const auto pitch=race_gate_pitch(route,index);pitch!=0.f)return race_gate_dot(at,route.points[index],race_gate_axes(heading,pitch).forward);
+    return (at[0]-route.points[index][0])*std::sin(yaw)+(at[2]-route.points[index][2])*std::cos(yaw);
+}
+inline float race_snap_reach(float degrees) noexcept {return std::clamp(degrees*.1f,.5f,6.f);}
+inline float rotate_race_gate(float yaw,int direction,bool snap,float degrees) noexcept {
+    degrees=std::clamp(degrees,5.f,90.f);
+    return std::remainder((snap?std::round(yaw/degrees)*degrees:yaw)+direction*degrees,360.f);
+}
+inline float size_race_gate(float width,int direction) noexcept {
+    // Five percentage points relative to the standard six-metre half width.
+    return std::clamp(width+direction*.3f,min_gate_half_width,max_gate_half_width);
+}
+struct RaceEditorPresses {
+    unsigned previous{}, blocked{};
+    std::array<std::uint64_t,4> next{},started{};
+    void suppress(unsigned held=15) noexcept {blocked=held;previous=0;next={};started={};}
+    unsigned update(unsigned held,std::uint64_t now,bool rotating=false) noexcept {
+        blocked&=held;held&=~blocked;
+        unsigned pressed{};
+        for(unsigned i=0;i<4;++i) {
+            const auto bit=1u<<i;
+            if(!(held&bit)){next[i]=started[i]=0;continue;}
+            if(!(previous&bit)){pressed|=bit;started[i]=now;next[i]=now+(rotating?250:350);}
+            else if(now>=next[i]) {
+                pressed|=bit;
+                const auto interval=rotating?(now-started[i]>=900?50u:80u):150u;
+                next[i]=now+interval; // Never replay missed repeats after a frame stall.
+            }
+        }
+        previous=held;return pressed;
+    }
+};
+struct RaceGatePose { Vec3 at{}; float yaw{}; };
+// Keep a short trail of confirmed grounded poses. A brief landing, collision,
+// air sample or ragdoll cannot replace the last settled position before a fall.
+class RaceLastSafeSpot {
+    std::deque<std::pair<std::uint64_t,RaceGatePose>> trail;
+    std::optional<RaceGatePose> saved;
+public:
+    void reset() noexcept {trail.clear();saved.reset();}
+    std::optional<RaceGatePose> pose() const noexcept {return saved;}
+    void observe(bool safe,const Vec3& at,float yaw,std::uint64_t now) {
+        if(!safe || !std::isfinite(yaw) || !std::all_of(at.begin(),at.end(),[](float v){return std::isfinite(v);})) {
+            trail.clear();return;
+        }
+        if(!trail.empty() && now<trail.back().first) {reset();}
+        while(!trail.empty() && now-trail.front().first>=250) {saved=trail.front().second;trail.pop_front();}
+        if(trail.empty() || now-trail.back().first>=50)trail.emplace_back(now,RaceGatePose{at,yaw});
+    }
+};
+inline std::size_t previous_required_checkpoint(const Settings& route,std::size_t before) noexcept {
+    if(route.points.empty())return 0;
+    auto index=std::min(before,route.points.size()-1);
+    while(index>0){--index;if(!guiding_gate(route,index))break;}
+    return index;
+}
+// Manual fallback persists through another bail at the unsafe checkpoint. A
+// newly cleared Required gate resets it; guides and arrows never become targets.
+class RaceCheckpointFallback {
+    std::optional<std::size_t> selected_,visible_;
+public:
+    std::size_t step_back(const Settings& route,std::size_t next) noexcept {
+        const auto last=selected_.value_or(previous_required_checkpoint(route,next));
+        selected_=previous_required_checkpoint(route,last);visible_=selected_;return *selected_;
+    }
+    std::size_t target(const Settings& route,std::size_t next) const noexcept {
+        return selected_.value_or(previous_required_checkpoint(route,next));
+    }
+    std::size_t visible_from(std::size_t next) const noexcept {return visible_.value_or(next);}
+    void observe_crossings(const Settings& route,std::size_t next,const Vec3& before,const Vec3& after) noexcept {
+        if(!selected_ || route.points.empty())return;
+        const auto end=std::min(next,route.points.size()-1);
+        // Authoritative progress stays cleared during rewind. Re-crossing an
+        // older Required gate must still move the local recovery point ahead.
+        for(auto i=*selected_;i<end;++i)if(!guiding_gate(route,i) &&
+            race_gate_along(route,i,after)>race_gate_along(route,i,before) && race_gate_crossing(route,i,before,after).inside){selected_=i;visible_=i+1;}
+    }
+    void advanced() noexcept {selected_.reset();visible_.reset();}
+};
+struct RaceCheckpointBackPress {
+    bool down=true;
+    bool update(bool held,bool allowed) noexcept {
+        const bool fire=allowed && held && !down;down=held || !allowed;return fire;
+    }
+};
+inline RaceGatePose snap_race_gate(const Settings& settings,const Vec3& at,float yaw,bool enabled,float degrees=15.f) noexcept {
+    RaceGatePose pose{at,yaw};
+    if(!enabled || !std::isfinite(yaw) || !std::all_of(at.begin(),at.end(),[](float n){return std::isfinite(n);}))return pose;
+    degrees=std::clamp(degrees,5.f,90.f);
+    pose.yaw=std::remainder(std::round(yaw/degrees)*degrees,360.f);
+    pose.at[0]=std::round(at[0]*2.f)*.5f;pose.at[2]=std::round(at[2]*2.f)*.5f;
+    const auto count=settings.points.size()-(settings.race_finish && !settings.points.empty()?1:0);
+    if(!count || count>settings.yaws.size())return pose;
+    const auto& previous=settings.points[count-1];
+    const float heading=settings.yaws[count-1],angle=heading*3.14159265f/180.f;
+    const float fx=std::sin(angle),fz=std::cos(angle),dx=at[0]-previous[0],dz=at[2]-previous[2];
+    const float along=dx*fx+dz*fz,across=dx*fz-dz*fx;
+    // Preserve the ground hit's height. Only attract a nearby centre line;
+    // routes can bend and fork without being pulled across the road.
+    if(std::abs(across)<=race_snap_reach(degrees) && std::abs(along)>=3.f) {
+        const float spacing=std::round(along);
+        pose.at[0]=previous[0]+fx*spacing;pose.at[2]=previous[2]+fz*spacing;
+    }
+    if(std::abs(std::remainder(yaw-heading,360.f))<=degrees*.5f)pose.yaw=heading;
+    return pose;
+}
+inline RaceGatePose race_checkpoint_pose(const Settings& route,std::size_t checkpoint) noexcept {
+    if(route.points.empty())return {};
+    const auto last=std::min(checkpoint,route.points.size()-1);
+    RaceGatePose pose{route.points[last],last<route.yaws.size()?route.yaws[last]:0.f};
+    const auto yaw=pose.yaw*3.14159265f/180.f;
+    // Leave room to regain control before skating through the gate again.
+    // Progress remains cleared; the teleport is never a gate crossing.
+    pose.at[0]-=std::sin(yaw)*3.f;pose.at[2]-=std::cos(yaw)*3.f;
+    return pose;
+}
+inline RaceGatePose race_return_pose(const Settings& route,std::size_t next,std::size_t checkpoint,
+                                    std::optional<RaceGatePose> safe) noexcept {
+    if(!safe)return race_checkpoint_pose(route,checkpoint);
+    // A safe position remains useful even if the rider had turned around.
+    // Carry their onboard speed towards the next required gate, not their
+    // pre-fall facing. Decorative objects cannot redirect the recovery.
+    for(auto i=next;i<route.points.size();++i)if(!guiding_gate(route,i)) {
+        const float dx=route.points[i][0]-safe->at[0],dz=route.points[i][2]-safe->at[2];
+        if(std::hypot(dx,dz)>.1f)safe->yaw=std::atan2(dx,dz)*180.f/3.14159265f;
+        else if(i<route.yaws.size())safe->yaw=route.yaws[i];
+        break;
+    }
+    return *safe;
+}
+inline RaceGatePose race_recovery_pose(const Settings& route,std::size_t missed) noexcept {
+    return race_checkpoint_pose(route,previous_required_checkpoint(route,missed));
+}
+// Builder mutations keep pose arrays aligned and reserve the last slot for
+// exactly one finish. The wire continues to send the route in crossing order.
+inline bool edit_race_route(Settings& settings, bool& finish, RaceObject object, const Vec3& at, float yaw, float width, float roll=0.f,float pitch=0.f) {
+    if(settings.mode!=Mode::race || settings.points.size()!=settings.yaws.size() || settings.points.size()!=settings.widths.size() ||
+       !std::isfinite(yaw) || !std::isfinite(roll) || std::abs(roll)>360.f || !std::isfinite(pitch) || std::abs(pitch)>90.f || !std::isfinite(width) || width<min_gate_half_width || width>max_gate_half_width ||
+       !std::all_of(at.begin(),at.end(),[](float v){return std::isfinite(v) && std::abs(v)<100000;}))return false;
+    if(!settings.gate_kinds.empty() && settings.gate_kinds.size()!=settings.points.size())return false;
+    if(!settings.arrow_rolls.empty() && settings.arrow_rolls.size()!=settings.points.size())return false;
+    if(!settings.gate_pitches.empty() && settings.gate_pitches.size()!=settings.points.size())return false;
+    if(object!=RaceObject::start && object!=RaceObject::checkpoint && object!=RaceObject::finish && object!=RaceObject::guiding && object!=RaceObject::arrow)return false;
+    if(settings.gate_kinds.empty())settings.gate_kinds.resize(settings.points.size(),RaceGateKind::mandatory);
+    if(settings.arrow_rolls.empty())settings.arrow_rolls.resize(settings.points.size());
+    if(settings.gate_pitches.empty())settings.gate_pitches.resize(settings.points.size());
+    if(object==RaceObject::start) {
+        if(settings.points.empty()) {settings.points.push_back(at);settings.yaws.push_back(yaw);settings.widths.push_back(width);settings.gate_kinds.push_back(RaceGateKind::mandatory);settings.arrow_rolls.push_back(0.f);settings.gate_pitches.push_back(0.f);}
+        else {settings.points[0]=at;settings.yaws[0]=yaw;settings.widths[0]=width;}
+        settings.spawn=at;settings.has_spawn=true;return true;
+    }
+    if(settings.points.empty())return false;
+    auto index=settings.points.size()-(finish?1:0);
+    if(object==RaceObject::finish) {
+        if(index<2 || !mandatory_gates(settings,index))return false;
+        if(finish) {settings.points.back()=at;settings.yaws.back()=yaw;settings.widths.back()=width;settings.gate_pitches.back()=pitch;settings.race_finish=true;return true;}
+        finish=true;settings.race_finish=true;
+    }
+    settings.points.insert(settings.points.begin()+index,at);
+    settings.yaws.insert(settings.yaws.begin()+index,yaw);
+    settings.widths.insert(settings.widths.begin()+index,width);
+    settings.gate_kinds.insert(settings.gate_kinds.begin()+index,object==RaceObject::arrow?RaceGateKind::arrow:object==RaceObject::guiding?RaceGateKind::guiding:RaceGateKind::mandatory);
+    settings.arrow_rolls.insert(settings.arrow_rolls.begin()+index,object==RaceObject::arrow?roll:0.f);
+    settings.gate_pitches.insert(settings.gate_pitches.begin()+index,pitch);
+    return true;
+}
+inline bool undo_race_gate(Settings& settings, bool& finish) {
+    if(settings.points.size()<=1 || settings.points.size()!=settings.yaws.size() || settings.points.size()!=settings.widths.size())return false;
+    settings.points.pop_back();settings.yaws.pop_back();settings.widths.pop_back();
+    if(!settings.gate_kinds.empty())settings.gate_kinds.pop_back();
+    if(!settings.arrow_rolls.empty())settings.arrow_rolls.pop_back();
+    if(!settings.gate_pitches.empty())settings.gate_pitches.pop_back();
+    finish=false;settings.race_finish=false;return true;
+}
+inline bool race_route_ready(const Settings& settings, bool finish) noexcept {
+    return finish && settings.race_finish && settings.has_spawn && settings.points.size()>=3 &&
+        settings.points.size()==settings.yaws.size() && settings.points.size()==settings.widths.size() &&
+        (settings.gate_kinds.empty() || settings.gate_kinds.size()==settings.points.size()) &&
+        (settings.arrow_rolls.empty() || settings.arrow_rolls.size()==settings.points.size()) &&
+        (settings.gate_pitches.empty() || settings.gate_pitches.size()==settings.points.size()) &&
+        !guiding_gate(settings,0) && !guiding_gate(settings,settings.points.size()-1) && mandatory_gates(settings,settings.points.size()-1)>0;
+}
+// A finish mesh is not publication. Only an explicit Save commits the shape;
+// any later edit withdraws it until saved again. Timer/player edits keep the shape.
+inline bool same_race_shape(const Settings& a,const Settings& b) noexcept {
+    return a.mode==b.mode && a.points==b.points && a.yaws==b.yaws && a.widths==b.widths &&
+        a.gate_kinds==b.gate_kinds && a.arrow_rolls==b.arrow_rolls && a.gate_pitches==b.gate_pitches &&
+        a.race_finish==b.race_finish && a.has_spawn==b.has_spawn && a.spawn==b.spawn;
+}
+class RaceRoutePublication {
+    std::optional<Settings> saved_;
+public:
+    void begin_edit() noexcept {saved_.reset();}
+    bool save(const Settings& route) {if(!race_route_ready(route,route.race_finish))return false;saved_=route;return true;}
+    bool ready(const Settings& route) const noexcept {return saved_ && same_race_shape(*saved_,route) && race_route_ready(route,route.race_finish);}
+    // Native flag placement is a separate editor phase. A stale Join must not
+    // enroll a guest while that picker is open, even when old geometry is valid.
+    bool accepting(const Settings& route,bool editing,bool flag_pending) const noexcept {
+        return !editing && !flag_pending && ready(route);
+    }
+};
+inline bool race_gate_visible(const Settings& route,std::size_t index,std::size_t from,bool playing) noexcept {
+    return !playing || arrow_marker(route,index) || index>=from;
+}
+// Missing a gate's posts never teleports. A later Required gate proves a
+// skipped checkpoint; the Finish is ignored until every Required gate is clear.
+inline std::optional<std::size_t> race_later_gate_crossed(const Settings& route,std::size_t expected,
+        const Vec3& before,const Vec3& after) noexcept {
+    if(expected==0 || expected>=route.points.size())return {};
+    const auto end=route.points.size()-(route.race_finish?1u:0u);
+    for(auto i=expected+1;i<end;++i)
+        if(!guiding_gate(route,i) && race_gate_along(route,i,after)>race_gate_along(route,i,before) &&
+            race_gate_crossing(route,i,before,after).inside)return i;
+    return {};
+}
+inline std::string_view race_route_save_error(const Settings& route,bool finish) noexcept {
+    if(!finish || !route.race_finish)return "You need a Finish line before saving this route.";
+    if(!route.has_spawn || route.points.empty())return "Place the start flag before saving this route.";
+    if(!mandatory_gates(route,route.points.size()-1))return "Place at least one Required gate before saving this route.";
+    if(!race_route_ready(route,finish))return "The route is incomplete. Check the start, Required gates and Finish line.";
+    return {};
+}
+enum class RaceFlagTransition { rejected, edit_route };
+// A saved course keeps every gate and its single finish when its native start
+// flag is placed again. Always open the builder so its owner can edit or clear
+// the restored course, or save it unchanged before choosing Start.
+inline RaceFlagTransition accept_race_flag(Settings& settings, bool& finish, const Vec3& at, float yaw, float width) {
+    if(!edit_race_route(settings,finish,RaceObject::start,at,yaw,width))return RaceFlagTransition::rejected;
+    return RaceFlagTransition::edit_route;
+}
+}
