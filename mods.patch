+    std::lock_guard lock(s.hud_mutex);
+    return s.menu;
+}
+
+bool infected_look(std::uint64_t player) noexcept {
+    const auto &s = state();
+    if (!s.game || !s.game->state || !hunt_like(s.game->settings.mode)) return false; // infected, or seeking
+    const auto phase = s.game->state->phase;
+    if (phase != Phase::playing && phase != Phase::results) return false;
+    const auto *p = standing(*s.game, player);
+    return p && p->up && !p->out;
+}
+bool hidden_player(std::uint64_t player) noexcept {
+    const auto &s = state();
+    if (!s.game || !playing(*s.game) || s.game->settings.mode != Mode::hide) return false;
+    const auto *p = standing(*s.game, player);
+    return p && !p->up && !p->out;
+}
+
+bool local_meat_game() noexcept {
+    const auto &s = state();
+    return s.game && s.game->settings.mode == Mode::meat && s.game->state && s.game->state->phase == Phase::playing &&
+           standing(*s.game, self_id(s));
+}
+bool local_session() noexcept { return state().session; }
+
+overlay::ModesHud hud() {
+    auto &s = state();
+    overlay::ModesHud h;
+    {
+        std::lock_guard lock(s.hud_mutex);
+        if (!s.hud.active && s.hud.offers.empty() && s.hud.invite.empty()) return {};
+        h = s.hud;
+    }
+    if (const auto view = latest_game_view()) {
+        h.camera = view->world;
+        h.vertical_fov = view->vertical_fov;
+    }
+    return h;
+}
+} // namespace dingosdk::modes
diff --git a/Extension/Modes/game_modes.h b/Extension/Modes/game_modes.h
new file mode 100644
index 0000000..a40021d
--- /dev/null
+++ b/Extension/Modes/game_modes.h
@@ -0,0 +1,101 @@
+#pragma once
+#include "Extension/UI/Overlay/overlay.h"
+#include "mode_view.h"
+#include "mode_rules.h"
+#include <cstdint>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// ReSkate's game modes in the running game (rules: mode_rules.h). The game thread drives
+// everything: the session tick hands over who is here and what arrived, and the console's
+// `mode` command sets a game up. The local player's lines and bails come from what the
+// Trainer measures each tick; the HUD reads a snapshot from any thread.
+namespace dingosdk::modes {
+struct SessionPlayer {
+    std::uint64_t id{}; // Steam ID
+    std::string name;
+};
+struct SessionInput {
+    std::uint64_t local{};    // this player's Steam ID; 0 without a session (then playing alone)
+    std::string local_name;
+    std::vector<SessionPlayer> peers; // the other players in this world (never a dedicated server)
+    bool in_world{};          // the world is loaded and playing
+    std::uint64_t world{};    // changes whenever the map or world changes
+    bool barred{};            // the local player's mods change scoring: they cannot play
+};
+// Session tick (game thread): runs the local game and returns the messages to send to
+// every other player (dropped without a session).
+std::vector<std::vector<std::uint8_t>> tick(const SessionInput &input);
+// One game mode message from another player (game thread). False when the bytes are not one.
+bool receive(std::uint64_t sender, std::span<const std::uint8_t> message);
+// Lines for the local chat since the last call (game thread).
+std::vector<std::string> take_notices();
+// Infection: whether this other player is infected now, so their skater wears the reaper here
+// (game thread, from the session's outfit pass).
+bool infected_look(std::uint64_t player) noexcept;
+// Hide & Seek: whether this other player is hiding now, so their nametag, dot and chat bubbles
+// stay off (game thread).
+bool hidden_player(std::uint64_t player) noexcept;
+// `mode <verb> [arguments]` from the console dispatcher (game thread).
+// setup opens the native Throwdown creation page for any custom mode draft;
+// quit leaves immediately, while stop keeps the leader's results presentation.
+std::string command(std::string_view verb, const std::vector<std::string> &arguments);
+// The HUD's snapshot, with the latest camera (any thread).
+overlay::ModesHud hud();
+// What the ReSkate menu's Game Modes page shows (any thread).
+overlay::ModesMenu menu_view();
+struct NativeView {
+    bool active{}, leading{}, placing{};
+    bool pending_flag{}, flag_placed{}, waiting{};
+    bool local_ready{};
+    std::uint64_t local{}, leader{}, world{};
+    std::uint64_t state_sampled_ms{};
+    std::uint32_t game{};
+    unsigned capacity=6;
+    bool route_finish{},cursor_valid{};
+    unsigned route_object=1;
+    bool route_snap=true,exit_confirm{},recovering{};
+    float snap_degrees=15.f,clear_progress{};
+    unsigned missed_gate{};
+    Vec3 cursor{};
+    float cursor_yaw{},cursor_width=6.f;
+    Settings settings;
+    std::optional<Message> state;
+    std::string waiting_status;
+    std::vector<std::pair<std::uint64_t,std::string>> names;
+};
+NativeView native_view();
+struct NativeFlagOffer {
+    std::uint64_t leader{};
+    std::uint32_t game{};
+    std::string key;
+    Vec3 at{};
+    float yaw{};
+    unsigned players=1,duration_s=120,required_gates{};
+    bool operator==(const NativeFlagOffer&) const=default;
+    bool same_registration(const NativeFlagOffer& other) const {
+        return leader==other.leader && game==other.game && key==other.key && at==other.at && yaw==other.yaw;
+    }
+};
+// Game-thread bridge: the existing mode invitation owns the race; a native
+// registration supplies its physical flag, POI and stock Join interaction.
+std::vector<NativeFlagOffer> native_flag_offers(std::uint64_t world);
+bool join_native_flag_offer(const NativeFlagOffer& offer,std::uint32_t mmid);
+void accept_race_start(std::uint64_t world, std::uint32_t game, const Vec3& at, float yaw);
+// The native flag callback only registers a matching draft's spawn. Starting
+// stays an explicit waiting-HUD hold action, dispatched on the client tick.
+void accept_native_start_flag(std::uint64_t world, std::uint32_t game, const Vec3& at, float yaw);
+bool request_native_start(std::uint64_t world, std::uint32_t game) noexcept;
+bool request_native_ready(std::uint64_t world, std::uint32_t game) noexcept;
+bool request_native_quit(std::uint64_t world, std::uint32_t game) noexcept;
+bool active() noexcept;
+std::optional<Vec3> peek_race_recovery_velocity() noexcept;
+void accept_race_recovery_velocity(const Vec3&) noexcept;
+bool internal_teleport() noexcept;
+bool countdown_locks_input() noexcept;
+bool race_recovery_pending() noexcept;
+bool placement_camera_requested() noexcept;
+bool restricts_session_markers() noexcept;
+} // namespace dingosdk::modes
diff --git a/Extension/Modes/mode_announcements.h b/Extension/Modes/mode_announcements.h
new file mode 100644
index 0000000..35a0908
--- /dev/null
+++ b/Extension/Modes/mode_announcements.h
@@ -0,0 +1,34 @@
+#pragma once
+#include "mode_rules.h"
+#include <algorithm>
+#include <format>
+#include <optional>
+#include <string>
+
+namespace dingosdk::modes {
+inline std::string match_time(std::uint64_t ms) {
+    return std::format("{:02}:{:02}.{:03}",ms/60000,(ms/1000)%60,ms%1000);
+}
+struct MatchAnnouncements {
+    bool started{},ended{};
+    std::uint64_t playing_at{};
+    std::optional<std::string> observe(std::string_view host,const Settings& settings,const Message& state,std::uint64_t now) {
+        if(!started && (state.phase==Phase::countdown || state.phase==Phase::playing)) {
+            started=true;playing_at=now+(state.phase==Phase::countdown?state.remaining_ms:0);
+            const auto timer=timed(settings.mode)?settings.duration_s:settings.turn_s;
+            return std::format("{} has started {} ({}).",host,mode_name(settings.mode),match_time(timer*1000ULL));
+        }
+        if(started && !ended && state.phase==Phase::results) {
+            ended=true;
+            auto elapsed=now>playing_at?now-playing_at:0;
+            if(timed(settings.mode))elapsed=std::min<std::uint64_t>(elapsed,settings.duration_s*1000ULL);
+            if(settings.mode==Mode::race && !state.standings.empty()) {
+                const auto& first=state.standings.front();
+                if(!first.out && first.aux>=0 && first.score>=static_cast<std::int32_t>(settings.points.size()))elapsed=first.aux;
+            }
+            return std::format("{} has ended {} ({}).",host,mode_name(settings.mode),match_time(elapsed));
+        }
+        return {};
+    }
+};
+}
diff --git a/Extension/Modes/mode_lobby.h b/Extension/Modes/mode_lobby.h
new file mode 100644
index 0000000..2ab3462
--- /dev/null
+++ b/Extension/Modes/mode_lobby.h
@@ -0,0 +1,31 @@
+#pragma once
+#include "mode_rules.h"
+#include <algorithm>
+#include <set>
+#include <span>
+
+namespace dingosdk::modes {
+// The leader is ready by owning the draft. Joining reserves a place; only
+// that joined player's explicit Ready action can mark their place ready.
+class LobbyReadiness {
+    std::set<std::uint64_t> ready_;
+public:
+    bool mark(std::uint64_t player,std::span<const std::uint64_t> joined) {
+        if(!player || std::find(joined.begin(),joined.end(),player)==joined.end())return false;
+        return ready_.insert(player).second;
+    }
+    bool ready(std::uint64_t player) const {return ready_.contains(player);}
+    bool all(std::span<const std::uint64_t> joined) const {
+        return std::all_of(joined.begin(),joined.end(),[&](auto id){return ready(id);});
+    }
+    void remove(std::uint64_t player) {ready_.erase(player);}
+    void reset() {ready_.clear();}
+    void retain(std::span<const std::uint64_t> joined) {
+        std::erase_if(ready_,[&](auto id){return std::find(joined.begin(),joined.end(),id)==joined.end();});
+    }
+};
+inline std::size_t lobby_ready_count(const Message& state) {
+    if(state.phase!=Phase::setup)return 0;
+    return std::count_if(state.standings.begin(),state.standings.end(),[](const auto& p){return !p.out && p.up;});
+}
+} // namespace dingosdk::modes
diff --git a/Extension/Modes/mode_participation.h b/Extension/Modes/mode_participation.h
new file mode 100644
