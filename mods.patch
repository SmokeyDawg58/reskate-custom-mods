+        std::cout<<"PASS: canonical/versioned packs, disabled dependency, duplicate suppression, integrity and missing/backup errors.\n";
+        return 0;
+    } catch(const std::exception& error) {std::cerr<<error.what()<<'\n';return 1;}
+}
