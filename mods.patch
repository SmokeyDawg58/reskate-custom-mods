+                return found;
+            }
+        } catch(const std::exception&) {}
+    }
+    static std::set<std::string> reported;
+    if(reported.insert(name).second)logging::log(logging::Level::info,logging::Channel::ui,
+        "R.E.S.K.A.T.E.: no loaded flick-it picture for {}.",name);
