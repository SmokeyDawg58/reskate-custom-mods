+    struct BusScope {std::uintptr_t base,bus;~BusScope(){reinterpret_cast<void(*)(std::uintptr_t)>(base+e::release_reference)(bus);}} bus_scope{base,bus};
+    alignas(16) std::array<unsigned char,0x190> descriptor{};
