+std::vector<std::vector<std::uint8_t>> tick(const SessionInput &input) {
+    auto &s = state();
+    const auto now = now_ms();
+    s.session = input.local != 0;
+    if(s.game && ((multiplayer::local_throwdown_active() && !multiplayer::one_up::race_flag_registration_owned() &&
+        !multiplayer::one_up::mode_flag_registration_owned(s.game->id)) || multiplayer::one_up::view().state.match || !input.in_world || input.barred))
+        end_game(s,"Challenge cancelled: another activity started or the world is unavailable.");
+    if (!s.session && !s.lobby_counted.empty()) { // left the lobby: a new one starts a new leaderboard
+        s.lobby.clear();
+        s.lobby_counted.clear();
+        s.lobby_recent.clear();
+        s.lobby_played.clear();
+        s.lobby_leader = 0;
+    }
+    s.barred = input.barred;
+    if (input.local != s.local || (input.world != s.world && s.game)) {
+        if (s.game) end_game(s, "The game ended: the session or map changed.");
+        s.sat_out.clear();
+    }
+    s.local = input.local;
+    s.world = input.world;
+    if(input.in_world) {
+        const auto map=local_profile_object_persistence().map;
+        if(!map.empty())s.course_map=map;
+        else if(s.course_map.empty())s.course_map=std::to_string(input.world);
+    }
+    s.local_name = input.local_name;
+    s.present.clear();
+    for (const auto &peer : input.peers) {
+        s.present.insert(peer.id);
+        if (!peer.name.empty()) s.names[peer.id] = peer.name;
+    }
+    try {
+        track_skater(s, input.in_world, now);
+        std::optional<State::RaceStart> start;
+        std::optional<State::RaceStart> flag;
+        std::optional<State::NativeStart> native_start;
+        std::optional<State::NativeStart> native_quit;
+        {std::lock_guard lock(s.race_start_mutex);start=std::exchange(s.race_start,{});
+            flag=std::exchange(s.native_flag,{});native_start=std::exchange(s.native_start,{});native_quit=std::exchange(s.native_quit,{});}
+        if(native_quit && s.game && s.game->id==native_quit->game && s.world==native_quit->world)
+            (void)command("quit",{});
+        if(start && s.game && s.game->settings.mode==Mode::race && s.game->leading && !s.game->referee && s.game->id==start->game && s.world==start->world) {
+            auto& g=*s.game;
+            const auto transition=accept_race_flag(g.settings,g.race_finish_placed,start->at,start->yaw,s.draft_width);
+            if(transition!=RaceFlagTransition::rejected) {
+                g.native_lobby=g.native_flag_placed=true;g.native_flag_yaw=start->yaw;
+                settings_changed(g);s.race_object=1;
+                s.placing=State::Placing::points;
+                s.race_resume_editor=false;
+                s.pad_previous=~0u;
+                s.keys_previous={true,true,true,true};s.cycle_left=s.cycle_right=true;
+                s.placing_tick=0;s.cursor_ok=false;
+            }
+        }
+        if(flag && s.game && s.game->settings.mode!=Mode::race && s.game->native_lobby && s.game->leading &&
+           !s.game->referee && s.game->id==flag->game && s.world==flag->world) {
+            auto& g=*s.game;
+            g.settings.spawn=flag->at;g.settings.has_spawn=true;g.native_flag_yaw=flag->yaw;g.native_flag_placed=true;
+            settings_changed(g);
+        }
+        if(native_start && s.game && s.game->native_lobby && s.game->native_flag_placed && s.game->leading &&
+           !s.game->referee && s.placing==State::Placing::none && s.game->id==native_start->game && s.world==native_start->world) {
+            const auto result=command("start",{});
+            if(result.starts_with("error:"))popup(s,result.substr(7));
+        }
+        run_placing(s, now);
+        run_invites(s, now);
+        if (s.game) {
+            if (s.game->leading) run_leader(s, *s.game, now);
+            else run_player(s, *s.game, now);
+        }
+        line_up(s);
+        track_game(s, now);
+        // The ragdoll bounces in Hall of Meat (or always, if the player asked).
+        // Hall of Meat games: ReSkate's Hall of Meat held on while one is played (not saved; the
+        // menu's switch is the player's own), and every bail that hurt a bone scored with its Meat.
+        const bool official = official_meat();
+        hall_of_meat::set_forced(official);
+        // S.K.A.T.E. and the trick logger read skate.'s trick list through Hall of Meat's UI model
+        // write hook, which the tap keeps on while it is set.
+        run_skate(s, now);
+        // Everyone with game modes says so every few seconds: the menu lists them, and a game of
+        // another version that cannot read it tells its player to update.
+        if (s.session && now - s.hello_sent >= 5000) {
+            Message hello;
+            hello.kind = Message::Kind::hello;
+            hello.leader = self_id(s);
+            hello.game = 1;
+            if (hello.leader) send(s, hello);
+            s.hello_sent = now;
+        }
+        const bool tap = trick_log().on.load(std::memory_order_acquire) || trick_feed().on.load(std::memory_order_acquire);
+        static bool tapped = false;
+        if (tap != tapped) {
+            hall_of_meat::set_model_write_tap(tap ? &trick_tap : nullptr);
+            logging::log(logging::Level::info, logging::Channel::runtime, "Game modes: skate.'s trick list {}.",
+                         tap ? (hall_of_meat::available() ? "is read from now on" : "cannot be read on this game version") : "is no longer read");
+            tapped = tap;
+        }
+        flush_trick_log();
+        if (const auto bail = hall_of_meat::take_finished_bail(); bail && official && bail->shown && bail->meat > 0) {
+            report(s, Event::bail, bail->meat, 0, s.position);
+            popup(s, "Meat: " + grouped(bail->meat));
+        }
+        build_hud(s, now);
+    } catch(const std::exception& error) {
+        logging::log(logging::Level::error,logging::Channel::runtime,"Game-mode tick failed: {}",error.what());
+        if(s.game)end_game(s,"Challenge cancelled after a runtime error.");
+        overlay::pause_game_input(false);
+    } catch(...) {
+        logging::write(logging::Level::error,logging::Channel::runtime,"Game-mode tick failed with an unknown exception.");
+        if(s.game)end_game(s,"Challenge cancelled after a runtime error.");
+        overlay::pause_game_input(false);
+    }
+    auto out = std::move(s.outbox);
+    s.outbox.clear();
+    if (!s.session) out.clear();
+    return out;
+}
