+// milliseconds. Round up so 2.9 seconds displays 3, and GO occurs only at zero.
+constexpr std::uint64_t native_hud_seconds(std::uint64_t milliseconds) {
+    return milliseconds / 1000 + (milliseconds % 1000 != 0);
