+        try {throw std::runtime_error("Optional native panel dependency unavailable");}
+        catch(const std::runtime_error&) {owned.rollback(checkpoint,destroy);}
+        check(owned.checkpoint()==checkpoint && live.size()==1 && live.contains(1),
