+}
+}
diff --git a/Extension/Modes/race_route_library.cpp b/Extension/Modes/race_route_library.cpp
new file mode 100644
index 0000000..e4e4120
--- /dev/null
+++ b/Extension/Modes/race_route_library.cpp
@@ -0,0 +1,158 @@
+#include "race_route_library.h"
+#include "race_route_json.h"
+#include <cctype>
+#include <set>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <Windows.h>
+#endif
+
+namespace dingosdk::modes {
+namespace {
+std::filesystem::path utf8_path(std::string_view value) {return std::filesystem::path(std::u8string(value.begin(),value.end()));}
+std::string file_component(std::string value) {
+    for(auto& ch:value)if(static_cast<unsigned char>(ch)<32 || std::string_view("<>:\"/\\|?*").find(ch)!=std::string_view::npos)ch='_';
+    while(!value.empty() && (value.back()=='.' || value.back()==' '))value.pop_back();
+    if(value.empty() || value=="." || value=="..")value="Route";
+    auto stem=value.substr(0,value.find('.'));for(auto& c:stem)c=static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+    if(stem=="CON" || stem=="PRN" || stem=="AUX" || stem=="NUL" ||
+       (stem.size()==4 && (stem.starts_with("COM") || stem.starts_with("LPT")) && stem[3]>='1' && stem[3]<='9'))value.insert(value.begin(),'_');
+    return value;
+}
+std::string read_text(const std::filesystem::path& file) {
+    if(!std::filesystem::is_regular_file(file) || std::filesystem::is_symlink(file) || std::filesystem::file_size(file)>65536)
+        throw std::runtime_error("Choose a readable Deathrace JSON file smaller than 64 KB.");
+    std::ifstream in(file,std::ios::binary);std::string text{std::istreambuf_iterator<char>(in),{}};
+    if(!in && !in.eof())throw std::runtime_error("The route file could not be read.");return text;
+}
+void atomic_write(const std::filesystem::path& file,const std::string& text,bool replace) {
+    auto temporary=file;temporary+=".tmp";
+    if(std::filesystem::is_symlink(temporary) || std::filesystem::is_symlink(file))throw std::runtime_error("A route file cannot be a link.");
+    std::ofstream output(temporary,std::ios::binary|std::ios::trunc);output.write(text.data(),static_cast<std::streamsize>(text.size()));output.close();
+    if(!output)throw std::runtime_error("The route could not be written. Your editor stays open.");
+#ifdef _WIN32
+    if(!MoveFileExW(temporary.c_str(),file.c_str(),MOVEFILE_WRITE_THROUGH|(replace?MOVEFILE_REPLACE_EXISTING:0)))
+        throw std::system_error(static_cast<int>(GetLastError()),std::system_category(),"The route file could not be saved");
+#else
+    if(!replace && std::filesystem::exists(file))throw std::runtime_error("That route filename already exists.");
+    std::filesystem::rename(temporary,file);
+#endif
+}
+}
+std::filesystem::path RaceRouteLibrary::path(std::uint64_t id) const {
+    const auto it=paths_.find(id);if(it==paths_.end())throw std::runtime_error("This saved route is no longer available.");return it->second;
+}
+std::uint64_t RaceRouteLibrary::save(NamedRaceRoute route) {
+    route.name=race_route_name(std::move(route.name));
+    const auto old=route.id?std::find_if(routes_.begin(),routes_.end(),[&](const auto& value){return value.id==route.id;}):routes_.end();
+    if(route.id && old==routes_.end())throw std::runtime_error("This saved route is no longer available.");
+    if(!route.id && routes_.size()>=256)throw std::runtime_error("The route library is full.");
+    if(std::any_of(routes_.begin(),routes_.end(),[&](const auto& value){return value.id!=route.id && value.map==route.map && value.name==route.name;}))
+        throw std::runtime_error("That route name already exists on this map. Choose another name.");
+    if(!route.id)route.id=next_++;
+    const auto text=encode_named_race_json(route);if(text.size()>65536)throw std::runtime_error("This route is too large to save.");
+    const auto map_name=route.map.substr(route.map.find_last_of("/\\")==std::string::npos?0:route.map.find_last_of("/\\")+1);
+    const auto folder=directory_/utf8_path(file_component(map_name));
+    if(std::filesystem::is_symlink(folder))throw std::runtime_error("The map's route folder cannot be a link.");
+    std::filesystem::create_directories(folder);
+    const auto final=folder/utf8_path(file_component(route.name)+".json");
+    const auto previous=old==routes_.end()?std::filesystem::path{}:path(route.id);
+    const bool exists=std::filesystem::exists(final);
+    const bool same=exists && !previous.empty() && std::filesystem::exists(previous) && std::filesystem::equivalent(final,previous);
+    if(exists && !same)throw std::runtime_error("That route filename already exists. Choose another name.");
+    atomic_write(final,text,same);
+    if(!previous.empty() && previous.extension()==".json" && previous!=final && !same) {
+        std::error_code error;std::filesystem::remove(previous,error);
+        if(error){std::filesystem::remove(final);throw std::runtime_error("The original route file could not be renamed.");}
+    }
+    paths_[route.id]=final;
+    const auto id=route.id;if(old!=routes_.end())*old=std::move(route);else routes_.push_back(std::move(route));return id;
+}
+void RaceRouteLibrary::read() {
+    routes_.clear();paths_.clear();next_=1;
+    if(!std::filesystem::exists(directory_)) {
+        if(legacy_directory_.empty() || !std::filesystem::exists(legacy_directory_))return;
+        std::filesystem::create_directories(directory_);
+    }
+    if(std::filesystem::is_symlink(directory_))throw std::runtime_error("The route folder cannot be a link.");
+    std::vector<std::filesystem::path> files,legacy;
+    for(std::filesystem::recursive_directory_iterator it(directory_),end;it!=end;++it) {
+        if(it->is_symlink()){if(it->is_directory())it.disable_recursion_pending();continue;}
+        if(it.depth()>1){it.disable_recursion_pending();continue;}
+        if(!it->is_regular_file())continue;
+        if(it->path().extension()==".json")files.push_back(it->path());
+        if(it.depth()==0 && it->path().extension()==".race")legacy.push_back(it->path());
+        if(files.size()+legacy.size()>4096)break;
+    }
+    std::sort(files.begin(),files.end());std::sort(legacy.begin(),legacy.end());
+    for(const auto& file:files)try {
+        if(routes_.size()>=256)break;
+        auto route=decode_named_race_json(read_text(file));if(!route)continue;
+        if(route->id && route->id<UINT64_MAX)next_=std::max(next_,route->id+1);
+        if(!route->id || find(route->id))route->id=next_++;
+        paths_[route->id]=file;routes_.push_back(std::move(*route));
+    }catch(const std::exception&){}
+    for(const auto& file:legacy)try {
+        if(routes_.size()>=256)break;
+        const auto stem=file.stem().string();std::uint64_t id{};const auto parsed=std::from_chars(stem.data(),stem.data()+stem.size(),id);
+        if(parsed.ec!=std::errc{} || parsed.ptr!=stem.data()+stem.size() || !id || id==UINT64_MAX || find(id))continue;
+        const auto text=read_text(file);const auto bytes=std::span(reinterpret_cast<const std::uint8_t*>(text.data()),text.size());
+        if(auto route=decode_named_race(bytes)) {
+            route->id=id;next_=std::max(next_,id+1);paths_[id]=file;routes_.push_back(*route);
+            save(*route); // Preserve the original .race file as the migration backup.
+        }
+    }catch(const std::exception&){}
+    migrate_legacy_directory();
+    std::sort(routes_.begin(),routes_.end(),[](const auto& a,const auto& b){return std::tie(a.map,a.name,a.id)<std::tie(b.map,b.name,b.id);});
+}
+void RaceRouteLibrary::migrate_legacy_directory() {
+    if(legacy_directory_.empty() || !std::filesystem::exists(legacy_directory_))return;
+    const auto marker=directory_/".legacy-root-migration-v1";
+    if(std::filesystem::exists(marker))return;
+    if(std::filesystem::is_symlink(legacy_directory_))throw std::runtime_error("The previous route folder cannot be a link.");
+    std::vector<std::filesystem::path> files,legacy;
+    for(std::filesystem::recursive_directory_iterator it(legacy_directory_),end;it!=end;++it) {
+        if(it->is_symlink()){if(it->is_directory())it.disable_recursion_pending();continue;}
+        if(it.depth()>1){it.disable_recursion_pending();continue;}
+        if(!it->is_regular_file())continue;
+        if(it->path().extension()==".json")files.push_back(it->path());
+        if(it.depth()==0 && it->path().extension()==".race")legacy.push_back(it->path());
+        if(files.size()+legacy.size()>4096)throw std::runtime_error("Too many files in the previous route folder.");
+    }
+    std::sort(files.begin(),files.end());std::sort(legacy.begin(),legacy.end());
+    std::set<std::uint64_t> json_ids;
+    const auto copy=[&](NamedRaceRoute route) {
+        if(std::any_of(routes_.begin(),routes_.end(),[&](const auto& r){return r.name==route.name && r.map==route.map && r.settings==route.settings;}))return;
+        route.id=0;save(std::move(route));
+    };
+    for(const auto& file:files) {
+        std::optional<NamedRaceRoute> route;
+        try {route=decode_named_race_json(read_text(file));}catch(const std::exception&){}
+        if(route){json_ids.insert(route->id);copy(std::move(*route));}
+    }
+    for(const auto& file:legacy) {
+        const auto stem=file.stem().string();std::uint64_t id{};const auto parsed=std::from_chars(stem.data(),stem.data()+stem.size(),id);
+        if(parsed.ec!=std::errc{} || parsed.ptr!=stem.data()+stem.size() || !id || json_ids.contains(id))continue;
+        std::optional<NamedRaceRoute> route;
+        try {const auto text=read_text(file);route=decode_named_race(std::span(reinterpret_cast<const std::uint8_t*>(text.data()),text.size()));}catch(const std::exception&){}
+        if(route)copy(std::move(*route));
+    }
+    // Leave the old files as backups. This receipt prevents later renames in
+    // Mods from resurrecting the original root-folder names on the next read.
+    atomic_write(marker,"complete\n",false);
+}
+std::uint64_t RaceRouteLibrary::import_json(const std::filesystem::path& source,const std::string& current_map) {
+    auto route=decode_named_race_json(read_text(source));if(!route)throw std::runtime_error("This is not a valid completed Deathrace route JSON file.");
+    if(route->map!=current_map)throw std::runtime_error("This route belongs to another map. Switch to that map before loading it.");
+    for(const auto& local:routes_) {
+        const auto file=path(local.id);
+        if(std::filesystem::exists(file) && std::filesystem::equivalent(source,file)) {
+            route->id=local.id;return save(std::move(*route));
+        }
+        if(local.map==route->map && local.name==route->name && local.settings==route->settings)return local.id;
+    }
+    route->id=0;return save(std::move(*route));
+}
+}
diff --git a/Extension/Modes/race_route_library.h b/Extension/Modes/race_route_library.h
new file mode 100644
index 0000000..c6776c5
--- /dev/null
+++ b/Extension/Modes/race_route_library.h
@@ -0,0 +1,73 @@
+#pragma once
+#include "race_route.h"
+#include <charconv>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <stdexcept>
+#include <tuple>
+
+
+namespace dingosdk::modes {
+struct NamedRaceRoute {
+    std::uint64_t id{};
+    std::string name,map;
+    Settings settings;
+};
+inline std::string race_route_name(std::string name) {
+    const auto first=name.find_first_not_of(" \t\r\n"),last=name.find_last_not_of(" \t\r\n");
+    if(first==std::string::npos)return {};
+    name=name.substr(first,last-first+1);
+    if(name.size()>64 || std::any_of(name.begin(),name.end(),[](unsigned char ch){return ch<32 || ch==127;}))return {};
+    return name;
+}
+inline std::vector<std::uint8_t> encode_named_race(const NamedRaceRoute& route) {
+    const auto name=race_route_name(route.name);
+    if(name.empty() || route.map.empty() || route.map.size()>512 || !race_route_ready(route.settings,route.settings.race_finish))
+        throw std::invalid_argument("Name the completed route before saving.");
+    Message message;message.kind=Message::Kind::setup;message.game=1;message.leader=1;message.settings=route.settings;
+    const auto settings=encode(message);
+    std::vector<std::uint8_t> bytes{'R','S','R','O','U','T','E',1};
+    const auto number=[&](std::size_t n){for(unsigned i=0;i<4;++i)bytes.push_back(static_cast<std::uint8_t>((n>>(8*i))&255));};
+    number(name.size());number(route.map.size());number(settings.size());
+    bytes.insert(bytes.end(),name.begin(),name.end());bytes.insert(bytes.end(),route.map.begin(),route.map.end());
+    bytes.insert(bytes.end(),settings.begin(),settings.end());return bytes;
+}
+inline std::optional<NamedRaceRoute> decode_named_race(std::span<const std::uint8_t> bytes) {
+    constexpr std::array<std::uint8_t,8> magic{'R','S','R','O','U','T','E',1};
+    if(bytes.size()<20 || bytes.size()>65536 || !std::equal(magic.begin(),magic.end(),bytes.begin()))return {};
+    const auto number=[&](unsigned offset){std::uint32_t value{};for(unsigned i=0;i<4;++i)value|=std::uint32_t(bytes[offset+i])<<(8*i);return value;};
+    const auto names=number(8),maps=number(12),settings=number(16);
+    if(!names || names>64 || !maps || maps>512 || settings>64000 || std::uint64_t(20)+names+maps+settings!=bytes.size())return {};
+    NamedRaceRoute route;
+    route.name.assign(reinterpret_cast<const char*>(bytes.data()+20),names);
+    route.map.assign(reinterpret_cast<const char*>(bytes.data()+20+names),maps);
+    if(race_route_name(route.name)!=route.name || route.map.find('\0')!=std::string::npos)return {};
+    const auto message=decode(bytes.subspan(20+names+maps,settings));
+    if(!message || message->kind!=Message::Kind::setup || message->settings.mode!=Mode::race ||
+       !race_route_ready(message->settings,message->settings.race_finish))return {};
+    route.settings=message->settings;return route;
+}
+class RaceRouteLibrary {
+    std::filesystem::path directory_,legacy_directory_;
+    std::vector<NamedRaceRoute> routes_;
+    std::map<std::uint64_t,std::filesystem::path> paths_;
+    std::uint64_t next_=1;
+    void migrate_legacy_directory();
+public:
+    explicit RaceRouteLibrary(std::filesystem::path directory,std::filesystem::path legacy={}):directory_(std::move(directory)),legacy_directory_(std::move(legacy)) {}
+    const std::vector<NamedRaceRoute>& routes() const noexcept {return routes_;}
+    void read();
+    std::filesystem::path path(std::uint64_t id) const;
+    std::uint64_t import_json(const std::filesystem::path& source,const std::string& current_map);
+    const NamedRaceRoute* find(std::uint64_t id) const noexcept {
+        const auto it=std::find_if(routes_.begin(),routes_.end(),[&](const auto& route){return route.id==id;});
+        return it==routes_.end()?nullptr:&*it;
+    }
+    std::uint64_t save(NamedRaceRoute route);
+    void rename(std::uint64_t id,std::string name) {
+        const auto* original=find(id);if(!original)throw std::runtime_error("This saved route is no longer available.");
+        auto route=*original;route.name=std::move(name);save(std::move(route));
+    }
+};
+}
diff --git a/Extension/Modes/race_sound.h b/Extension/Modes/race_sound.h
new file mode 100644
index 0000000..73e767c
--- /dev/null
+++ b/Extension/Modes/race_sound.h
@@ -0,0 +1,40 @@
+#pragma once
+#include "mode_rules.h"
+#include <optional>
+
+namespace dingosdk::modes {
+enum class RaceCountdownCue { count,go };
+struct RaceCountdownAudio {
+    unsigned last_second{};
+    bool counted{},started{};
+    std::optional<RaceCountdownCue> update(Phase phase,std::uint64_t remaining) noexcept {
+        if(phase==Phase::setup){*this={};return {};}
+        if(phase==Phase::countdown) {
+            const auto seconds=static_cast<unsigned>((remaining+999)/1000);
+            if(seconds>=1 && seconds<=3 && (!last_second || seconds<last_second)) {
+                last_second=seconds;counted=true;return RaceCountdownCue::count;
+            }
+        }
+        if(phase==Phase::playing && !started) {
+            started=true;if(counted)return RaceCountdownCue::go;
+        }
+        return {};
+    }
+};
+enum class RaceGateCue { none,required,finish };
+inline RaceGateCue race_gate_cue(const Settings& route,int before,int after) noexcept {
+    if(before<0 || after<=before || route.points.empty())return RaceGateCue::none;
+    if(static_cast<std::size_t>(after)>=route.points.size())return RaceGateCue::finish;
+    return mandatory_gates(route,after)>mandatory_gates(route,before)?RaceGateCue::required:RaceGateCue::none;
+}
+// Observe authoritative progress even after the final gate changes Playing to
+// Results. Gameplay-only checkpoint polling cannot see a solo race's finish.
+struct RaceProgressAudio {
+    int heard{};
+    RaceGateCue update(const Settings& route,Phase phase,int score,bool out) noexcept {
+        if(phase==Phase::setup || phase==Phase::countdown){heard=0;return RaceGateCue::none;}
+        if(out || score<=heard)return RaceGateCue::none;
+        const auto cue=race_gate_cue(route,heard,score);heard=score;return cue;
+    }
+};
+}
diff --git a/Extension/Modes/race_source_contract.h b/Extension/Modes/race_source_contract.h
new file mode 100644
index 0000000..9b46152
--- /dev/null
+++ b/Extension/Modes/race_source_contract.h
@@ -0,0 +1,58 @@
+#pragma once
+#include "Engine/Game/Build/addresses.h"
+#include "Engine/Game/Build/20260929/engine.h"
+#include <cstdint>
+#include <string_view>
+
+namespace dingosdk::modes::race_world::detail {
+// A native ClientSkaterSource can keep its spawned entity slot empty after
+// player replacement, while the verified local player owns the current skater.
+// Its same-context CAS source still supplies the native creation parent bus,
+// just as native_skater_spawn::find_source does for remote actor creation.
+template<class Pointer, class UInt32, class Byte, class Name>
+std::uintptr_t checkpoint_parent_bus(std::uintptr_t base, std::uintptr_t context,
+    Pointer pointer, UInt32 uint32, Byte byte, Name name) {
+    if(!base || !context)return 0;
+    const auto player_offset=uint32(base+addr::engine::context_player_manager_offset);
+    if(player_offset>0x1000000)return 0;
+    const auto players=pointer(context+player_offset);
+    if(!players || pointer(players)!=base+addr::engine::local_player_manager_vtable)return 0;
+    const auto first=pointer(players+0x4c8),last=pointer(players+0x4d0);
+    if(!first || last<first || last-first!=8)return 0;
+    const auto player=pointer(first);
+    if(!player || pointer(player)!=base+addr::engine::local_player_vtable ||
+        pointer(player+0x78)!=context || byte(player+0x45)!=1 || byte(player+0x44))return 0;
+    const auto local=pointer(player+0xb8);
+    if(!local || pointer(local)!=base+addr::engine::skater_entity_vtable ||
+        pointer(local+0x20)!=context || pointer(local+0xf8)!=player)return 0;
+
+    const auto partition_offset=uint32(base+addr::engine::context_partition_offset);
+    if(partition_offset>0x1000000)return 0;
+    const auto partition=uint32(context+partition_offset);
+    if(partition>4)return 0;
+    std::uintptr_t fallback{};
+    for(unsigned kind=0;kind<7;++kind) {
+        const auto manager=pointer(base+addr::engine::source_managers+(std::uintptr_t(partition)*7+kind)*8);
+        if(!manager || pointer(manager)!=base+addr::engine::source_manager_vtable || pointer(manager+0x18)!=context)continue;
+        const auto begin=pointer(manager+0xa0),end=pointer(manager+0xa8);
+        if(!begin || end<begin || (end-begin)%0x18 || end-begin>64*0x18)continue;
+        for(auto at=begin;at<end;at+=0x18) {
+            const auto source=pointer(at+8);
+            if(!source || pointer(source)!=base+addr::engine::client_skater_source_vtable || pointer(source+0x20)!=context)continue;
+            const auto data=pointer(source+0x38),bus=pointer(source+0x30);
+            if(!data || !bus || pointer(bus+0x20)!=context)continue;
+            const auto blueprint=pointer(data+0xd0)&~std::uintptr_t{4};
+            if(!blueprint || name(pointer(blueprint+0x18))!=
+                "Gameplay/Characters/CharacterBlueprint_Physics_Skater_RSP_CAS")continue;
+            // create_bus derives its owner from this bus. A matching context
+            // alone is insufficient if the owner was already torn down.
+            const auto owner=pointer(bus+8);
+            if(!owner || !pointer(owner+0x48))continue;
+            const auto entity=pointer(source+0x68);
+            if(entity==local)return bus;
+            if(!entity && !fallback)fallback=bus;
+        }
+    }
+    return fallback;
+}
+}
