+bool consume_one_up_throwdown_send(std::uint32_t hash,Address type,Address payload) noexcept {
+    if(!injecting && (hash==event_leave_in_progress || hash==event_force_destroy) && modes::active()) {
+        const auto mode=modes::native_view();
+        if(mode.active && mode.state && (mode.state->phase==modes::Phase::countdown || mode.state->phase==modes::Phase::playing) &&
+           std::any_of(mode.state->standings.begin(),mode.state->standings.end(),[&](const auto& row){return row.player==mode.local;}) &&
+           modes::request_native_quit(mode.world,mode.game))return true;
+    }
+    if(!injecting && one_up::restricts_session_markers() &&
+       (hash==event_leave_in_progress || hash==event_force_destroy)) {
+        // The native activity pause modal uses these same Quit Match requests.
+        // Its temporary picker is already gone; end the owned 1-Up match.
+        one_up::queue("leave");
+        return true;
+    }
+    if(injecting || !one_up::flag_registration_owned() || !type || !payload)return false;
+    try {
+        if(hash==event_create || hash==event_update || hash==event_host_set) {
+            const auto mmid=find_field(type,field_mmid);
+            const bool owned=hash==event_create || (mmid && mmid->size==4 &&
+                one_up::owns_flag_registration(read<std::uint32_t>(payload+mmid->offset)));
+            const auto params=find_field(type,field_params);
+            if(owned && params && params->kind==kind_struct) {
+                const auto instance=find_field(params->type,field_instance);
+                const auto series=find_field(params->type,field_series);
+                if(instance && instance->kind==kind_string && series && series->kind==kind_string &&
+                   read_string(payload+params->offset+series->offset)=="SpotBattle") {
+                    std::string key="oneup";
+                    if(const auto game=one_up::native_flag_mode_game()) {
+                        const auto view=modes::native_view();
+                        if(!view.active || view.game!=game)return false;
+                        key=modes::mode_key(view.settings.mode);
+                    }
+                    // Native registry selects RegistrationPrefab by Series +
+                    // InstanceId. Keep the Spot Battle backend protocol while
+                    // choosing a private mesh variation for this custom flag.
+                    assign_string(payload+params->offset+instance->offset,"ReSkate."+key);
