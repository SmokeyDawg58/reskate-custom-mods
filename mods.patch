+        // live. These are independent, game-owned gameplay HUD stacks.
+        for(const auto field:{0xa7b6b40fU,0xee58682eU,0x0f3c11c2U}) {
+            unsigned count{},stride{};
+            c.array(c.path(root.model,{field,items}),64,count,stride);
