+    std::vector<BoneCamMark> marks;
+    float hit{};                    // 0..1: the flash of an impact, fading fast
+    float daze{};                   // 0..1: a concussion's after-effects (kept faint), fading
+    std::array<float, 3> hit_at{};  // world: where it landed
+    bool preview{};        // the menu's preview: the injuries are examples
+    std::uint64_t serial{}; // one per bail
+    std::vector<BoneCamBone> bones;
+    std::vector<BoneCamInjury> injuries;
+    std::array<float, 3> left{}; // world: from the skater's right shoulder toward the left one (which way the art faces)
+    std::array<float, 16> camera{}; // world matrix: right, up, back, position rows
+    float vertical_fov{};
+};
+using BoneCamFeed = BoneCam (*)();
+// One row of the lobby leaderboard (Game Modes page), best first.
+struct ModesLeaderRow {
+    std::string name;
+    int points{}, wins{}, podiums{}, games{};
+    int streak{}, best_streak{}; // wins in a row: now, and the most this session
+    std::string best_mode;       // the mode they win most ("Skate Tag"), or empty without a win
+    bool you{};
+};
+// A finished game on the lobby leaderboard, newest first.
+struct ModesLeaderGame {
+    std::string mode, winner, second;
+    int players{};
+    std::uint32_t ago_s{};
+};
+// ModesHud's menu needs (the Game Modes page of the ReSkate menu): what the local player can do.
+struct ModesMenu {
+    bool in_game{}, leading{};
+    int phase{};                  // modes::Phase, 0 when no game
+    std::string mode;             // "graffiti"
+    std::size_t corners{}, points{}, players{};
+    std::uint32_t duration{}, turn{};
+    int strikes{};
+    float radius{};
+    std::string missing;          // what `mode start` still needs
+    std::string bone_cam;         // "meat", "on" or "off"
+    bool bone_cam_ringing = true; // a concussion's ringing is on (not muted)
+    // ReSkate's own Hall of Meat (Extension/HallOfMeat) runs on this game build: it replaces the Bone
+    // Cam, and `meat_every_bail` is its switch (on: every bail in free skate too).
+    bool official_meat{}, meat_every_bail{};
+    std::uint8_t trick_kinds{0x0f}; // S.K.A.T.E.: the kinds of trick that may be set (1 flips, 2 grabs, 4 grinds, 8 manuals)
+    bool spectate = true;           // S.K.A.T.E.: the camera follows whoever is up
+    bool goofy{};                   // S.K.A.T.E.: flick diagrams for a goofy stance
+    // The other players in the session: who has game modes (this version), who has another one
+    // and has to update, and how many have none (they cannot see or join a game).
+    bool in_session{};
+    std::vector<std::string> lobby_modded, lobby_outdated;
+    int lobby_without{};
+    // The lobby leaderboard: every game of two or more finished in this session.
+    std::vector<ModesLeaderRow> leaders;
+    std::vector<ModesLeaderGame> recent;
+    int lobby_games{};
+    std::string lobby_top_mode; // the most played mode
+    float area_radius{};          // > 0: the area is a circle
+    std::string placing;          // "circle", "corners", "points" while placing on the skater; else empty
+    std::vector<ModesHudOffer> offers; // other players' games, to join from the menu
+};
+using ModesMenuFeed = ModesMenu (*)();
+}
diff --git a/Extension/Modes/placement_camera.h b/Extension/Modes/placement_camera.h
new file mode 100644
index 0000000..4f8357e
--- /dev/null
+++ b/Extension/Modes/placement_camera.h
@@ -0,0 +1,34 @@
+#pragma once
+#include <cstdint>
+#include <optional>
+
+namespace dingosdk::modes {
+// A native camera request can be rejected while flag placement is closing.
+// Keep asking until the live camera acknowledges it, and drain a late enable
+// on exit. A camera already active before the editor remains the user's own.
+class PlacementCamera {
+public:
+    std::optional<bool> update(bool requested, bool active, std::uint64_t now) noexcept {
+        if (requested != requested_) {
+            requested_ = requested;
+            sent_.reset();
+            if (!requested && owned_) release_until_ = now + 1600;
+        }
+        if (requested && !owned_ && !active) owned_ = true;
+        if (!owned_) return {};
+        if (requested && active) return {};
+        if (!requested && !active && now >= release_until_) {
+            owned_ = false;
+            sent_.reset();
+            return {};
+        }
+        if (sent_ && now >= *sent_ && now - *sent_ < 400) return {};
+        sent_ = now;
+        return requested;
+    }
+private:
+    bool requested_{}, owned_{};
+    std::uint64_t release_until_{};
+    std::optional<std::uint64_t> sent_;
+};
+} // namespace dingosdk::modes
diff --git a/Extension/Modes/race_asset_contract.h b/Extension/Modes/race_asset_contract.h
new file mode 100644
index 0000000..8693a21
--- /dev/null
+++ b/Extension/Modes/race_asset_contract.h
@@ -0,0 +1,43 @@
+#pragma once
+#include "Engine/Game/Build/addresses.h"
+#include "Engine/Game/Build/20260929/race_objects.h"
+#include <cstdint>
+#include <limits>
+
+namespace dingosdk::modes::race_world::detail {
+class CheckpointWorldLifetime {
+    bool blocked_=true,shutdown_{};
+    std::uint32_t retired_game_{};
+public:
+    bool blocked() const noexcept {return blocked_;}
+    bool can_publish(std::uint32_t game) const noexcept {return !blocked_ && game && game!=retired_game_;}
+    bool before_transition(unsigned next,std::uint32_t current_game) noexcept {
+        if(next==13 || next==21) {if(!shutdown_)blocked_=false;return false;}
+        if(next!=14 && next!=22 && next!=3 && next!=24)return false;
+        const bool release=!blocked_;blocked_=true;
+        if(current_game)retired_game_=current_game;
+        if(next==24)shutdown_=true;
+        return release;
+    }
+};
+template<class ReadPointer>
+bool checkpoint_blueprint(std::uintptr_t asset, std::uintptr_t base, ReadPointer read) {
+    constexpr auto maximum = std::numeric_limits<std::uintptr_t>::max();
+    if (!asset || asset > maximum - 8 || !base ||
+        base > maximum - addr::race_objects::object_blueprint_type) return false;
+    auto type = read(asset + 8);
+    for (unsigned depth = 0; type && depth < 16; ++depth) {
+        if (type == base + addr::race_objects::object_blueprint_type) return true;
+        if (type > maximum - 0x20) return false;
+        type = read(type + 0x20);
+    }
+    return false;
+}
+template<class ReadPointer>
+bool checkpoint_resident(std::uintptr_t cached, std::uintptr_t resolved,
+    std::uintptr_t base, ReadPointer read) {
+    // A world can stream out/reload a bundle without changing the client
+    // context. Readable old allocation bytes alone do not prove residency.
+    return cached && resolved == cached && checkpoint_blueprint(resolved,base,read);
+}
+}
diff --git a/Extension/Modes/race_group_reconciliation.h b/Extension/Modes/race_group_reconciliation.h
new file mode 100644
index 0000000..4dcc111
--- /dev/null
+++ b/Extension/Modes/race_group_reconciliation.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <set>
+#include <span>
+#include <utility>
+
+namespace dingosdk::modes::race_world::detail {
+// Each native tutorial checkpoint owns four mesh entities. A Destroy callback
+// can run inside creation, so incomplete groups must also drive reconciliation.
+inline std::set<unsigned> pending_checkpoint_groups(const std::set<unsigned>& dirty,
+                                                    std::span<const unsigned> live_parts) {
+    auto pending=dirty;
+    for(unsigned i=0;i<live_parts.size();++i)
+        if(live_parts[i]!=4)pending.insert(i);
+    return pending;
+}
+inline std::set<unsigned> take_checkpoint_groups(std::set<unsigned>& dirty,
+                                                std::span<const unsigned> live_parts) {
+    // Consume only the marks that precede this rebuild. Callbacks raised by
+    // the rebuild remain in dirty for the next tick, even for the same group.
+    std::set<unsigned> taken;
+    taken.swap(dirty);
+    return pending_checkpoint_groups(taken,live_parts);
+}
+}
diff --git a/Extension/Modes/race_momentum.h b/Extension/Modes/race_momentum.h
new file mode 100644
index 0000000..1b2edfe
--- /dev/null
+++ b/Extension/Modes/race_momentum.h
@@ -0,0 +1,54 @@
+#pragma once
+#include "mode_rules.h"
+#include <algorithm>
+#include <cmath>
+#include <deque>
+#include <optional>
+
+namespace dingosdk::modes {
+// Only restore measured horizontal motion. This is a safety ceiling for bad
+// telemetry, not a recovery boost or the speed assigned to a stopped rider.
+inline constexpr float max_race_recovery_speed=120.f;
+inline bool valid_race_recovery_velocity(const Vec3& velocity) noexcept {
+    return std::all_of(velocity.begin(),velocity.end(),[](float n){return std::isfinite(n);}) &&
+        velocity[1]==0.f && std::hypot(velocity[0],velocity[2])<=max_race_recovery_speed+.001f;
+}
+class RaceMomentum {
+    std::deque<std::pair<std::uint64_t,float>> samples;
+public:
+    void observe(float speed,std::uint64_t now) {
+        if(!samples.empty() && now<samples.back().first)samples.clear();
+        while(!samples.empty() && now-samples.front().first>250)samples.pop_front();
+        if(std::isfinite(speed) && speed>=0 && speed<=max_race_recovery_speed)samples.emplace_back(now,speed);
+    }
+    float before_bail(std::uint64_t now) const noexcept {
+        float speed{};
+        // A collision can report zero before the bail state changes. Retain
+        // the approach velocity for this short detection window only.
+        for(const auto& [at,value]:samples)if(now>=at && now-at<=250)speed=std::max(speed,value);
+        return speed;
+    }
+    float current(std::uint64_t now) const noexcept {
+        return samples.empty() || now<samples.back().first || now-samples.back().first>250?0.f:samples.back().second;
+    }
+};
+inline Vec3 race_recovery_motion(float speed,float yaw) noexcept {
+    if(!std::isfinite(speed) || speed<0 || speed>max_race_recovery_speed || !std::isfinite(yaw))return {};
+    const auto angle=yaw*3.14159265f/180.f;
+    return {std::sin(angle)*speed,0.f,std::cos(angle)*speed};
+}
+// A busy/off-board native queue must not consume the only copy of a restore.
+class RaceRecoveryDelivery {
+    std::optional<Vec3> pending;
+    std::uint64_t until{};
+public:
+    void reset() noexcept {pending.reset();until=0;}
+    void request(Vec3 value,std::uint64_t now) noexcept {
+        reset();if(valid_race_recovery_velocity(value)){pending=value;until=now+2000;}
+    }
+    std::optional<Vec3> peek(std::uint64_t now) noexcept {
+        if(now>=until)reset();return pending;
+    }
+    void accepted(const Vec3& value) noexcept {if(pending && *pending==value)reset();}
+};
+}
diff --git a/Extension/Modes/race_route.h b/Extension/Modes/race_route.h
new file mode 100644
index 0000000..662203a
--- /dev/null
+++ b/Extension/Modes/race_route.h
@@ -0,0 +1,216 @@
+#pragma once
+#include "mode_rules.h"
+#include <algorithm>
+#include <cmath>
+#include <map>
+#include <string>
+#include <optional>
+
+namespace dingosdk::modes {
+enum class RaceObject : unsigned { start, checkpoint, finish, guiding };
+inline constexpr RaceObject cycle_race_object(RaceObject object, bool previous) noexcept {
+    if(object==RaceObject::start)return RaceObject::checkpoint;
+    if(previous)return object==RaceObject::checkpoint?RaceObject::guiding:
+        object==RaceObject::guiding?RaceObject::finish:RaceObject::checkpoint;
+    return object==RaceObject::checkpoint?RaceObject::finish:
+        object==RaceObject::finish?RaceObject::guiding:RaceObject::checkpoint;
+}
+inline std::array<float,16> race_spawn_transform(const Vec3& at, float heading) noexcept {
+    const float yaw=heading*3.14159265f/180.f, co=std::cos(yaw), si=std::sin(yaw);
+    return {co,0,-si,0,0,1,0,0,si,0,co,0,at[0],at[1]+.3f,at[2],1};
+}
+// Restoring a saved route replaces the native flag's facing, but its existing
+// gates still define the race direction. Spawn facing the first distinct point
+// down that course; retain the authored facing only for an incomplete route.
+inline float race_start_heading(const Settings& route) noexcept {
+    if(!route.points.empty())for(std::size_t i=1;i<route.points.size();++i) {
+        const float x=route.points[i][0]-route.points[0][0],z=route.points[i][2]-route.points[0][2];
+        if(std::hypot(x,z)>.1f)return std::atan2(x,z)*180.f/3.14159265f;
+    }
+    return route.yaws.empty()?0.f:route.yaws.front();
+}
+inline void align_race_start(Settings& route) {
+    if(route.mode!=Mode::race || route.points.size()<2)return;
+    const auto heading=race_start_heading(route);
+    if(route.yaws.empty())route.yaws.resize(1);
+    route.yaws[0]=heading;
+}
+// A course belongs to a map, independently of any lobby, player or match.
+class RaceCourseMemory {
+    std::map<std::string,Settings> courses;
+public:
+    void save(const std::string& map,const Settings& route) {
+        if(!map.empty() && route.mode==Mode::race && !route.points.empty())courses[map]=route;
+    }
+    std::optional<Settings> restore(const std::string& map) const {
+        const auto it=courses.find(map);return it==courses.end()?std::nullopt:std::optional(it->second);
+    }
+    void clear(const std::string& map) {courses.erase(map);}
+};
+// View is deliberately separate from B/Cancel. A release or loss of focus
+// resets progress, and a completed hold fires only once until released.
+struct RaceClearHold {
+    std::uint64_t since{};bool fired{};
+    float progress{};
+    bool update(bool down,bool focused,std::uint64_t now) noexcept {
+        if(!down || !focused){since=0;fired=false;progress=0;return false;}
+        if(fired)return false;
+        if(!since)since=now;
+        progress=std::min(1.f,float(now-since)/1500.f);
+        if(progress<1.f)return false;
+        fired=true;return true;
+    }
+};
+inline void clear_race_gates(Settings& route,bool& finish) {
+    // Retain the native start flag while clearing all checkpoints and finish.
+    const auto keep=std::min<std::size_t>(1,route.points.size());
+    route.points.resize(keep);route.yaws.resize(keep);route.widths.resize(keep);route.gate_kinds.resize(keep);
+    route.race_finish=finish=false;
+}
+inline float race_gate_height(const Settings& settings,std::size_t index) noexcept {return 10.f*gate_half_width(settings,index)/6.f;}
+struct RaceGateCrossing { bool crossed{}, inside{}; Vec3 at{}; };
+inline RaceGateCrossing race_gate_crossing(const Settings& settings,std::size_t index,const Vec3& before,const Vec3& after) noexcept {
+    if(index>=settings.points.size())return {};
+    const auto& gate=settings.points[index];
+    const auto from=index?settings.points[index-1]:settings.points[index];
+    const auto to=index?settings.points[index]:index+1<settings.points.size()?settings.points[index+1]:settings.points[index];
+    const float heading=index<settings.yaws.size()?settings.yaws[index]:std::atan2(to[0]-from[0],to[2]-from[2])*180.f/3.14159265f;
+    const float yaw=heading*3.14159265f/180.f;
+    const float fx=std::sin(yaw),fz=std::cos(yaw);
+    const auto along=[&](const Vec3& p){return (p[0]-gate[0])*fx+(p[2]-gate[2])*fz;};
+    const float a=along(before),b=along(after);
+    if((a<0)==(b<0) || a==b)return {};
+    const float fraction=a/(a-b);
+    Vec3 at{};for(unsigned axis=0;axis<3;++axis)at[axis]=before[axis]+(after[axis]-before[axis])*fraction;
+    const float across=std::abs((at[0]-gate[0])*fz-(at[2]-gate[2])*fx);
+    return {true,across<=gate_half_width(settings,index) && std::abs(at[1]-gate[1])<=race_gate_height(settings,index),at};
+}
+inline bool race_gate_missed(const Settings& settings,std::size_t index,const Vec3& before,const Vec3& after) noexcept {
+    if(index==0 || index>=settings.points.size() || guiding_gate(settings,index))return false;
+    const auto crossing=race_gate_crossing(settings,index,before,after);
+    // Going around (or above) a required gate still crosses its plane. Do not
+    // restrict this warning to a narrow band outside the posts.
+    return crossing.crossed && !crossing.inside;
+}
+// Let a rider clear the gate plane before recovering. Approaching a later
+// large arch is never evidence of missing the current checkpoint.
+inline float race_gate_along(const Settings& route,std::size_t index,const Vec3& at) noexcept {
+    if(index>=route.points.size())return 0;
+    const float heading=index<route.yaws.size()?route.yaws[index]:index?std::atan2(route.points[index][0]-route.points[index-1][0],route.points[index][2]-route.points[index-1][2])*180.f/3.14159265f:0;
+    const float yaw=heading*3.14159265f/180.f;
+    return (at[0]-route.points[index][0])*std::sin(yaw)+(at[2]-route.points[index][2])*std::cos(yaw);
+}
+inline bool race_miss_recovery_ready(const Settings& route,std::size_t index,const Vec3& before,const Vec3& after,bool& pending) noexcept {
+    const float a=race_gate_along(route,index,before),b=race_gate_along(route,index,after);
+    const auto crossing=race_gate_crossing(route,index,before,after);
+    if(b<=0 || crossing.inside)pending=false;
+    else if(b>a && race_gate_missed(route,index,before,after))pending=true;
+    const float grace=std::clamp(gate_half_width(route,index)*.15f,1.5f,4.f);
+    return pending && b>=grace;
+}
+inline float race_snap_reach(float degrees) noexcept {return std::clamp(degrees*.1f,.5f,6.f);}
+inline float rotate_race_gate(float yaw,int direction,bool snap,float degrees) noexcept {
+    degrees=std::clamp(degrees,5.f,90.f);
+    return std::remainder((snap?std::round(yaw/degrees)*degrees:yaw)+direction*degrees,360.f);
+}
+inline float size_race_gate(float width,int direction) noexcept {
+    // Five percentage points relative to the standard six-metre half width.
+    return std::clamp(width+direction*.3f,min_gate_half_width,max_gate_half_width);
+}
+struct RaceEditorPresses {
+    unsigned previous{}, blocked{};
+    std::array<std::uint64_t,4> next{};
+    void suppress(unsigned held=15) noexcept {blocked=held;previous=0;next={};}
+    unsigned update(unsigned held,std::uint64_t now) noexcept {
+        blocked&=held;held&=~blocked;
+        unsigned pressed{};
+        for(unsigned i=0;i<4;++i) {
+            const auto bit=1u<<i;
+            if(!(held&bit)){next[i]=0;continue;}
+            if(!(previous&bit)){pressed|=bit;next[i]=now+350;}
+            else if(now>=next[i]){pressed|=bit;next[i]=now+150;}
+        }
+        previous=held;return pressed;
+    }
+};
+struct RaceGatePose { Vec3 at{}; float yaw{}; };
+inline RaceGatePose snap_race_gate(const Settings& settings,const Vec3& at,float yaw,bool enabled,float degrees=15.f) noexcept {
+    RaceGatePose pose{at,yaw};
+    if(!enabled || !std::isfinite(yaw) || !std::all_of(at.begin(),at.end(),[](float n){return std::isfinite(n);}))return pose;
+    degrees=std::clamp(degrees,5.f,90.f);
+    pose.yaw=std::remainder(std::round(yaw/degrees)*degrees,360.f);
+    pose.at[0]=std::round(at[0]*2.f)*.5f;pose.at[2]=std::round(at[2]*2.f)*.5f;
+    const auto count=settings.points.size()-(settings.race_finish && !settings.points.empty()?1:0);
+    if(!count || count>settings.yaws.size())return pose;
+    const auto& previous=settings.points[count-1];
+    const float heading=settings.yaws[count-1],angle=heading*3.14159265f/180.f;
+    const float fx=std::sin(angle),fz=std::cos(angle),dx=at[0]-previous[0],dz=at[2]-previous[2];
+    const float along=dx*fx+dz*fz,across=dx*fz-dz*fx;
+    // Preserve the ground hit's height. Only attract a nearby centre line;
+    // routes can bend and fork without being pulled across the road.
+    if(std::abs(across)<=race_snap_reach(degrees) && std::abs(along)>=3.f) {
+        const float spacing=std::round(along);
+        pose.at[0]=previous[0]+fx*spacing;pose.at[2]=previous[2]+fz*spacing;
+    }
+    if(std::abs(std::remainder(yaw-heading,360.f))<=degrees*.5f)pose.yaw=heading;
+    return pose;
+}
+inline RaceGatePose race_recovery_pose(const Settings& route,std::size_t missed) noexcept {
+    if(route.points.empty())return {};
+    std::size_t last=std::min(missed,route.points.size()-1);
+    while(last>0){--last;if(!guiding_gate(route,last))break;}
+    RaceGatePose pose{route.points[last],last<route.yaws.size()?route.yaws[last]:0.f};
+    const auto yaw=pose.yaw*3.14159265f/180.f;
+    // Continue just beyond the cleared gate; do not count the recovery teleport
+    // as crossing the next required gate.
+    pose.at[0]+=std::sin(yaw)*1.5f;pose.at[2]+=std::cos(yaw)*1.5f;
+    return pose;
+}
+// Builder mutations keep pose arrays aligned and reserve the last slot for
+// exactly one finish. The wire continues to send the route in crossing order.
+inline bool edit_race_route(Settings& settings, bool& finish, RaceObject object, const Vec3& at, float yaw, float width) {
+    if(settings.mode!=Mode::race || settings.points.size()!=settings.yaws.size() || settings.points.size()!=settings.widths.size() ||
+       !std::isfinite(yaw) || !std::isfinite(width) || width<min_gate_half_width || width>max_gate_half_width ||
+       !std::all_of(at.begin(),at.end(),[](float v){return std::isfinite(v) && std::abs(v)<100000;}))return false;
+    if(!settings.gate_kinds.empty() && settings.gate_kinds.size()!=settings.points.size())return false;
+    if(object!=RaceObject::start && object!=RaceObject::checkpoint && object!=RaceObject::finish && object!=RaceObject::guiding)return false;
+    if(settings.gate_kinds.empty())settings.gate_kinds.resize(settings.points.size(),RaceGateKind::mandatory);
+    if(object==RaceObject::start) {
+        if(settings.points.empty()) {settings.points.push_back(at);settings.yaws.push_back(yaw);settings.widths.push_back(width);settings.gate_kinds.push_back(RaceGateKind::mandatory);}
+        else {settings.points[0]=at;settings.yaws[0]=yaw;settings.widths[0]=width;}
+        settings.spawn=at;settings.has_spawn=true;return true;
+    }
+    if(settings.points.empty())return false;
+    auto index=settings.points.size()-(finish?1:0);
+    if(object==RaceObject::finish) {
+        if(index<2 || !mandatory_gates(settings,index))return false;
+        if(finish) {settings.points.back()=at;settings.yaws.back()=yaw;settings.widths.back()=width;settings.race_finish=true;return true;}
+        finish=true;settings.race_finish=true;
+    }
+    settings.points.insert(settings.points.begin()+index,at);
+    settings.yaws.insert(settings.yaws.begin()+index,yaw);
+    settings.widths.insert(settings.widths.begin()+index,width);
+    settings.gate_kinds.insert(settings.gate_kinds.begin()+index,object==RaceObject::guiding?RaceGateKind::guiding:RaceGateKind::mandatory);
+    return true;
+}
+inline bool undo_race_gate(Settings& settings, bool& finish) {
+    if(settings.points.size()<=1 || settings.points.size()!=settings.yaws.size() || settings.points.size()!=settings.widths.size())return false;
+    settings.points.pop_back();settings.yaws.pop_back();settings.widths.pop_back();
+    if(!settings.gate_kinds.empty())settings.gate_kinds.pop_back();
+    finish=false;settings.race_finish=false;return true;
+}
+inline bool race_route_ready(const Settings& settings, bool finish) noexcept {
+    return finish && settings.race_finish && settings.has_spawn && settings.points.size()>=3 &&
+        settings.points.size()==settings.yaws.size() && settings.points.size()==settings.widths.size() &&
+        (settings.gate_kinds.empty() || settings.gate_kinds.size()==settings.points.size()) &&
+        !guiding_gate(settings,0) && !guiding_gate(settings,settings.points.size()-1) && mandatory_gates(settings,settings.points.size()-1)>0;
+}
+enum class RaceFlagTransition { rejected, edit_route };
+// A saved course keeps every gate and its single finish when its native start
+// flag is placed again. Always open the builder so its owner can edit or clear
+// the restored course, or save it unchanged before choosing Start.
+inline RaceFlagTransition accept_race_flag(Settings& settings, bool& finish, const Vec3& at, float yaw, float width) {
+    if(!edit_race_route(settings,finish,RaceObject::start,at,yaw,width))return RaceFlagTransition::rejected;
+    return RaceFlagTransition::edit_route;
+}
+}
diff --git a/Extension/Modes/race_sound.h b/Extension/Modes/race_sound.h
new file mode 100644
index 0000000..73e767c
--- /dev/null
+++ b/Extension/Modes/race_sound.h
@@ -0,0 +1,40 @@
+#pragma once
+#include "mode_rules.h"
+#include <optional>
+
+namespace dingosdk::modes {
+enum class RaceCountdownCue { count,go };
+struct RaceCountdownAudio {
+    unsigned last_second{};
+    bool counted{},started{};
+    std::optional<RaceCountdownCue> update(Phase phase,std::uint64_t remaining) noexcept {
+        if(phase==Phase::setup){*this={};return {};}
+        if(phase==Phase::countdown) {
+            const auto seconds=static_cast<unsigned>((remaining+999)/1000);
+            if(seconds>=1 && seconds<=3 && (!last_second || seconds<last_second)) {
+                last_second=seconds;counted=true;return RaceCountdownCue::count;
+            }
+        }
+        if(phase==Phase::playing && !started) {
+            started=true;if(counted)return RaceCountdownCue::go;
+        }
+        return {};
+    }
+};
+enum class RaceGateCue { none,required,finish };
+inline RaceGateCue race_gate_cue(const Settings& route,int before,int after) noexcept {
+    if(before<0 || after<=before || route.points.empty())return RaceGateCue::none;
+    if(static_cast<std::size_t>(after)>=route.points.size())return RaceGateCue::finish;
+    return mandatory_gates(route,after)>mandatory_gates(route,before)?RaceGateCue::required:RaceGateCue::none;
+}
+// Observe authoritative progress even after the final gate changes Playing to
+// Results. Gameplay-only checkpoint polling cannot see a solo race's finish.
+struct RaceProgressAudio {
+    int heard{};
+    RaceGateCue update(const Settings& route,Phase phase,int score,bool out) noexcept {
+        if(phase==Phase::setup || phase==Phase::countdown){heard=0;return RaceGateCue::none;}
+        if(out || score<=heard)return RaceGateCue::none;
+        const auto cue=race_gate_cue(route,heard,score);heard=score;return cue;
+    }
+};
+}
diff --git a/Extension/Modes/race_source_contract.h b/Extension/Modes/race_source_contract.h
new file mode 100644
index 0000000..9b46152
--- /dev/null
+++ b/Extension/Modes/race_source_contract.h
@@ -0,0 +1,58 @@
+#pragma once
+#include "Engine/Game/Build/addresses.h"
+#include "Engine/Game/Build/20260929/engine.h"
+#include <cstdint>
+#include <string_view>
+
+namespace dingosdk::modes::race_world::detail {
+// A native ClientSkaterSource can keep its spawned entity slot empty after
+// player replacement, while the verified local player owns the current skater.
+// Its same-context CAS source still supplies the native creation parent bus,
+// just as native_skater_spawn::find_source does for remote actor creation.
+template<class Pointer, class UInt32, class Byte, class Name>
+std::uintptr_t checkpoint_parent_bus(std::uintptr_t base, std::uintptr_t context,
+    Pointer pointer, UInt32 uint32, Byte byte, Name name) {
+    if(!base || !context)return 0;
+    const auto player_offset=uint32(base+addr::engine::context_player_manager_offset);
+    if(player_offset>0x1000000)return 0;
+    const auto players=pointer(context+player_offset);
+    if(!players || pointer(players)!=base+addr::engine::local_player_manager_vtable)return 0;
+    const auto first=pointer(players+0x4c8),last=pointer(players+0x4d0);
+    if(!first || last<first || last-first!=8)return 0;
+    const auto player=pointer(first);
+    if(!player || pointer(player)!=base+addr::engine::local_player_vtable ||
+        pointer(player+0x78)!=context || byte(player+0x45)!=1 || byte(player+0x44))return 0;
+    const auto local=pointer(player+0xb8);
+    if(!local || pointer(local)!=base+addr::engine::skater_entity_vtable ||
+        pointer(local+0x20)!=context || pointer(local+0xf8)!=player)return 0;
+
+    const auto partition_offset=uint32(base+addr::engine::context_partition_offset);
+    if(partition_offset>0x1000000)return 0;
+    const auto partition=uint32(context+partition_offset);
+    if(partition>4)return 0;
+    std::uintptr_t fallback{};
+    for(unsigned kind=0;kind<7;++kind) {
+        const auto manager=pointer(base+addr::engine::source_managers+(std::uintptr_t(partition)*7+kind)*8);
+        if(!manager || pointer(manager)!=base+addr::engine::source_manager_vtable || pointer(manager+0x18)!=context)continue;
+        const auto begin=pointer(manager+0xa0),end=pointer(manager+0xa8);
+        if(!begin || end<begin || (end-begin)%0x18 || end-begin>64*0x18)continue;
+        for(auto at=begin;at<end;at+=0x18) {
+            const auto source=pointer(at+8);
+            if(!source || pointer(source)!=base+addr::engine::client_skater_source_vtable || pointer(source+0x20)!=context)continue;
+            const auto data=pointer(source+0x38),bus=pointer(source+0x30);
+            if(!data || !bus || pointer(bus+0x20)!=context)continue;
+            const auto blueprint=pointer(data+0xd0)&~std::uintptr_t{4};
+            if(!blueprint || name(pointer(blueprint+0x18))!=
+                "Gameplay/Characters/CharacterBlueprint_Physics_Skater_RSP_CAS")continue;
+            // create_bus derives its owner from this bus. A matching context
+            // alone is insufficient if the owner was already torn down.
+            const auto owner=pointer(bus+8);
+            if(!owner || !pointer(owner+0x48))continue;
+            const auto entity=pointer(source+0x68);
+            if(entity==local)return bus;
+            if(!entity && !fallback)fallback=bus;
+        }
+    }
+    return fallback;
+}
+}
