diff --git a/Extension/Throwdowns/challenge_registry.cpp b/Extension/Throwdowns/challenge_registry.cpp
new file mode 100644
index 0000000..f8e66ea
--- /dev/null
+++ b/Extension/Throwdowns/challenge_registry.cpp
@@ -0,0 +1,71 @@
+#include "challenge_registry.h"
+#include "Extension/Modes/mode_rules.h"
+#include <algorithm>
+#include <array>
+#include <cctype>
+
+namespace dingosdk::throwdowns {
+Palette palette_for(std::string_view id) noexcept {
+    std::uint32_t hash=2166136261U;
+    for(const auto c:id) hash=(hash^static_cast<unsigned char>(c))*16777619U;
+    // Authored Throwdown hues: fixed assignment across sessions and reloads.
+    constexpr std::array<std::uint32_t,6> hues{0xffff8000U,0xffff5df2U,0xff00cfffU,0xff60d64bU,0xffed935bU,0xffdfae78U};
+    return {hues[hash%hues.size()],0xfff3f0e5U,0xfff2cc52U,0xff171717U,0xffffffffU};
+}
+Registration Registry::add(Definition d) {
+    const auto valid_id=[](std::string_view id) {
+        return !id.empty() && id.size()<=64 && std::all_of(id.begin(),id.end(),[](unsigned char c) {
+            return (c>='a'&&c<='z') || (c>='0'&&c<='9') || c=='.' || c=='-' || c=='_';
+        });
+    };
+    if(!valid_id(d.id) || d.name.empty() || d.name.size()>64 || d.description.size()>1024 || d.donor>2)
+        return {false,false,"Invalid challenge identity, description or artwork family."};
+    if(d.adapter==Adapter::game_mode && (!d.mode || !modes::parse_mode(d.key) ||
+        static_cast<unsigned>(*modes::parse_mode(d.key))!=d.mode))
+        return {false,false,"Game-mode adapter does not resolve to an implemented mode."};
+    if(d.palette.primary==0)d.palette=palette_for(d.id);
+    if(const auto* existing=find(d.id)) {
+        if(*existing!=d)
+            return {false,false,"Challenge identifier already belongs to a different definition."};
+        return {true,false,{}}; // Repeated initialization is idempotent.
+    }
+    if(d.adapter==Adapter::game_mode && mode(d.mode))return {false,false,"Game mode already registered."};
+    definitions_.push_back(std::move(d));++revision_;
+    return {true,true,{}};
+}
+const Definition* Registry::find(std::string_view id) const noexcept {
+    const auto it=std::find_if(definitions_.begin(),definitions_.end(),[&](const auto& d){return d.id==id;});
+    return it==definitions_.end()?nullptr:&*it;
+}
+const Definition* Registry::mode(unsigned value) const noexcept {
+    const auto it=std::find_if(definitions_.begin(),definitions_.end(),[&](const auto& d){return d.adapter==Adapter::game_mode && d.mode==value;});
+    return it==definitions_.end()?nullptr:&*it;
+}
+Registry& registry() {
+    static Registry value=[] {
+        Registry result;
+        result.add({"native.skate","S.K.A.T.E.","Set and copy specific tricks.","ThrowdownSkate",{},Adapter::native_skate,0,0,{}});
+        result.add({"native.spot","Spot Battle","Earn the highest score in a single round.","SpotBattle",{},Adapter::native_spot,0,1,{}});
+        result.add({"native.jam","Skate Jam","Accumulate points across all tricks.","ThrowdownerActive",{},Adapter::native_jam,0,2,{}});
+        result.add({"native.oneup","1-UP","Beat the previous turn total. Three penalties and you're out. Last skater wins!",
+            "oneup","UI/ReSkate/OneUp/img_OneUp_Blue_1024",Adapter::native_one_up,0,1,
+            {0xffef8b22U,0xfff3f0e5U,0xfff2cc52U,0xff171717U,0xffffffffU}});
+        for(const auto mode:modes::all_modes) {
+            if(mode==modes::Mode::one_up || mode==modes::Mode::skate)continue;
+            const auto key=std::string(modes::mode_key(mode));
+            const unsigned donor=modes::tag_like(mode)?0U:mode==modes::Mode::jam?2U:1U;
+            // Matches the single generated 4x2 placeholder atlas, RGBA bytes.
+            const unsigned color=mode==modes::Mode::jam?0xffab4fffU:mode==modes::Mode::meat?0xff218affU:
+                mode==modes::Mode::race?0xff3434ffU:mode==modes::Mode::domination?0xffff558cU:
+                mode==modes::Mode::graffiti?0xff9fd929U:mode==modes::Mode::tag?0xff31d3ffU:
+                mode==modes::Mode::infection?0xff24d675U:0xffffbd39U;
+            result.add({"mode."+key,std::string(modes::mode_name(mode)),std::string(modes::mode_summary(mode)),key,
+                "UI/ReSkate/Throwdowns/img_"+key+"_Placeholder",
+                Adapter::game_mode,static_cast<unsigned>(mode),donor,{color,0xfff3f0e5U,0xfff2cc52U,0xff171717U,0xffffffffU},
+                mode==modes::Mode::race || mode==modes::Mode::domination,mode==modes::Mode::hide});
+        }
+        return result;
+    }();
+    return value;
+}
+}
diff --git a/Extension/Throwdowns/challenge_registry.h b/Extension/Throwdowns/challenge_registry.h
new file mode 100644
index 0000000..8caeee5
--- /dev/null
+++ b/Extension/Throwdowns/challenge_registry.h
@@ -0,0 +1,38 @@
+#pragma once
+#include <cstdint>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace dingosdk::throwdowns {
+enum class Adapter : std::uint8_t { native_skate, native_spot, native_jam, native_one_up, game_mode };
+struct Palette {
+    std::uint32_t primary{}, secondary{}, accent{}, background=0xff171717U, text=0xffffffffU;
+    bool operator==(const Palette&) const = default;
+};
+struct Definition {
+    std::string id, name, description, key, logo;
+    Adapter adapter{};
+    unsigned mode{}, donor=1;
+    Palette palette;
+    bool needs_points{}, supports_turns{}, supports_players=true;
+    bool operator==(const Definition&) const = default;
+};
+struct Registration {
+    bool accepted{}, inserted{};
+    std::string error;
+};
+class Registry {
+    std::vector<Definition> definitions_;
+    std::uint64_t revision_{};
+public:
+    Registration add(Definition definition);
+    const Definition* find(std::string_view id) const noexcept;
+    const Definition* mode(unsigned value) const noexcept;
+    std::span<const Definition> definitions() const noexcept { return definitions_; }
+    std::uint64_t revision() const noexcept { return revision_; }
+};
+Palette palette_for(std::string_view stable_id) noexcept;
+Registry& registry(); // Built-ins registered once; no process-global DLL ABI changes.
+}
diff --git a/Extension/Throwdowns/native_flag_bubble.h b/Extension/Throwdowns/native_flag_bubble.h
new file mode 100644
index 0000000..6145047
--- /dev/null
+++ b/Extension/Throwdowns/native_flag_bubble.h
@@ -0,0 +1,111 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <stdexcept>
+
+namespace dingosdk::multiplayer {
+struct FlagBubbleDisplay { std::uint64_t context{}, display{}; };
+
+// MapObjectComponent owns the ActivityDisplay referenced by its world bubble.
+// Resolve it from the registered POI's generation-checked EntityHandle, never
+// from proximity, the donor icon, or a global UI provider. This is a read-only
+// lookup of the verified 20260929 ECS component store (no native query handles).
+template<class Reader>
+FlagBubbleDisplay flag_bubble_display(Reader&& reader,std::uintptr_t base,
+                                     std::uint64_t entity,std::uint64_t context,
+                                     std::uint32_t mmid) {
+    try {
+        auto get=[&]<class T>(std::uintptr_t at) {
+            T result{};
+            if(!at || !reader(at,&result,sizeof(result)))
+                throw std::runtime_error("Flag bubble owner is unavailable.");
+            return result;
+        };
+        const auto ptr=[&](std::uintptr_t at){return get.template operator()<std::uintptr_t>(at);};
+        const auto u32=[&](std::uintptr_t at){return get.template operator()<std::uint32_t>(at);};
+        if(!entity || !context || !mmid)return {};
+        const auto world=static_cast<std::uint32_t>(entity>>32);
+        const auto local=static_cast<std::uint32_t>(entity);
+        // The native world ID uses two addressable bytes and a generation byte.
+        if(world>>22)return {};
+        const auto manager=ptr(base+0x74cd760);
+        const auto world_page=ptr(ptr(manager+0x70)+(world>>14)*8);
+        if(!world_page)return {};
+        const auto world_context=world_page+((world>>8)&63)*0xa30;
+        if(u32(world_context+8)!=world)return {};
+        const auto slots=ptr(world_context+0x18);
+        if(!slots)return {};
+        const auto shift=u32(slots+0x2c),stride=u32(slots+0x24),mask=u32(slots+0x28);
+        if(shift>16 || stride<24 || stride>4096 || mask>65535)return {};
+        const auto begin=ptr(slots),end=ptr(slots+8);
+        const auto index=(local>>8)>>shift;
+        if(end<begin || (end-begin)%8 || (end-begin)/8>65536 || index>=(end-begin)/8)return {};
+        const auto block=ptr(begin+index*8);
+        if(!block)return {};
+        const auto slot=(local>>8)&mask;
+        const auto bits_offset=get.template operator()<std::int32_t>(slots+0x34);
+        if(bits_offset<0 || bits_offset>1048576 || block<static_cast<std::uintptr_t>(bits_offset))return {};
+        if(!(ptr(block+(slot>>6)*8-bits_offset)&(std::uint64_t{1}<<(slot&63))))return {};
+        const auto record=block+slot*stride;
+        if(u32(record)!=local)return {}; // Includes the entity generation.
+        const auto archetype=ptr(record+16);
+        if(!archetype)return {};
+        const auto descriptors=ptr(archetype+0x10);
+        const auto count=u32(archetype+0x18);
+        if(!descriptors || count>128)return {};
+        constexpr std::array<std::uint8_t,16> guid{
+            0xf6,0xa1,0x98,0x17,0x4e,0x41,0xb5,0x43,0xaf,0xde,0x00,0x28,0x5b,0xd7,0x92,0x7d};
+        std::uintptr_t descriptor{};
+        for(unsigned i=0;i<count;++i) {
+            const auto candidate=ptr(descriptors+i*8);
+            if(!candidate)continue;
+            const auto type=ptr(candidate+8),metadata=type?ptr(type):0;
+            if(!metadata || get.template operator()<std::array<std::uint8_t,16>>(metadata+8)!=guid)continue;
+            if(u32(metadata)!=0x68015bc7 || get.template operator()<std::uint16_t>(metadata+6)!=704)return {};
+            // Verify both model fields instead of treating arbitrary component
+            // bytes as a model handle if the reflected layout changes.
+            const auto fields=ptr(metadata+0x38);
+            const auto fields_count=get.template operator()<std::uint16_t>(metadata+0x2a);
+            if(!fields || fields_count>32)return {};
+            unsigned verified{};
+            for(unsigned f=0;f<fields_count;++f) {
+                const auto field=fields+f*24;
+                const auto hash=u32(field);
+                const auto offset=get.template operator()<std::uint16_t>(field+8);
+                if((hash==0x9f0a28d2 && offset==576) || (hash==0x7ac3f897 && offset==584))++verified;
+            }
+            if(verified!=2)return {};
+            descriptor=candidate;break;
+        }
+        if(!descriptor)return {};
+        const auto table=ptr(world_context+0x9b0);
+        const auto buckets=u32(world_context+0x9b8);
+        if(!table || !buckets || buckets>65536)return {};
+        auto node=ptr(table+(descriptor%buckets)*8);
+        std::uintptr_t store{};
+        for(unsigned i=0;node && i<128;++i) {
+            if(ptr(node)==descriptor){store=ptr(node+8);break;}
+            node=ptr(node+16);
+        }
+        if(!store || ptr(store)!=base+0x65d0e48 || ptr(store+0x350)!=descriptor)return {};
+        const auto sentinel=store+0x10;
+        auto leaf=ptr(sentinel);
+        for(unsigned pages=0;leaf && leaf!=sentinel && pages<4096;++pages) {
+            const auto keys=get.template operator()<std::uint16_t>(leaf+0x10);
+            if(keys>64)return {};
+            for(unsigned i=0;i<keys;++i) {
+                const auto key=u32(leaf+0x18+i*4);
+                if(key>local)return {};
+                if(key!=local)continue;
+                const auto holder=ptr(leaf+0x118+i*8),component=holder?ptr(holder):0;
+                if(!component || ptr(component+576)!=context || u32(component+656)!=mmid)return {};
+                return {context,ptr(component+584)};
+            }
+            leaf=ptr(leaf);
+        }
+    } catch(const std::runtime_error&) {
+        // Flag removal and map transitions can retire an owner between frames.
+    }
+    return {};
+}
+} // namespace dingosdk::multiplayer
