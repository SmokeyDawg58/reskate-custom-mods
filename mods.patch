+            g.settings.corners.clear();
+            g.settings.area_radius = 0;
+            settings_changed(g);
+            s.placing = State::Placing::corners;
+            return "Close the menu and skate to each corner: D-pad Right (Enter) adds one, D-pad Down (End) finishes.";
+        }
+        if (what == "points") {
+            if (g.settings.mode == Mode::race) { // a route is skated again from its start
+                if(!multiplayer::one_up::begin_race_flag_placement(s.world,g.id,g.capacity))
+                    return "error: native flag placement is still busy.";
+                g.native_lobby=true;g.native_flag_placed=false;g.race_publication.begin_edit();settings_changed(g);
+                // Re-enter the builder with the existing course. Only its
+                // deliberate hold-to-clear action removes all saved gates.
+                s.yaw_offset = 0;
+                s.draft_width = g.settings.mode==Mode::race?default_race_editor_width:std::clamp(g.settings.radius, min_gate_half_width, max_gate_half_width);
+                s.placing=State::Placing::none;
+                return "Place the native starting flag to edit the saved course. Hold Back/View to clear all gates, or press Start to save it unchanged.";
+            }
+            s.placing = State::Placing::points;
+            return std::format("Close the menu and skate to each {}: D-pad Right (Enter) adds one, D-pad Down (End) finishes.", point_name(g));
+        }
+        return "error: usage: mode place circle|corners|points|cancel";
+    }
+    if (v == "circle") {
+        if (!s.skater) return "error: get on your board in the world first.";
+        const auto radius = arguments.empty() ? std::optional(s.draft_radius) : number(arguments, 0);
+        if (!radius || *radius < min_area_radius || *radius > max_area_radius)
+            return std::format("error: usage: mode circle [radius {}-{}]", min_area_radius, max_area_radius);
+        s.draft_radius = *radius;
+        g.settings.corners = {s.position};
+        g.settings.area_radius = std::round(*radius);
+        return changed(std::format("Area set: a circle {:.0f} m across, around you.", g.settings.area_radius * 2));
+    }
+    if (v == "corner" || v == "point") {
+        if(v=="point" && g.settings.mode==Mode::race)return "error: use Place race route in the native Throwdown menu to edit gates.";
+        auto &list = v == "corner" ? g.settings.corners : g.settings.points;
+        const auto limit = v == "corner" ? max_corners : max_points;
+        const auto what = std::string(v == "corner" ? "corner" : point_name(g));
+        const auto sub = arguments.empty() ? std::string() : arguments[0];
+        if (sub == "clear") {
+            list.clear();
+            if (v == "corner") g.settings.area_radius = 0;
+            return changed(std::format("All {}s cleared.", what));
+        }
+        if (sub == "undo") {
+            if (list.empty()) return "error: nothing to undo.";
+            list.pop_back();
+            if (g.settings.corners.empty()) g.settings.area_radius = 0;
+            return changed(std::format("Last {} removed ({} left).", what, list.size()));
+        }
+        if (!s.skater) return "error: no skater to mark the spot with.";
+        if (v == "corner" && g.settings.area_radius > 0) { // corners replace a circle
+            g.settings.corners.clear();
+            g.settings.area_radius = 0;
+        }
+        if (list.size() >= limit) return std::format("error: at most {} {}s.", limit, what);
+        list.push_back(s.position);
+        return changed(std::format("{} {} placed at {:.1f}, {:.1f}, {:.1f}.", what, list.size(), s.position[0], s.position[1],
+                                   s.position[2]));
+    }
+    const auto set_number = [&](float low, float high, auto apply, std::string_view label) -> std::string {
+        const auto value = number(arguments, 0);
+        if (!value || *value < low || *value > high) return std::format("error: usage: mode {} <{}-{}>", v, low, high);
+        apply(*value);
+        return changed(std::format("{} set to {}.", label, *value));
+    };
+    if (v == "players") return set_number(1, 6, [&](float x) { g.capacity = static_cast<unsigned>(std::round(x)); }, "Players");
+    if (v == "time") return set_number(30, 3600, [&](float x) { g.settings.duration_s = static_cast<std::uint32_t>(x); }, "Time (s)");
+    if (v == "turn") return set_number(10, 120, [&](float x) { g.settings.turn_s = static_cast<std::uint32_t>(x); }, "Turn time (s)");
+    if (v == "strikes") return set_number(1, g.settings.mode==Mode::skate?float(max_strikes):5.f, [&](float x) { g.settings.strikes = static_cast<std::uint8_t>(x); }, "Strikes");
+    if (v == "tricks") {
+        // R.E.S.K.A.T.E.: the kinds of trick that may be set, one or more.
+        std::uint8_t kinds = 0;
+        for (const auto &word : arguments) {
+            if (word == "flips" || word == "flip") kinds |= trick_flips;
+            else if (word == "grabs" || word == "grab") kinds |= trick_grabs;
+            else if (word == "grinds" || word == "grind" || word == "slides") kinds |= trick_grinds;
+            else if (word == "manuals" || word == "manual") kinds |= trick_manuals;
+            else if (word == "all" || word == "any") kinds = all_trick_kinds;
+            else return "error: usage: mode tricks flips|grabs|grinds|manuals|all (one or more)";
+        }
+        if (!kinds) return "error: usage: mode tricks flips|grabs|grinds|manuals|all (one or more)";
+        g.settings.trick_kinds = kinds;
+        return changed("Tricks that can be set: " + trick_kinds_text(kinds) + ".");
+    }
+    if (v == "radius")
+        return set_number(1, 50, [&](float x) {
+            g.settings.radius = x;
+            // Deathrace: the reach is how wide its gates are, the ones placed already too.
+            const float half = std::clamp(x, min_gate_half_width, max_gate_half_width);
+            for (auto &width : g.settings.widths) width = half;
+            s.draft_width = half;
+        }, "Radius (m)");
+    if (v == "start") {
+        if(g.native_lobby && !g.native_flag_placed)return "error: place the native starting flag before starting this Throwdown.";
+        if(g.native_lobby && s.placing!=State::Placing::none)return "error: finish placing the area or capture spots before starting this Throwdown.";
+        if(g.settings.mode==Mode::race && (!g.race_publication.ready(g.settings) || !race_route_ready(g.settings,g.race_finish_placed) || s.placing!=State::Placing::none ||
+           (multiplayer::one_up::race_flag_registration_owned() && !multiplayer::one_up::native_flag_mode_waiting())))
+            return "error: finish placing the start flag, checkpoints and one red finish first.";
+        if(g.settings.mode==Mode::race)if(const auto error=race_world::start_error(s.world,g.id);!error.empty())return "error: "+error;
+        if(g.settings.mode==Mode::race && !physics_tuning::game_tuning())return "error: stock physics are still loading; wait a moment before starting.";
+        if (const auto why = missing(g.settings); !why.empty()) return "error: " + why;
+        if(g.settings.mode==Mode::race) {
+            // Start plane and lineup share the placed flag's authored facing.
+            // Broadcast the change before countdown so every racer uses it.
+            align_race_start(g.settings);settings_changed(g);
+        }
+        if (s.skater && g.settings.mode!=Mode::race && !g.native_flag_placed) {
+            g.settings.spawn = s.position;
+            g.settings.has_spawn = true;
+            settings_changed(g);
+        }
+        g.referee.emplace(g.settings, g.leader, g.id);
+        g.referee->add_player(self_id(s));
+        for (const auto id : g.joiners) g.referee->add_player(id);
+        g.referee->start(now);
+        g.setup_sent = g.state_sent = 0;
+        return std::format("{} starting with {} player{}!", mode_name(g.settings.mode), g.joiners.size() + 1,
+                           g.joiners.empty() ? "" : "s");
+    }
+    return "error: unknown `mode " + v + "`. " + help();
+}
+
+bool request_race_route_action(std::uint64_t world,std::uint32_t game,std::string action,std::string argument) {
+    if(action!="cancel" && action!="save" && action!="load" && action!="rename" && action!="rename-save" && action!="import" && action!="reveal" && action!="delete" && action!="delete-confirm")return false;
+    if(argument.size()>(action=="import"?32768u:64u))return false;
+    const auto view=native_view();
+    if(!view.active || !view.leading || !view.placing || !view.route_dialog || view.world!=world || view.game!=game)return false;
+    auto& s=state();std::lock_guard lock(s.race_start_mutex);
+    s.route_action=State::RouteAction{world,game,std::move(action),std::move(argument)};return true;
+}
+NativeView native_view() { auto& s=state();std::lock_guard lock(s.hud_mutex);return s.native; }
+std::vector<NativeFlagOffer> native_flag_offers(std::uint64_t world) {
+    const auto& s=state();std::vector<NativeFlagOffer> result;
+    if(!s.session || !s.world || s.world!=world || s.barred || (s.game && (!s.game->state || s.game->state->phase!=Phase::results)))return result;
+    const auto now=now_ms();
+    for(const auto& offer:s.offers) {
+        if(result.size()==64)break;
+        if(!offer_open(offer) || now-offer.heard>leader_timeout_ms || !s.present.contains(offer.leader))continue;
+        if(offer.settings.mode==Mode::race && !race_route_ready(offer.settings,offer.settings.race_finish))continue;
+        if(const auto at=game_spot(offer.settings))
+            result.push_back({offer.leader,offer.game,std::string(mode_key(offer.settings.mode)),*at,
+                offer.settings.mode==Mode::race?gate_heading(offer.settings,0):0.f,
+                static_cast<unsigned>(offer.players),offer.settings.duration_s,
+                static_cast<unsigned>(mandatory_gates(offer.settings,offer.settings.points.size()))});
+    }
+    return result;
+}
+bool join_native_flag_offer(const NativeFlagOffer& requested,std::uint32_t mmid) {
+    auto& s=state();
+    if(!mmid || s.barred || !s.present.contains(requested.leader))return false;
+    const auto offer=std::find_if(s.offers.begin(),s.offers.end(),[&](const Offer& candidate){
+        return candidate.leader==requested.leader && candidate.game==requested.game && offer_open(candidate) &&
+            now_ms()-candidate.heard<=leader_timeout_ms && mode_key(candidate.settings.mode)==requested.key;
+    });
+    const bool already=s.game && !s.game->leading && s.game->leader==requested.leader && s.game->id==requested.game;
+    if(!already && offer==s.offers.end())return false;
+    if(s.game && !already && (!s.game->state || s.game->state->phase!=Phase::results))return false;
+    const auto settings=already?s.game->settings:offer->settings;
+    if(!multiplayer::one_up::adopt_native_mode_flag(s.world,requested.game,mmid,requested.at,requested.yaw,
+        settings.duration_s,6,settings.mode==Mode::race))return false;
+    if(!already) {
+        const auto copy=*offer;
+        if(join_offer(s,copy,now_ms()).starts_with("error:")) {
+            multiplayer::one_up::flag_registration_left();return false;
+        }
+    }
+    s.game->native_lobby=s.game->native_flag_placed=true;s.game->native_flag_yaw=requested.yaw;
+    return true;
+}
+void accept_race_start(std::uint64_t world,std::uint32_t game,const Vec3& at,float yaw) {
+    if(!world || !game || !std::isfinite(yaw) ||
+       !std::all_of(at.begin(),at.end(),[](float n){return std::isfinite(n) && std::abs(n)<100000;}))return;
+    auto& s=state();std::lock_guard lock(s.race_start_mutex);s.race_start=State::RaceStart{world,game,at,yaw};
+}
+void accept_restored_race_flag(std::uint64_t world,std::uint32_t game,const Vec3& at,float yaw) {
+    if(!world || !game || !std::isfinite(yaw) || !std::all_of(at.begin(),at.end(),[](float n){return std::isfinite(n) && std::abs(n)<100000.f;}))return;
+    auto& s=state();std::lock_guard lock(s.race_start_mutex);s.race_start=State::RaceStart{world,game,at,yaw,true};
+}
+void accept_native_start_flag(std::uint64_t world,std::uint32_t game,const Vec3& at,float yaw) {
+    if(!world || !game || !std::isfinite(yaw) ||
+       !std::all_of(at.begin(),at.end(),[](float n){return std::isfinite(n) && std::abs(n)<100000;}))return;
+    auto& s=state();std::lock_guard lock(s.race_start_mutex);s.native_flag=State::RaceStart{world,game,at,yaw};
+}
+bool request_native_start(std::uint64_t world,std::uint32_t game) noexcept {
+    try {
+        const auto v=native_view();
+        if(!world || !game || !v.active || !v.leading || !v.waiting || v.world!=world || v.game!=game)return false;
+        auto& s=state();std::lock_guard lock(s.race_start_mutex);s.native_start=State::NativeStart{world,game};return true;
+    } catch(...) {return false;}
+}
+bool request_native_quit(std::uint64_t world,std::uint32_t game) noexcept {
+    try {
+        const auto v=native_view();
+        if(!world || !game || !v.active || v.world!=world || v.game!=game)return false;
+        auto& s=state();std::lock_guard lock(s.race_start_mutex);s.native_quit=State::NativeStart{world,game};return true;
+    } catch(...) {return false;}
+}
+bool active() noexcept { return state().active.load(std::memory_order_acquire); }
+std::optional<Vec3> peek_race_recovery_velocity() noexcept {
+    auto& s=state();std::lock_guard lock(s.recovery_mutex);
+    if(s.race_countdown.load(std::memory_order_acquire))return Vec3{};
+    if(!s.active.load()){s.recovery_velocity.reset();return {};}
+    return s.recovery_velocity.peek(now_ms(),s.recovering.load(std::memory_order_acquire));
+}
+void accept_race_recovery_velocity(const Vec3& value) noexcept {
+    auto& s=state();std::lock_guard lock(s.recovery_mutex);s.recovery_velocity.accepted(value);
+}
+bool internal_teleport() noexcept { return mode_teleport; }
+bool countdown_locks_input() noexcept { return state().input_locked.load(std::memory_order_acquire); }
+bool race_countdown_holds() noexcept { return state().race_countdown.load(std::memory_order_acquire); }
+bool race_recovery_pending() noexcept { return state().recovering.load(std::memory_order_acquire); }
+bool placement_camera_requested() noexcept { return state().placement_flight.load(std::memory_order_acquire); }
+bool restricts_session_markers() noexcept { return state().markers_restricted.load(std::memory_order_acquire); }
+overlay::ModesMenu menu_view() {
+    auto &s = state();
+    std::lock_guard lock(s.hud_mutex);
+    return s.menu;
+}
+
+bool infected_look(std::uint64_t player) noexcept {
+    const auto &s = state();
+    if (!s.game || !s.game->state || !hunt_like(s.game->settings.mode)) return false; // infected, or seeking
+    const auto phase = s.game->state->phase;
+    if (phase != Phase::playing && phase != Phase::results) return false;
+    const auto *p = standing(*s.game, player);
+    return p && p->up && !p->out;
+}
+bool hidden_player(std::uint64_t player) noexcept {
+    const auto &s = state();
+    if (!s.game || !playing(*s.game) || s.game->settings.mode != Mode::hide) return false;
+    const auto *p = standing(*s.game, player);
+    return p && !p->up && !p->out;
+}
+
+bool local_meat_game() noexcept {
+    const auto &s = state();
+    return s.game && s.game->settings.mode == Mode::meat && s.game->state && s.game->state->phase == Phase::playing &&
+           standing(*s.game, self_id(s));
+}
+bool local_session() noexcept { return state().session; }
+
+overlay::ModesHud hud() {
+    auto &s = state();
+    overlay::ModesHud h;
+    {
+        std::lock_guard lock(s.hud_mutex);
+        if (!s.hud.active && s.hud.offers.empty() && s.hud.invite.empty()) return {};
+        h = s.hud;
+    }
+    if (const auto view = latest_game_view()) {
+        h.camera = view->world;
+        h.vertical_fov = view->vertical_fov;
+    }
+    return h;
+}
+} // namespace dingosdk::modes
diff --git a/Extension/Modes/game_modes.h b/Extension/Modes/game_modes.h
new file mode 100644
index 0000000..284c9d9
--- /dev/null
+++ b/Extension/Modes/game_modes.h
@@ -0,0 +1,126 @@
+#pragma once
+#include <utility>
+#include "Extension/UI/Overlay/overlay.h"
+#include "mode_view.h"
+#include "mode_rules.h"
+#include <cstdint>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// ReSkate's game modes in the running game (rules: mode_rules.h). The game thread drives
+// everything: the session tick hands over who is here and what arrived, and the console's
+// `mode` command sets a game up. The local player's lines and bails come from what the
+// Trainer measures each tick; the HUD reads a snapshot from any thread.
+namespace dingosdk::modes {
+struct SessionPlayer {
+    std::uint64_t id{}; // Steam ID
+    std::string name;
+};
+struct SessionInput {
+    std::uint64_t local{};    // this player's Steam ID; 0 without a session (then playing alone)
+    std::string local_name;
+    std::vector<SessionPlayer> peers; // the other players in this world (never a dedicated server)
+    bool in_world{};          // the world is loaded and playing
+    std::uint64_t world{};    // changes whenever the map or world changes
+    std::string map;          // live native root|detached level, not its placement donor
+    bool barred{};            // the local player's mods change scoring: they cannot play
+};
+// Session tick (game thread): runs the local game and returns the messages to send to
+// every other player (dropped without a session).
+std::vector<std::vector<std::uint8_t>> tick(const SessionInput &input);
+// Establish the world boundary before dispatching this frame's network inbox.
+// Idempotent; tick also calls it for callers without a transport.
+void synchronize_world(const SessionInput &input);
+// One game mode message from another player (game thread). False when the bytes are not one.
+bool receive(std::uint64_t sender, std::span<const std::uint8_t> message);
+// Lines for the local chat since the last call (game thread).
+std::vector<std::string> take_notices();
+// Infection: whether this other player is infected now, so their skater wears the reaper here
+// (game thread, from the session's outfit pass).
+bool infected_look(std::uint64_t player) noexcept;
+// Hide & Seek: whether this other player is hiding now, so their nametag, dot and chat bubbles
+// stay off (game thread).
+bool hidden_player(std::uint64_t player) noexcept;
+// `mode <verb> [arguments]` from the console dispatcher (game thread).
+// setup opens the native Throwdown creation page for any custom mode draft;
+// quit leaves immediately, while stop keeps the leader's results presentation.
+std::string command(std::string_view verb, const std::vector<std::string> &arguments);
+// The HUD's snapshot, with the latest camera (any thread).
+overlay::ModesHud hud();
+// While ReSkate's own native menus and HUD write their labels (on this thread), the trick reader
+// ignores every UI write: those are not skate.'s trick list.
+inline thread_local bool writing_own_ui = false;
+struct OwnUiWrites {
+    bool previous = std::exchange(writing_own_ui, true);
+    ~OwnUiWrites() { writing_own_ui = previous; }
+};
+// `mode flicktest on|off`: R.E.S.K.A.T.E.'s picture slot shows the 1UP badge instead (diagnostics).
+bool flick_test() noexcept;
+// What the ReSkate menu's Game Modes page shows (any thread).
+overlay::ModesMenu menu_view();
+struct SavedRaceRouteSummary {
+    std::uint64_t id{};std::string name,map;unsigned required{},objects{};
+};
+struct NativeView {
+    bool active{}, leading{}, placing{};
+    bool pending_flag{}, flag_placed{}, waiting{}, restoring_route{};
+    std::uint64_t local{}, leader{}, world{};
+    std::uint64_t state_sampled_ms{};
+    std::uint32_t game{};
+    unsigned capacity=6;
+    bool route_finish{},cursor_valid{};
+    unsigned route_object=1;
+    bool route_snap=true,exit_confirm{},recovering{},rotating{},arrow_height_snapped{};
+    float snap_degrees=15.f,clear_progress{},save_progress{};
+    bool route_reusable{};
+    unsigned route_dialog{};std::uint64_t route_dialog_serial{};
+    std::string route_dialog_error,route_map,route_name;std::vector<SavedRaceRouteSummary> saved_routes;
+    unsigned missed_gate{};
+    Vec3 cursor{};
+    float cursor_yaw{},cursor_width=6.f,cursor_roll{},cursor_pitch{};
+    bool editor_roll_axis{},route_saved{};unsigned gates_visible_from{};std::uint64_t object_changed_ms{};
+    bool placing_circle{}; float draft_radius{}; // an area being placed: its size so far
+    bool placing_corners{}, zone_custom{};          // R.E.S.K.A.T.E.: its cones being placed; a custom zone
+    Settings settings;
+    std::optional<Message> state;
+    std::string waiting_status,editor_warning;
+    std::vector<std::pair<std::uint64_t,std::string>> names;
+};
+NativeView native_view();
+bool request_race_route_action(std::uint64_t world,std::uint32_t game,std::string action,std::string argument);
+struct NativeFlagOffer {
+    std::uint64_t leader{};
+    std::uint32_t game{};
+    std::string key;
+    Vec3 at{};
+    float yaw{};
+    unsigned players=1,duration_s=120,required_gates{};
+    std::uint64_t native_match{}; // Full 1-UP identity; mode IDs remain 32 bit.
+    bool operator==(const NativeFlagOffer&) const=default;
+    bool same_registration(const NativeFlagOffer& other) const {
+        return leader==other.leader && game==other.game && native_match==other.native_match && key==other.key && at==other.at && yaw==other.yaw;
+    }
+};
+// Game-thread bridge: the existing mode invitation owns the race; a native
+// registration supplies its physical flag, POI and stock Join interaction.
+std::vector<NativeFlagOffer> native_flag_offers(std::uint64_t world);
+bool join_native_flag_offer(const NativeFlagOffer& offer,std::uint32_t mmid);
+void accept_race_start(std::uint64_t world, std::uint32_t game, const Vec3& at, float yaw);
+void accept_restored_race_flag(std::uint64_t world,std::uint32_t game,const Vec3& at,float yaw);
+// The native flag callback only registers a matching draft's spawn. Starting
+// stays an explicit waiting-HUD hold action, dispatched on the client tick.
+void accept_native_start_flag(std::uint64_t world, std::uint32_t game, const Vec3& at, float yaw);
+bool request_native_start(std::uint64_t world, std::uint32_t game) noexcept;
+bool request_native_quit(std::uint64_t world, std::uint32_t game) noexcept;
+bool active() noexcept;
+std::optional<Vec3> peek_race_recovery_velocity() noexcept;
+void accept_race_recovery_velocity(const Vec3&) noexcept;
+bool internal_teleport() noexcept;
+bool countdown_locks_input() noexcept;
+bool race_recovery_pending() noexcept;
+bool race_countdown_holds() noexcept;
+bool placement_camera_requested() noexcept;
+bool restricts_session_markers() noexcept;
+} // namespace dingosdk::modes
diff --git a/Extension/Modes/mode_announcements.h b/Extension/Modes/mode_announcements.h
new file mode 100644
index 0000000..35a0908
--- /dev/null
+++ b/Extension/Modes/mode_announcements.h
@@ -0,0 +1,34 @@
+#pragma once
+#include "mode_rules.h"
+#include <algorithm>
+#include <format>
+#include <optional>
+#include <string>
+
+namespace dingosdk::modes {
+inline std::string match_time(std::uint64_t ms) {
+    return std::format("{:02}:{:02}.{:03}",ms/60000,(ms/1000)%60,ms%1000);
+}
+struct MatchAnnouncements {
+    bool started{},ended{};
+    std::uint64_t playing_at{};
+    std::optional<std::string> observe(std::string_view host,const Settings& settings,const Message& state,std::uint64_t now) {
+        if(!started && (state.phase==Phase::countdown || state.phase==Phase::playing)) {
+            started=true;playing_at=now+(state.phase==Phase::countdown?state.remaining_ms:0);
+            const auto timer=timed(settings.mode)?settings.duration_s:settings.turn_s;
+            return std::format("{} has started {} ({}).",host,mode_name(settings.mode),match_time(timer*1000ULL));
+        }
+        if(started && !ended && state.phase==Phase::results) {
+            ended=true;
+            auto elapsed=now>playing_at?now-playing_at:0;
+            if(timed(settings.mode))elapsed=std::min<std::uint64_t>(elapsed,settings.duration_s*1000ULL);
+            if(settings.mode==Mode::race && !state.standings.empty()) {
+                const auto& first=state.standings.front();
+                if(!first.out && first.aux>=0 && first.score>=static_cast<std::int32_t>(settings.points.size()))elapsed=first.aux;
+            }
+            return std::format("{} has ended {} ({}).",host,mode_name(settings.mode),match_time(elapsed));
+        }
+        return {};
+    }
+};
+}
diff --git a/Extension/Modes/mode_lobby.h b/Extension/Modes/mode_lobby.h
new file mode 100644
