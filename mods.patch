diff --git a/Engine/Core/Debug/Test/backtrace_tests.cpp b/Engine/Core/Debug/Test/backtrace_tests.cpp
index 90f7f65..39d2984 100644
--- a/Engine/Core/Debug/Test/backtrace_tests.cpp
+++ b/Engine/Core/Debug/Test/backtrace_tests.cpp
@@ -33,6 +33,46 @@ std::string read(const std::filesystem::path& path) {
     std::ifstream file(path, std::ios::binary);
     return {std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>()};
 }
+void launcher_log_retention(const std::filesystem::path& root) {
+    const auto directory=root/L"launcher-retention";
+    std::filesystem::create_directories(directory);
+    const auto log=directory/L"ReSkate.log";
+    const std::string original="first match\r\nsecond match locked\r\n";
+    std::ofstream(log,std::ios::binary)<<original;
+    logging::Options options;options.directory=directory;options.truncate_file=true;
+    check(logging::initialize(options),"Restart fixture logging failed");
+    logging::write(logging::Level::info,logging::Channel::runtime,"new launcher session");
+    logging::shutdown();
+    std::vector<std::filesystem::path> archives;
+    for(const auto& entry:std::filesystem::directory_iterator(directory))
+        if(entry.path()!=log)archives.push_back(entry.path());
+    check(archives.size()==1 && read(archives.front())==original,
+          "Reopening the launcher must retain the preceding locked game log exactly");
+    const auto second=read(log);
+    check(second.find("new launcher session")!=std::string::npos && second.find("second match locked")==std::string::npos,
+          "New launcher output must use a separate current log after preservation");
+    check(logging::initialize(options),"Second restart fixture logging failed");
+    logging::write(logging::Level::info,logging::Channel::runtime,"another launcher session");
+    logging::shutdown();
+    unsigned copies{};bool second_saved=false;
+    for(const auto& entry:std::filesystem::directory_iterator(directory))if(entry.path()!=log) {
+        ++copies;second_saved|=read(entry.path())==second;
+    }
+    check(copies==2 && second_saved && read(archives.front())==original,
+          "Consecutive launcher restarts cannot replace any previous archive");
+    // Another writer can keep the original file readable only through its
+    // own handle. Archive failure must append, never truncate that evidence.
+    Handle blocked(CreateFileW(log.c_str(),GENERIC_READ,FILE_SHARE_WRITE,nullptr,OPEN_EXISTING,0,nullptr));
+    check(blocked.value!=INVALID_HANDLE_VALUE,"Cannot prepare sharing-conflict fixture");
+    const auto before_size=std::filesystem::file_size(log);
+    check(logging::initialize(options),"Archive failure should still allow appended logging");
+    logging::write(logging::Level::info,logging::Channel::runtime,"archive fallback append");
+    logging::shutdown();
+    CloseHandle(blocked.release());
+    check(std::filesystem::file_size(log)>before_size && read(log).find("another launcher session")!=std::string::npos &&
+          read(log).find("archive fallback append")!=std::string::npos,
+          "An unavailable archive cannot erase the current log");
+}
 void endpoint_checks() {
     Endpoint endpoint;
     check(parse_endpoint(L"https://submit.backtrace.io/team/token/minidump", endpoint), "Hosted endpoint rejected");
@@ -264,6 +304,7 @@ int wmain(int argc, wchar_t** argv) {
         SetEnvironmentVariableW(L"RESKATE_BACKTRACE_URL", L"http://invalid/post");
